#
# provost — turn command output into data.
#
# PROTOTYPE (proposal 0001). Implements the product's one path — capture a
# command's output, auto-detect its format, present it as a tidy, one-row-per-
# record dataset — on a git-backed store:
#
#     provost run <cmd>        execute a binary, capture its output as a commit
#     cmd | provost            inject stdin the same way
#     provost source <N>       show the original source data behind dataset row #N
#     provost log / restore    list captures / bring a capture's commit back up
#     provost ls / show        list datasets / present one as a tidy table
#     provost stats            statistics on a dataset
#
# The extract engine (all strategies) is bundled in this repo at provost/extract/.
#
# STORE MODEL (Stage A): the workspace is a git repo. By default captures go to
# a GLOBAL store (~/.provost, override with PROVOST_HOME) so you can capture from any
# directory. Every dataset row carries a globally-unique visible index (#N);
# `provost source N` maps it back to the exact captured input that produced it.
# The store may be shared by multiple users (point PROVOST_HOME at a shared,
# group-writable dir); a mkdir-based lock serialises concurrent writers.
#
# CODE vs DATA: executable code (the extract/analyze engines, the transform
# module) is loaded ONLY from provost's own install dir ($PROVOST_ROOT, the
# directory this script really lives in) — never from the data store, which a
# shared store's other members can write to.
#
set -euo pipefail

# The top-level VERSION file is the single source of truth (pyproject reads
# it too, so `provost --version` and the wheel can never disagree); the
# literal is only a fallback for a stripped-down copy shipped without it.
PROVOST_VERSION="0.0.0-unknown"
if [[ -f "${BASH_SOURCE[0]%/*}/VERSION" ]]; then
    read -r PROVOST_VERSION < "${BASH_SOURCE[0]%/*}/VERSION" || true
fi

# ---------------------------------------------------------------------------
# Config (env-overridable; PROVOST_* is the post-rename namespace)
# ---------------------------------------------------------------------------
# Make a path absolute (relative to $PWD) without requiring it to exist.
_abspath () { case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$PWD" "$1" ;; esac; }

# Workspace resolution:
#   1. $PROVOST_WORKSPACE explicit override (used by tests / one-off stores)
#   2. a controlled directory found by walking up from CWD
#   3. else the global store: $PROVOST_HOME, or ~/.provost
_default_home () { _abspath "${PROVOST_HOME:-$HOME/.provost}"; }

# The real directory of this script, following symlinks — so provost finds its
# bundled extract/analyze/transform trees even when invoked via a symlink on
# PATH (e.g. after install.sh). Computed once; used by all path resolvers.
_provost_root () {
    local src="${BASH_SOURCE[0]}" d
    if command -v readlink >/dev/null 2>&1; then
        src="$(readlink -f "$src" 2>/dev/null || echo "$src")"
    fi
    while [[ -L "$src" ]]; do
        d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$d/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
PROVOST_ROOT="$(_provost_root)"

# A controlled directory holds its instance at <dir>/.provost with a CONTROLLED
# marker (which the global store lacks). Walk up from $start to find one.
_find_controlling_dir () {
    local here="$1"
    here="$(cd "$here" 2>/dev/null && pwd)" || return 1
    while [[ -n "$here" && "$here" != "/" ]]; do
        [[ -f "$here/.provost/CONTROLLED" ]] && { printf '%s\n' "$here"; return 0; }
        here="$(dirname "$here")"
    done
    [[ -f "/.provost/CONTROLLED" ]] && { printf '/\n'; return 0; }
    return 1
}

PROVOST_WORKSPACE_EXPLICIT="${PROVOST_WORKSPACE:+1}"
if [[ -n "$PROVOST_WORKSPACE_EXPLICIT" ]]; then
    PROVOST_WORKSPACE="$(_abspath "$PROVOST_WORKSPACE")"
    PROVOST_STORE_KIND="explicit override"
else
    _ctl="$(_find_controlling_dir "$PWD" 2>/dev/null || true)"
    if [[ -n "$_ctl" ]]; then
        PROVOST_WORKSPACE="$_ctl/.provost"; PROVOST_STORE_KIND="controlled: $_ctl"
    else
        PROVOST_WORKSPACE="$(_default_home)"; PROVOST_STORE_KIND="global"
    fi
    unset _ctl
fi
PROVOST_MIN_CONFIDENCE="${PROVOST_MIN_CONFIDENCE:-50}"
# Quality gate: a parse that kept too little of the input (line coverage) or
# put values under the wrong headers (column-type consistency) is held back for
# triage instead of filed. 0 turns a check off. See _quality_exempt.
PROVOST_MIN_COVERAGE="${PROVOST_MIN_COVERAGE:-80}"
PROVOST_MIN_CONSISTENCY="${PROVOST_MIN_CONSISTENCY:-70}"
PROVOST_MAX_INPUT="${PROVOST_MAX_INPUT:-10485760}"   # 10 MiB
PROVOST_FILES_MAX_SIZE="${PROVOST_FILES_MAX_SIZE:-1048576}"  # a controlled dir's files kept per run up to this size (0 = none)
PROVOST_TEMP_DIR="${TMPDIR:-/tmp}"
PROVOST_LOCK_TIMEOUT="${PROVOST_LOCK_TIMEOUT:-30}"   # seconds to wait for the store lock
PROVOST_LOCK_MAX_AGE="${PROVOST_LOCK_MAX_AGE:-3600}" # seconds after which any lock is stale
PROVOST_RECONCILE_OVERLAP="${PROVOST_RECONCILE_OVERLAP:-60}"  # % column overlap to union vs split a variant
PROVOST_MULTI="${PROVOST_MULTI:-0}"                  # 1 = file every dataset an input holds (--multi)
PROVOST_CONTEXT_COLUMNS="${PROVOST_CONTEXT_COLUMNS:-0}" # 1 = '#% key=value' context becomes row columns (--context-columns)
PROVOST_UNITS="${PROVOST_UNITS:-off}"                # base = add a NAME[UNIT] column in base units beside each column with a readable unit (--units)
PROVOST_MANIFEST_PROFILE="${PROVOST_MANIFEST_PROFILE:-}" # run-manifest profile: NAME or path ('' = the store's manifest-profile.tsv, else default)
PROVOST_MANIFEST_STRICT="${PROVOST_MANIFEST_STRICT:-0}" # 1 = refuse to file a capture whose manifest lacks a required key (--strict-manifest)
PROVOST_ENV="${PROVOST_ENV:-0}"                      # 1 = record where a capture was taken in its prologue (--env); modules = and the kernel modules (--env=modules)
# The variables --env records (glob patterns, space- or comma-separated); set
# but empty records none. Set means set: an empty value is not the default.
PROVOST_ENV_VARS="${PROVOST_ENV_VARS-OMP_* MPI_* OMPI_MCA_* I_MPI_* MPICH_* UCX_* CUDA_* NCCL_*}"
PROVOST_AUTO_MULTI="${PROVOST_AUTO_MULTI:-1}"        # 1 = segment a parse the quality gate would hold (see _auto_multi)
PROVOST_MODEL="${PROVOST_MODEL:-0}"                  # 1 = try the learned layout model on a parse the gate would hold (see _layout_model)
PROVOST_LLM="${PROVOST_LLM:-0}"                      # 1 = use (or have Claude write) a parsing template for a parse the gate would hold (see _llm_template)
PROVOST_LLM_MODEL="${PROVOST_LLM_MODEL:-claude-opus-5-5}"   # the model that writes templates
PROVOST_LLM_JUDGE="${PROVOST_LLM_JUDGE:-1}"          # 1 = a review call after Claude writes or extends a template (see _llm_template)
PROVOST_QUIET="${PROVOST_QUIET:-0}"                  # 1 = no progress/ok chatter on stderr
PROVOST_REDACT="${PROVOST_REDACT:-1}"                # 1 = scrub known secret patterns from each input before it is stored (--no-redact: 0)
PROVOST_ASYNC="${PROVOST_ASYNC:-}"                   # ''/auto = background only when interactive

# ---------------------------------------------------------------------------
# Tiny UI helpers
# ---------------------------------------------------------------------------
_is_tty () { [[ -t 2 ]]; }
if _is_tty; then C_OK=$'\033[32m'; C_DIM=$'\033[2m'; C_ERR=$'\033[31m'; C_RST=$'\033[0m'
else C_OK=""; C_DIM=""; C_ERR=""; C_RST=""; fi
info () { [[ "$PROVOST_QUIET" == 1 ]] || printf '%s\n' "$*" >&2; }
ok ()   { [[ "$PROVOST_QUIET" == 1 ]] || printf '%s ok%s %s\n' "$C_OK" "$C_RST" "$*" >&2; }
warn () { printf '%swarning%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; }
die ()  { printf '%serror%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }
# A usage error: the command line itself is wrong. stderr, exit 2.
usage_die () { printf 'provost: %s\n' "$*" >&2; exit 2; }

# ---------------------------------------------------------------------------
# Validation — every user-controlled value that reaches arithmetic, a path, or
# a git ref is checked first. Bash evaluates arithmetic operands recursively
# (`x='a[$(cmd)]'; (( x ))` runs cmd), so numeric settings MUST be validated
# before they are ever compared or computed with.
# ---------------------------------------------------------------------------
# Locale-proof character classes ([A-Z] ranges are collation-dependent).
_ALNUM='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'
_NAME_RE="^[${_ALNUM}][${_ALNUM}._-]*\$"
# A PROVOST_ENV_VARS pattern: a variable name, or a glob over names.
_ENV_PAT_RE="^[][${_ALNUM}_*?!^-]+\$"

# _validate_uint LABEL VALUE MIN [MAX] — whole number in range, else exit 2.
_validate_uint () {
    local label="$1" v="$2" lo="$3" hi="${4:-}"
    [[ "$v" =~ ^[0-9]{1,12}$ ]] || usage_die "$label must be a whole number (got '$v')."
    v=$((10#$v))
    (( v >= lo )) || usage_die "$label must be at least $lo (got $v)."
    if [[ -n "$hi" ]] && (( v > hi )); then usage_die "$label must be at most $hi (got $v)."; fi
}
# Normalise a validated number (drop leading zeros so later $(( )) never
# reads it as octal).
_norm_uint () { printf '%d' "$((10#$1))"; }

_validate_settings () {
    _validate_uint PROVOST_MIN_CONFIDENCE    "$PROVOST_MIN_CONFIDENCE"    0 101
    _validate_uint PROVOST_MIN_COVERAGE      "$PROVOST_MIN_COVERAGE"      0 100
    _validate_uint PROVOST_MIN_CONSISTENCY   "$PROVOST_MIN_CONSISTENCY"   0 100
    _validate_uint PROVOST_RECONCILE_OVERLAP "$PROVOST_RECONCILE_OVERLAP" 0 101
    _validate_uint PROVOST_LOCK_TIMEOUT      "$PROVOST_LOCK_TIMEOUT"      0 86400
    _validate_uint PROVOST_LOCK_MAX_AGE      "$PROVOST_LOCK_MAX_AGE"      1
    _validate_uint PROVOST_MAX_INPUT         "$PROVOST_MAX_INPUT"         1
    _validate_uint PROVOST_FILES_MAX_SIZE    "$PROVOST_FILES_MAX_SIZE"    0
    # (validated above, so these arithmetic reads are safe)
    PROVOST_MIN_CONFIDENCE=$((10#$PROVOST_MIN_CONFIDENCE))
    PROVOST_MIN_COVERAGE=$((10#$PROVOST_MIN_COVERAGE))
    PROVOST_MIN_CONSISTENCY=$((10#$PROVOST_MIN_CONSISTENCY))
    PROVOST_RECONCILE_OVERLAP=$((10#$PROVOST_RECONCILE_OVERLAP))
    PROVOST_LOCK_TIMEOUT=$((10#$PROVOST_LOCK_TIMEOUT))
    PROVOST_LOCK_MAX_AGE=$((10#$PROVOST_LOCK_MAX_AGE))
    PROVOST_MAX_INPUT=$((10#$PROVOST_MAX_INPUT))
    PROVOST_FILES_MAX_SIZE=$((10#$PROVOST_FILES_MAX_SIZE))
    [[ "$PROVOST_QUIET" == 0 || "$PROVOST_QUIET" == 1 ]] || usage_die "PROVOST_QUIET must be 0 or 1 (got '$PROVOST_QUIET')."
    [[ "$PROVOST_MULTI" == 0 || "$PROVOST_MULTI" == 1 ]] || usage_die "PROVOST_MULTI must be 0 or 1 (got '$PROVOST_MULTI')."
    [[ "$PROVOST_CONTEXT_COLUMNS" == 0 || "$PROVOST_CONTEXT_COLUMNS" == 1 ]] || usage_die "PROVOST_CONTEXT_COLUMNS must be 0 or 1 (got '$PROVOST_CONTEXT_COLUMNS')."
    [[ "$PROVOST_UNITS" == off || "$PROVOST_UNITS" == base ]] || usage_die "PROVOST_UNITS must be off or base (got '$PROVOST_UNITS')."
    [[ "$PROVOST_MANIFEST_STRICT" == 0 || "$PROVOST_MANIFEST_STRICT" == 1 ]] || usage_die "PROVOST_MANIFEST_STRICT must be 0 or 1 (got '$PROVOST_MANIFEST_STRICT')."
    case "$PROVOST_ENV" in 0|1|modules) ;; *) usage_die "PROVOST_ENV must be 0, 1 or modules (got '$PROVOST_ENV')." ;; esac
    local _p; local -a _ps=()
    read -ra _ps <<< "${PROVOST_ENV_VARS//,/ }"   # (read: no pathname expansion of the globs)
    for _p in ${_ps[@]+"${_ps[@]}"}; do
        [[ "$_p" =~ $_ENV_PAT_RE ]] || usage_die "PROVOST_ENV_VARS holds '$_p', which is not a variable name or glob pattern (letters, digits, '_', and * ? [ ] ! ^ -)."
    done
    [[ "$PROVOST_AUTO_MULTI" == 0 || "$PROVOST_AUTO_MULTI" == 1 ]] || usage_die "PROVOST_AUTO_MULTI must be 0 or 1 (got '$PROVOST_AUTO_MULTI')."
    [[ "$PROVOST_MODEL" == 0 || "$PROVOST_MODEL" == 1 ]] || usage_die "PROVOST_MODEL must be 0 or 1 (got '$PROVOST_MODEL')."
    [[ "$PROVOST_LLM" == 0 || "$PROVOST_LLM" == 1 ]] || usage_die "PROVOST_LLM must be 0 or 1 (got '$PROVOST_LLM')."
    [[ "$PROVOST_LLM_JUDGE" == 0 || "$PROVOST_LLM_JUDGE" == 1 ]] || usage_die "PROVOST_LLM_JUDGE must be 0 or 1 (got '$PROVOST_LLM_JUDGE')."
    [[ "$PROVOST_REDACT" == 0 || "$PROVOST_REDACT" == 1 ]] || usage_die "PROVOST_REDACT must be 0 or 1 (got '$PROVOST_REDACT')."
    [[ "$PROVOST_LLM_MODEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]] || usage_die "PROVOST_LLM_MODEL must be a model id (got '$PROVOST_LLM_MODEL')."
    case "$PROVOST_ASYNC" in ""|auto|0|1) ;; *) usage_die "PROVOST_ASYNC must be 0, 1 or auto (got '$PROVOST_ASYNC')." ;; esac
}

# A dataset name is one path component: [A-Za-z0-9][A-Za-z0-9._-]*, no "..".
_valid_name () { [[ "$1" =~ $_NAME_RE && "$1" != *..* ]]; }
_require_name () { _valid_name "$1" || usage_die "invalid dataset name '$1' (allowed: letters, digits, '.', '_', '-'; must start with a letter or digit; no '..')."; }
_valid_capid () { [[ "$1" =~ ^c[0-9]{1,12}$ ]]; }
# A capture id from what a user types for one: c0007, c7, 7 or capture-c0007
# all mean c0007. Prints it; fails on anything else.
_capid_of () {
    local t="${1#capture-}"
    [[ "$t" =~ ^c?([0-9]{1,12})$ ]] || return 1
    printf 'c%04d\n' "$((10#${BASH_REMATCH[1]}))"
}

# Turn an arbitrary word (a command's basename) into a valid dataset name.
# Prints nothing when nothing usable is left.
_sanitize_name () {
    local s="$1"
    s="${s//[!${_ALNUM}._-]/-}"
    while [[ "$s" == *..* ]]; do s="${s//../.}"; done
    s="${s#"${s%%["${_ALNUM}"]*}"}"          # must start with a letter/digit
    s="${s:0:64}"
    printf '%s' "$s"
}

# ---------------------------------------------------------------------------
# Process-wide cleanup: temp dirs we created and store locks we hold are
# released on ANY exit (normal, die, or signal) — a `die` inside the critical
# section can never leave the store locked.
# ---------------------------------------------------------------------------
_TMPDIRS=()
_LOCKS_HELD=()      # lock dir paths held by this process
_LOCKS_OWNER=()     # the owner record we wrote into each
_cleanup () {
    local i d
    for i in ${_LOCKS_HELD[@]+"${!_LOCKS_HELD[@]}"}; do
        _release_lock_dir "${_LOCKS_HELD[i]}" "${_LOCKS_OWNER[i]}"
    done
    _LOCKS_HELD=(); _LOCKS_OWNER=()
    for d in ${_TMPDIRS[@]+"${_TMPDIRS[@]}"}; do rm -rf "$d" 2>/dev/null || true; done
    _TMPDIRS=()
}
trap _cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# _mktempd PREFIX — make a registered temp dir; result in $_MKTEMPD. (Not via
# $(...): the registration must happen in THIS shell.)
_mktempd () {
    _MKTEMPD="$(mktemp -d "$PROVOST_TEMP_DIR/$1.XXXXXX")" \
        || die "cannot create a temp dir in $PROVOST_TEMP_DIR (set TMPDIR)."
    _TMPDIRS+=("$_MKTEMPD")
}

# ---------------------------------------------------------------------------
# Locate the engines + transform — ONLY inside provost's install dir. The data
# store is never searched: a group-writable shared store would otherwise let
# any member plant code that runs as whoever captures next.
# ---------------------------------------------------------------------------
_find_engine () {
    local c="$PROVOST_ROOT/extract/provost-extract"
    [[ -f "$c" ]] && { printf '%s\n' "$c"; return 0; }
    return 1
}
_find_analyze () {
    local c="$PROVOST_ROOT/analyze/provost-analyze"
    [[ -f "$c" ]] && { printf '%s\n' "$c"; return 0; }
    return 1
}

# Run a bundled engine: no GIT_DIR leaking in, and the engine's legacy .provostrc
# config layer switched off (PROVOST_NO_RC=1) so a .provostrc in the CWD, $HOME or
# any parent cannot reconfigure a capture behind provost's back.
_run_engine () { env -u GIT_DIR PROVOST_NO_RC=1 bash "$@"; }

# ---------------------------------------------------------------------------
# Transform layer — the tidy melt (`_core_melt_tidy`) and schema-union helpers
# (`_core_union_header`, `_core_align_rows`) live in provost/transform/melt.sh.
# ---------------------------------------------------------------------------
if [[ -r "$PROVOST_ROOT/transform/melt.sh" ]]; then
    # shellcheck source=transform/melt.sh
    source "$PROVOST_ROOT/transform/melt.sh"
else
    die "transform module not found (expected at $PROVOST_ROOT/transform/melt.sh)."
fi
# Units as data (`--units base`, `_core_units_base`): transform/units.sh.
if [[ -r "$PROVOST_ROOT/transform/units.sh" ]]; then
    # shellcheck source=transform/units.sh
    source "$PROVOST_ROOT/transform/units.sh"
else
    die "transform module not found (expected at $PROVOST_ROOT/transform/units.sh)."
fi

_ds_dir ()  { printf '%s/datasets\n' "$PROVOST_WORKSPACE"; }
_cap_dir () { printf '%s/captures\n' "$PROVOST_WORKSPACE"; }
_prov_file ()  { printf '%s/provenance.tsv\n' "$PROVOST_WORKSPACE"; }
_rowid_file () { printf '%s/.next_row_id\n' "$PROVOST_WORKSPACE"; }
_capid_file () { printf '%s/.next_capture_id\n' "$PROVOST_WORKSPACE"; }
_faillog ()    { printf '%s/.async-failures.log\n' "$PROVOST_WORKSPACE"; }
_failseen ()   { printf '%s/.async-failures.seen\n' "$PROVOST_WORKSPACE"; }

# git wrapper:
#   * pinned identity + no signing, so commits work in any environment;
#   * safe.directory=<store>, so a shared store owned by another user works
#     instead of tripping git's dubious-ownership check;
#   * hooks and fsmonitor disabled — with safe.directory lifted, a store's own
#     .git/config or hooks (writable by the store's other members) must not be
#     able to run code as us;
#   * the caller's GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE can't redirect us.
_WS_REAL=""; _WS_REAL_FOR=""

# Lifting safe.directory hands the store's own .git/config the trust git would
# otherwise withhold, and hooks are not the only way a config runs code: filter
# drivers (filter.*.clean/smudge), diff/merge drivers, core.pager,
# core.sshCommand, include.path and friends all do. So when the store's git dir
# could have been written by someone else — .git or .git/config not owned by
# us, or the config group/world-writable — every key in it must be one git
# itself writes (or `provost import`'s clone does). Anything else: refuse.
_perm_bits () { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null || true; }
_owner_uid () { stat -c %u "$1" 2>/dev/null || stat -f %u "$1" 2>/dev/null || true; }
_vet_store_config () {
    local gd="$PROVOST_WORKSPACE/.git" cfg me p bad
    cfg="$gd/config"
    [[ -f "$cfg" ]] || return 0
    me="$(id -u 2>/dev/null || echo)"
    p="$(_perm_bits "$cfg")"
    if [[ -n "$me" && "$(_owner_uid "$gd")" == "$me" && "$(_owner_uid "$cfg")" == "$me" \
          && "$p" =~ ^[0-7]*[0-7][0145][0145]$ ]]; then
        return 0                                   # ours alone: git's own trust applies
    fi
    bad="$(env -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT \
             git config --file "$cfg" --no-includes --name-only --list 2>/dev/null \
           | LC_ALL=C awk '{ k = tolower($0) }
               k ~ /^core\.(repositoryformatversion|filemode|bare|logallrefupdates|sharedrepository|ignorecase|precomposeunicode|symlinks)$/ { next }
               k ~ /^extensions\.objectformat$/ || k ~ /^init\.defaultbranch$/ { next }
               k ~ /^user\.(name|email)$/ || k ~ /^gc\.[a-z]+$/ { next }
               k ~ /^remote\.origin\.(url|fetch)$/ || k ~ /^branch\.(main|master)\.(remote|merge)$/ { next }
               { print $0 }')"
    [[ -z "$bad" ]] && return 0
    die "refusing to use the store at $PROVOST_WORKSPACE: its .git/config is writable by others and sets ${bad//$'\n'/, } — settings that can make git run programs. Remove them (git config --file $(printf '%q' "$cfg") --unset <key>) if you trust them to be harmless."
}

_git () {
    if [[ "$_WS_REAL_FOR" != "$PROVOST_WORKSPACE" ]]; then
        _vet_store_config
        if _WS_REAL="$(cd -P -- "$PROVOST_WORKSPACE" 2>/dev/null && pwd)"; then
            _WS_REAL_FOR="$PROVOST_WORKSPACE"
        else
            _WS_REAL="$PROVOST_WORKSPACE"
        fi
    fi
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
        -u GIT_COMMON_DIR -u GIT_NAMESPACE ${_GIT_INDEX:+"GIT_INDEX_FILE=$_GIT_INDEX"} \
        git -C "$PROVOST_WORKSPACE" -c safe.directory="$_WS_REAL" \
        -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        -c user.name=provost -c user.email=provost@localhost \
        -c commit.gpgsign=false -c tag.gpgSign=false "$@"
}

# Stage everything and commit. Prints git's own error and exits non-zero if
# git fails — provost never reports "ok" for a capture git did not record.
_commit () {
    local msg="$1" out rc=0
    out="$(_git add -A 2>&1)" || { printf 'git: %s\n' "$out" >&2; die "git add failed in $PROVOST_WORKSPACE — nothing was committed."; }
    _git diff --cached --quiet >/dev/null 2>&1 || rc=$?
    [[ $rc -eq 0 ]] && return 0                    # nothing staged: nothing to do
    out="$(_git commit -q -m "$msg" 2>&1)" || {
        printf 'git: %s\n' "$out" >&2
        die "git commit failed in $PROVOST_WORKSPACE — nothing was committed (the files stay in the store and go into the next successful commit)."
    }
}

# --- input hashes (PV-026) ---------------------------------------------------
# _sha256 FILE — the file's sha256 as 64 hex digits, from whichever of
# sha256sum (GNU), shasum -a 256 (macOS, BSD) or openssl is installed; prints
# nothing when none is (the capture is then filed unhashed, as before).
_sha256 () {
    local h=""
    if command -v sha256sum >/dev/null 2>&1; then h="$(sha256sum < "$1" 2>/dev/null)"
    elif command -v shasum >/dev/null 2>&1; then h="$(shasum -a 256 < "$1" 2>/dev/null)"
    elif command -v openssl >/dev/null 2>&1; then h="$(openssl dgst -sha256 -r < "$1" 2>/dev/null)"
    fi
    h="${h%% *}"; h="${h##*= }"
    [[ "$h" =~ ^[0-9a-fA-F]{64}$ ]] && printf '%s\n' "$h" | tr 'A-F' 'a-f'
    return 0
}

# _receive RAW IN — the input exactly as received (RAW, already bounded by
# PROVOST_MAX_INPUT) becomes IN with its CRs stripped, as provost has always
# stored it, and its secrets scrubbed (PV-033, unless PROVOST_REDACT=0); the
# sha256 and size of RAW, before any change, are kept beside it in
# IN.received ("sha256<TAB>bytes") for _ingest_store to record, and what the
# scrub found in IN.redacted ("kind<TAB>n" lines, or "off"). RAW goes.
_receive () {
    local raw="$1" in="$2" h n
    h="$(_sha256 "$raw")"
    n="$(wc -c < "$raw")"; n="${n//[!0-9]/}"
    printf '%s\t%s\n' "$h" "$n" > "$in.received"
    tr -d '\r' < "$raw" > "$in"; rm -f "$raw"
    if [[ "$PROVOST_REDACT" == 1 ]]; then : > "$in.redacted"; _scrub "$in" "$in.redacted"
    else echo off > "$in.redacted"; fi
}

# --- the secret scrub (PV-033) ------------------------------------------------
# _scrub FILE COUNTS — FILE with every known secret pattern
# (lib/provost_redact.awk: private keys, Authorization headers, tokens,
# password=..., ...) replaced by [REDACTED:kind]; what was found is appended
# to COUNTS as "kind<TAB>n" lines. A file with nothing to scrub is left byte
# for byte as it was; a scrubbed one keeps a missing final newline missing.
_scrub () {
    local f="$1" counts="$2" c="$1.scrub-counts" n
    [[ -f "$PROVOST_ROOT/lib/provost_redact.awk" ]] \
        || die "the secret scrub is missing ($PROVOST_ROOT/lib/provost_redact.awk) — nothing captured (PROVOST_REDACT=0 files inputs unscrubbed)."
    rm -f "$c"
    LC_ALL=C awk -f "$PROVOST_ROOT/lib/provost_redact.awk" -v MODE=secrets -v COUNTS="$c" < "$f" > "$f.scrubbed" \
        || { rm -f "$f.scrubbed" "$c"; die "the secret scrub failed — nothing captured."; }
    if [[ -s "$c" ]]; then
        if [[ -s "$f" && "$(tail -c 1 "$f" | od -An -tx1 | tr -d ' \n')" != 0a ]]; then
            n="$(wc -c < "$f.scrubbed")"; n="${n//[!0-9]/}"
            head -c "$((n - 1))" "$f.scrubbed" > "$f.scrubbed2" && mv -f "$f.scrubbed2" "$f.scrubbed"
        fi
        mv -f "$f.scrubbed" "$f"
        cat "$c" >> "$counts"
    else
        rm -f "$f.scrubbed"
    fi
    rm -f "$c"
}
# _scrub_text TEXT COUNTS — TEXT (one line) scrubbed, on stdout; the counts
# go to COUNTS, as _scrub's do (COUNTS.text is the scratch file).
_scrub_text () {
    local t="$2.text"
    printf '%s\n' "$1" > "$t"
    _scrub "$t" "$2"
    cat "$t"; rm -f "$t"
}
# _redacted_summary FILE — an IN.redacted file as meta.tsv records it:
# "kind=n,..." (sorted), "none", or "off".
_redacted_summary () {
    LC_ALL=C sort "$1" 2>/dev/null | awk -F'\t' '
        $1 == "off" { off = 1; next }
        NF == 2 { if (!($1 in n)) o[++k] = $1; n[$1] += $2 }
        END { if (off) { print "off"; exit }
              if (!k) { print "none"; exit }
              for (i = 1; i <= k; i++) s = s (i > 1 ? "," : "") o[i] "=" n[o[i]]
              print s }'
}

# _hash_trailers ID... — the commit-message trailer for these captures: a
# blank line, then "Input-SHA256: ID SHA256" and "Output-SHA256: ID SHA256"
# per capture, from each one's meta.tsv (nothing for a hash not recorded).
_hash_trailers () {
    local id t=""
    for id in "$@"; do
        t="$t$(awk -F'\t' -v id="$id" '
            $1 == "input_sha256"  { printf "\nInput-SHA256: %s %s", id, $2 }
            $1 == "output_sha256" { printf "\nOutput-SHA256: %s %s", id, $2 }' \
            "$(_cap_dir)/$id/meta.tsv" 2>/dev/null)"
    done
    [[ -n "$t" ]] && printf '\n%s' "$t"
    return 0
}

# The branch captures are committed on: main (or master in a store created by
# an older git without our rename).
_main_branch () {
    if _git show-ref -q --verify refs/heads/main 2>/dev/null; then echo main
    elif _git show-ref -q --verify refs/heads/master 2>/dev/null; then echo master
    else echo main; fi
}

# Refuse to write while the store is on a restored capture (detached HEAD) or
# some other branch: a commit there would be orphaned or land off-history.
_require_on_branch () {
    [[ -d "$PROVOST_WORKSPACE/.git" ]] || return 0
    local head main
    head="$(_git symbolic-ref -q --short HEAD 2>/dev/null)" \
        || die "store is on a restored capture (detached HEAD) — new captures would be lost. Return with: provost restore latest"
    main="$(_main_branch)"
    [[ "$head" == "$main" ]] \
        || die "store is on branch '$head', not '$main' — refusing to write. Return with: provost restore latest"
}

# --- store lock (a shared PROVOST_HOME may have concurrent writers) ----------
# mkdir is atomic across processes/users; spin up to PROVOST_LOCK_TIMEOUT
# seconds. The lock records "host<TAB>pid<TAB>uid<TAB>epoch" (owner file).
# A lock is STALE only if:
#   * it is older than PROVOST_LOCK_MAX_AGE seconds (any host), or
#   * it was taken on THIS host (and pid namespace) and its pid definitely no
#     longer exists (ESRCH — NOT EPERM: another user's live process is alive).
# Breaking is serialised by a second mkdir mutex (.lock.break) and done by an
# atomic rename, after re-checking staleness under that mutex — so two
# breakers can never delete each other's (or a newcomer's) fresh lock.
# $BASHPID (this process), NOT $$: a detached async ingest runs in a subshell
# where $$ is still the already-exited parent provost.
_LOCK_HOST=""
_lock_host_init () {
    if [[ -z "$_LOCK_HOST" ]]; then
        local h ns=""
        h="${HOSTNAME:-}"; [[ -n "$h" ]] || h="$(uname -n 2>/dev/null || echo unknown)"
        ns="$(readlink /proc/self/ns/pid 2>/dev/null || true)"
        _LOCK_HOST="$h${ns:+/$ns}"
    fi
}
# mtime in epoch seconds; prints nothing if the path is gone.
_mtime () { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || true; }
# Age in seconds of a path; -1 if it is gone (never "old").
_age () { local m; m="$(_mtime "$1")"; [[ "$m" =~ ^[0-9]+$ ]] || { echo -1; return 0; }; echo $(( $(date +%s) - m )); }
# 0 only when the pid definitely does not exist on this host.
_pid_gone () {
    local pid="$1" err
    [[ "$pid" =~ ^[0-9]{1,10}$ ]] || return 1
    if [[ -d /proc/self ]]; then [[ ! -d "/proc/$pid" ]]; return; fi
    err="$(LC_ALL=C kill -0 "$pid" 2>&1)" && return 1       # alive and ours
    [[ "$err" == *"No such process"* ]]                     # ESRCH; EPERM = alive
}
# 0 = the lock is stale. Sets $_STALE_SEEN to the owner record it judged, so a
# breaker can verify it removed THAT lock and not a newcomer's.
_lock_stale () {
    local lock="$1" owner="" host="" pid="" t="" now age
    _STALE_SEEN=""
    [[ -d "$lock" ]] || return 1
    now="$(date +%s)"
    owner="$(cat "$lock/owner" 2>/dev/null || true)"
    if [[ -z "$owner" ]]; then
        age="$(_age "$lock")"
        if [[ -f "$lock/pid" ]]; then               # a lock from an older provost
            pid="$(cat "$lock/pid" 2>/dev/null || true)"
            _STALE_SEEN="legacy:$pid"
            (( age > PROVOST_LOCK_MAX_AGE )) && return 0
            _pid_gone "$pid" && return 0
            return 1
        fi
        # mkdir'd but no owner yet: a holder is between mkdir and writing it —
        # or died right there. Give it a minute.
        _STALE_SEEN="none"
        (( age > 60 )) && return 0
        return 1
    fi
    _STALE_SEEN="$owner"
    IFS=$'\t' read -r host pid _ t <<< "$owner" || true
    if [[ "$t" =~ ^[0-9]{1,12}$ ]] && (( now - t > PROVOST_LOCK_MAX_AGE )); then return 0; fi
    _lock_host_init
    [[ "$host" == "$_LOCK_HOST" ]] && _pid_gone "$pid" && return 0
    return 1
}
_lock_break () {  # 0 = we removed a stale lock
    local lock="$1" brk="$1.break" rc=1 aside seen got
    if ! mkdir "$brk" 2>/dev/null; then
        # Another process is breaking it. Clear an abandoned break mutex.
        if (( $(_age "$brk") > 60 )); then rmdir "$brk" 2>/dev/null || true; fi
        return 1
    fi
    if _lock_stale "$lock"; then
        seen="$_STALE_SEEN"
        aside="$lock.stale.$BASHPID.$RANDOM"
        if mv "$lock" "$aside" 2>/dev/null; then
            # Verify we moved the lock we judged (not one created meanwhile).
            got="$(cat "$aside/owner" 2>/dev/null || true)"
            if [[ -z "$got" ]]; then
                if [[ -f "$aside/pid" ]]; then got="legacy:$(cat "$aside/pid" 2>/dev/null || true)"; else got="none"; fi
            fi
            if [[ "$got" == "$seen" ]]; then
                rm -rf "$aside" 2>/dev/null || true; rc=0
            else
                mv "$aside" "$lock" 2>/dev/null || true     # not ours to break: put it back
            fi
        fi
    fi
    rmdir "$brk" 2>/dev/null || true
    return $rc
}
# _lock [STORE-DIR] (default: the active store)
_lock () {
    local dir="${1:-$PROVOST_WORKSPACE}" lock tries=0 max owner i
    lock="$dir/.lock"
    for i in ${_LOCKS_HELD[@]+"${!_LOCKS_HELD[@]}"}; do
        [[ "${_LOCKS_HELD[i]}" == "$lock" ]] && return 0
    done
    max=$((PROVOST_LOCK_TIMEOUT * 5))
    mkdir -p "$dir" 2>/dev/null || true
    while ! mkdir "$lock" 2>/dev/null; do
        [[ -d "$dir" ]] || die "cannot create the store directory: $dir"
        if _lock_stale "$lock" && _lock_break "$lock"; then continue; fi
        tries=$((tries + 1))
        if (( tries > max )); then
            owner="$(cat "$lock/owner" 2>/dev/null || cat "$lock/pid" 2>/dev/null || echo unknown)"
            die "store is locked (waited ${PROVOST_LOCK_TIMEOUT}s): $lock — held by ${owner//$'\t'/ }. If that holder is gone, remove the lock dir."
        fi
        sleep 0.2
    done
    _lock_host_init
    local mypid="$BASHPID" myuid; myuid="$(id -u 2>/dev/null || echo "?")"
    printf -v owner "%s\t%s\t%s\t%s" "$_LOCK_HOST" "$mypid" "$myuid" "$(date +%s)"
    printf '%s\n' "$owner" > "$lock/owner.tmp" && mv "$lock/owner.tmp" "$lock/owner"
    _LOCKS_HELD+=("$lock"); _LOCKS_OWNER+=("$owner")
}
# Remove a lock dir only if it still carries OUR owner record.
_release_lock_dir () {
    local lock="$1" mine="$2" cur
    # read, not $(cat): no subshell for a Ctrl-C to kill, so the lock goes
    cur=""; { IFS= read -r cur < "$lock/owner"; } 2>/dev/null || true
    [[ "$cur" == "$mine" ]] && rm -rf "$lock" 2>/dev/null
    return 0
}
_unlock () {
    local lock="${1:-$PROVOST_WORKSPACE}/.lock" i keep_l=() keep_o=()
    for i in ${_LOCKS_HELD[@]+"${!_LOCKS_HELD[@]}"}; do
        if [[ "${_LOCKS_HELD[i]}" == "$lock" ]]; then
            _release_lock_dir "$lock" "${_LOCKS_OWNER[i]}"
        else
            keep_l+=("${_LOCKS_HELD[i]}"); keep_o+=("${_LOCKS_OWNER[i]}")
        fi
    done
    _LOCKS_HELD=(${keep_l[@]+"${keep_l[@]}"}); _LOCKS_OWNER=(${keep_o[@]+"${keep_o[@]}"})
}

# ---------------------------------------------------------------------------
# Store initialisation + migrations
# ---------------------------------------------------------------------------
# Runtime files that must never be committed (lock, async failure log, temp
# files, the machine-local instance registry). The first line is a version
# marker: a store whose .gitignore lacks it is migrated.
_GITIGNORE_MARK="# provost store .gitignore v1 — runtime files, never committed"
_write_gitignore () {
    cat > "$PROVOST_WORKSPACE/.gitignore" <<EOF
$_GITIGNORE_MARK
/.lock
/.lock.*
/.async-failures.log
/.async-failures.seen
/instances.tsv
/instances.tsv.*
/datasets/.recon.*
/datasets/.stage.*
/datasets/.rm.*
/datasets/.rmprov.*
/captures/*/.meta.tmp
/context/*.tmp
EOF
}

# Highest capture number ever used in this store: capture dirs, capture tags
# and capture commit subjects (the latter survive an 'rm' purge).
_scan_max_capture_num () {
    local d n max=0
    for d in "$(_cap_dir)"/c*/; do
        [[ -d "$d" ]] || continue
        d="${d%/}"; n="${d##*/c}"
        [[ "$n" =~ ^[0-9]{1,12}$ ]] && (( 10#$n > max )) && max=$((10#$n))
    done
    n="$( { _git tag -l 'capture-c*' 2>/dev/null || true
            _git log --all --format=%s 2>/dev/null || true; } \
          | awk '{ s = $0
                   if (s ~ /^capture-c[0-9]+$/) { sub(/^capture-c/, "", s) }
                   else if (s ~ /^capture c[0-9]+:/) { sub(/^capture c/, "", s); sub(/:.*/, "", s) }
                   else next
                   if (s + 0 > m) m = s + 0 }
                 END { print m + 0 }')"
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > max )) && max=$n
    printf '%s\n' "$max"
}

# Idempotent store upkeep for stores made by an older provost: add the
# .gitignore, untrack a committed .lock (and other runtime files), and seed the
# monotonic capture counter. Only when writable and on the capture branch.
# Store format, recorded (and committed) in .store_format. 2 = datasets carry
# no `total_entries` column (melt stopped emitting the engine's record count
# on 2026-09-25; datasets written before then still had it). 3 = every
# dataset's second column is `capture`, the id of the capture each row came
# from (2026-10-28; earlier rows are filled in from provenance.tsv). 4 = that
# column holds the capture id in every row: a reconcile before 2026-11-04 could
# match a data column named `capture` to it by name (PV-015), and the rows it
# got wrong are put right from provenance.tsv.
_STORE_FORMAT=4
_store_format_file () { printf '%s/.store_format\n' "$PROVOST_WORKSPACE"; }
_store_format () { local f; f="$(cat "$(_store_format_file)" 2>/dev/null || true)"; [[ "$f" =~ ^[0-9]{1,6}$ ]] && echo "$f" || echo 1; }

# Format 1 -> 2: drop the `total_entries` column from every dataset that has
# one. It is the engine's per-capture record count, not a variable; in a
# reconciled dataset new rows already blank-fill it. Only a column whose cells
# are all integers or empty is dropped — anything else is real data under
# that name and stays.
_migrate_drop_total_entries () {
    local f tmp
    for f in "$(_ds_dir)"/*.tsv; do
        [[ -f "$f" ]] || continue
        tmp="$f.mig.$$"
        if awk -F'\t' -v OFS='\t' '
            NR == 1 { for (i = 1; i <= NF; i++) if ($i == "total_entries") c = i
                      if (!c) exit 3 }
            { L[NR] = $0; if (NR > 1 && $c != "" && $c !~ /^[0-9]+$/) exit 3 }
            END {
                if (!c) exit 3
                for (r = 1; r <= NR; r++) {
                    n = split(L[r], F, "\t"); out = ""; k = 0
                    for (i = 1; i <= n; i++) if (i != c) { out = out (k++ ? OFS : "") F[i] }
                    print out
                }
            }' "$f" > "$tmp"; then
            mv "$tmp" "$f"
        else
            rm -f "$tmp"
        fi
    done
}

# Format 2 -> 3: insert the `capture` column after '#' in every dataset,
# filled from provenance.tsv (# -> capture). One awk over provenance and every
# dataset; a header that does not start with '#' is not a provost dataset and
# is left alone. A data column already named `capture` keeps its name and the
# added one becomes `_capture`, exactly as a new capture names it. A dataset
# that already carries the column (its second column is named so and every
# row's value is that row's capture) is left as it is, so a store whose
# .store_format went missing is not given the column twice.
_migrate_add_capture () {
    local dir prov f skip; dir="$(_ds_dir)"; prov="$(_prov_file)"
    local -a files=()
    for f in "$dir"/*.tsv; do [[ -f "$f" ]] && files+=("$f"); done
    (( ${#files[@]} )) || return 0
    [[ -f "$prov" ]] || prov=/dev/null
    skip="$dir/.mig-skip.$$"; : > "$skip"
    awk -F'\t' -v OFS='\t' -v P="$prov" -v SKIP="$skip" '
        function done_file() { if (out != "") { close(out); if (had) print prev > SKIP }; out = "" }
        FILENAME == P { if (FNR > 1) cap[$1] = $3; next }
        FNR == 1 {
            done_file(); if ($1 != "#") next
            out = FILENAME ".mig"; prev = FILENAME; split("", U)
            had = ($2 ~ /^_*capture$/)
            for (i = 1; i <= NF; i++) U[$i] = 1
            c = "capture"; while (c in U) c = "_" c
        }
        out == "" { next }
        FNR > 1 && had && !($1 in cap && $2 == cap[$1]) { had = 0 }
        { rest = substr($0, length($1) + 2)
          v = (FNR == 1) ? c : (($1 in cap) ? cap[$1] : "")
          if (NF == 1) print $1, v > out; else print $1, v, rest > out }
        END { done_file() }
    ' "$prov" "${files[@]}" || { for f in "${files[@]}"; do rm -f "$f.mig"; done; rm -f "$skip"; return 1; }
    for f in "${files[@]}"; do
        [[ -f "$f.mig" ]] || continue
        if grep -qxF -- "$f" "$skip"; then rm -f "$f.mig"; else mv "$f.mig" "$f"; fi
    done
    rm -f "$skip"
    return 0
}

# Format 3 -> 4: put provost's capture column right where a reconcile matched
# a data column named `capture` to it by name (PV-015). In such a row column 2
# holds a data value (or nothing) and the row's capture id sits in another
# column named `capture`, `_capture`, ...; provenance.tsv says which id is the
# row's. The two values change places, and when that happened in any row the
# two columns' names do too if column 2 has the shorter one (a capture gives
# provost's column the longer name, so the data column keeps its own). A
# dataset is left as it is unless every row that disagrees with provenance is
# put right by the same column.
_migrate_fix_capture_column () {
    local dir prov f tmp; dir="$(_ds_dir)"; prov="$(_prov_file)"
    [[ -f "$prov" ]] || return 0
    for f in "$dir"/*.tsv; do
        [[ -f "$f" ]] || continue
        tmp="$f.mig.$$"
        if awk -F'\t' -v OFS='\t' -v P="$prov" '
            FILENAME == P { if (FNR > 1) cap[$1] = $3; next }
            FNR == 1 { if ($1 != "#" || NF < 3) exit 3
                       for (i = 3; i <= NF; i++) if ($i ~ /^_*capture$/) C[i] = 1
                       H = $0; next }
            { L[++nr] = $0
              if (!($1 in cap) || $2 == cap[$1]) next
              k = 0; for (i in C) if ($i == cap[$1]) { k = i + 0; break }
              if (!k || (j && k != j)) { bad = 1; exit 3 }
              j = k; S[nr] = 1 }
            END {
                if (bad || !j) exit 3
                nh = split(H, h, "\t")
                if (length(h[2]) < length(h[j])) { t = h[2]; h[2] = h[j]; h[j] = t }
                s = h[1]; for (i = 2; i <= nh; i++) s = s OFS h[i]; print s
                for (r = 1; r <= nr; r++) {
                    if (!(r in S)) { print L[r]; continue }
                    n = split(L[r], F, "\t"); t = F[2]; F[2] = F[j]; F[j] = t
                    s = F[1]; for (i = 2; i <= n; i++) s = s OFS F[i]; print s
                }
            }' "$prov" "$f" > "$tmp"; then
            mv "$tmp" "$f"
        else
            rm -f "$tmp"
        fi
    done
    return 0
}

_migrate_store () {
    local ws="$PROVOST_WORKSPACE" first=""
    [[ -d "$ws/.git" && -w "$ws" ]] || return 0
    [[ -f "$ws/.gitignore" ]] && { IFS= read -r first < "$ws/.gitignore" || true; }
    [[ "$first" == "$_GITIGNORE_MARK" && -f "$(_capid_file)" && "$(_store_format)" -ge $_STORE_FORMAT ]] && return 0
    _git symbolic-ref -q HEAD >/dev/null 2>&1 || return 0      # restored/detached: later
    _lock
    IFS= read -r first < "$ws/.gitignore" 2>/dev/null || first=""
    if [[ "$first" != "$_GITIGNORE_MARK" ]]; then
        _write_gitignore
        _git rm -r -q --cached --ignore-unmatch -- .lock instances.tsv \
            .async-failures.log .async-failures.seen >/dev/null 2>&1 || true
    fi
    if [[ ! -f "$(_capid_file)" ]]; then
        echo "$(( $(_scan_max_capture_num) + 1 ))" > "$(_capid_file)"
    fi
    if (( $(_store_format) < 2 )); then
        _migrate_drop_total_entries
    fi
    if (( $(_store_format) < 3 )); then
        _migrate_add_capture || die "could not add the capture column to the datasets (store format 3)."
    fi
    if (( $(_store_format) < 4 )); then
        _migrate_fix_capture_column
    fi
    echo "$_STORE_FORMAT" > "$(_store_format_file)"
    _commit "provost: store maintenance (.gitignore, untrack runtime files, capture counter, store format $_STORE_FORMAT)"
    _unlock
}

# The workspace is a git repo: every capture is one commit (tagged capture-NNNN),
# so a run can be brought back up later with `provost restore`. Initialization is
# serialised with double-checked locking so concurrent first-writers to a shared
# store don't race on `git init`.
_ensure_workspace () {
    _vet_store_config
    mkdir -p "$(_ds_dir)" "$(_cap_dir)" 2>/dev/null \
        || die "cannot create the store at $PROVOST_WORKSPACE"
    if [[ ! -d "$PROVOST_WORKSPACE/.git" || ! -f "$(_rowid_file)" ]]; then
        _lock
        if [[ ! -d "$PROVOST_WORKSPACE/.git" ]]; then
            local out
            out="$(_git init -q 2>&1)" || { printf 'git: %s\n' "$out" >&2; die "git init failed in $PROVOST_WORKSPACE"; }
            _git symbolic-ref HEAD refs/heads/main >/dev/null 2>&1 || true
            _write_gitignore
            printf 'provost workspace (store model %s)\n' "$PROVOST_VERSION" > "$PROVOST_WORKSPACE/.provostrc"
            [[ -f "$(_capid_file)" ]] || echo 1 > "$(_capid_file)"
            echo "$_STORE_FORMAT" > "$(_store_format_file)"
        fi
        [[ -f "$(_rowid_file)" ]] || echo 1 > "$(_rowid_file)"
        _commit "provost: init workspace"
        _unlock
    fi
    _migrate_store
}

# Allocate the next capture id from the monotonic counter (under the lock).
# Ids are never reused — not after an 'rm' purge, not after a 'restore'.
# Result in $_CAPID.
_next_capture_id () {
    local f n; f="$(_capid_file)"
    n="$(cat "$f" 2>/dev/null || true)"
    if [[ ! "$n" =~ ^[0-9]{1,12}$ ]] || (( 10#$n < 1 )); then
        n=$(( $(_scan_max_capture_num) + 1 ))
    fi
    n=$((10#$n))
    # Belt and braces: never land on an id that is already on disk or tagged.
    while [[ -e "$(_cap_dir)/$(printf 'c%04d' "$n")" ]] \
          || _git rev-parse -q --verify "refs/tags/capture-$(printf 'c%04d' "$n")" >/dev/null 2>&1; do
        n=$((n + 1))
    done
    echo "$((n + 1))" > "$f"
    _CAPID="$(printf 'c%04d' "$n")"
}

# Column overlap (Jaccard, as an integer percent) between two tab-separated
# headers passed as the two lines of stdin.
_col_overlap () {
    # A stored header's second column (after '#') is the capture id every
    # dataset carries; it is in both headers by construction, so it is left
    # out rather than let it nudge two different shapes into one dataset.
    awk -F'\t' '
        NR==1 { for(i=1;i<=NF;i++){ if(i==2 && $1=="#") continue; a[$i]=1 }; na=NF }
        NR==2 { for(i=1;i<=NF;i++){ if(i==2 && $1=="#") continue; b[$i]=1; if($i in a) inter++ } }
        END { for(k in a) u[k]=1; for(k in b) u[k]=1; nu=0; for(k in u) nu++;
              if(nu==0){print 100; exit} printf "%d\n", int(inter*100/nu) }'
}

# _store_fix_row_id FILE — a dataset filed before PV-011 (2026-11-04) can hold
# a data column named `#` beside the store's own (column 1): the melt now files
# such a column as `#_2` (transform/melt.sh, _CORE_MELT_ROW_ID). Rename the
# stored one the same way (`#_K`, the first K >= 2 its header does not use), in
# place and once, so the next capture's `#_2` lines up with it instead of the
# by-name union dropping the old column and its values.
_store_fix_row_id () {
    local f="$1" h="" tmp
    IFS= read -r h < "$f" || true
    [[ "$h" == "#"$'\t'* && $'\t'"${h#*$'\t'}"$'\t' == *$'\t#\t'* ]] || return 0
    tmp="$(mktemp "$(dirname "$f")/.rowid.XXXXXX")"
    if awk -F'\t' -v OFS='\t' 'NR == 1 {
            for (i = 1; i <= NF; i++) ALL[$i] = 1
            for (i = 2; i <= NF; i++) if ($i == "#") {
                k = 2; u = "#_" k; while (u in ALL) u = "#_" (++k)
                ALL[u] = 1; $i = u }
         } { print }' "$f" > "$tmp"; then
        mv "$tmp" "$f"
    else
        rm -f "$tmp"; return 1
    fi
}

# _capcol_align OLD NEW — the two headers of a reconcile, each printed on its
# own line with column 2 (provost's capture column, when the header starts
# with '#') renamed to `capture`, or `_capture`, `__capture`, ... : the first
# that is not the name of any other column in either header. A data column
# named `capture` arriving in a dataset whose own capture column is called
# `capture` (or the reverse) would otherwise be matched to it by name.
_capcol_align () {
    _CA_O="$1" _CA_N="$2" awk 'BEGIN {
        o = ENVIRON["_CA_O"]; n = ENVIRON["_CA_N"]
        no = split(o, a, "\t"); nn = split(n, b, "\t")
        for (i = 1; i <= no; i++) if (!(i == 2 && a[1] == "#")) U[a[i]] = 1
        for (i = 1; i <= nn; i++) if (!(i == 2 && b[1] == "#")) U[b[i]] = 1
        c = "capture"; while (c in U) c = "_" c
        if (a[1] == "#" && no >= 2) a[2] = c
        if (b[1] == "#" && nn >= 2) b[2] = c
        s = ""; for (i = 1; i <= no; i++) s = s (i > 1 ? "\t" : "") a[i]; print s
        s = ""; for (i = 1; i <= nn; i++) s = s (i > 1 ? "\t" : "") b[i]; print s
    }'
}

# Append a tidy TSV FILE (header+rows) to a dataset. Store rule:
#   new dataset            → write header + rows;
#   header matches         → append data rows;
#   header differs, overlap ≥ PROVOST_RECONCILE_OVERLAP% → RECONCILE: union the
#                            columns, blank-fill both sides, rewrite in place;
#   overlap below threshold → split into a numbered variant (.v2, .v3, …).
# Sets $_SA_TARGET to the final dataset name. Works on files throughout — a
# large capture is never echoed through a pipe or held in a variable.
_store_append () {
    local name="$1" src="$2" dir; dir="$(_ds_dir)"
    local base="$dir/$name.tsv" target="$name" file new_header="" old_header="" line=""
    IFS= read -r new_header < "$src" || true

    if [[ ! -f "$base" ]]; then
        cp "$src" "$base"
    else
        _store_fix_row_id "$base" || return 1
        IFS= read -r old_header < "$base" || true
        if [[ "$old_header" == "$new_header" ]]; then
            tail -n +2 "$src" >> "$base"
        else
            local overlap; overlap="$(printf '%s\n%s\n' "$old_header" "$new_header" | _col_overlap)"
            [[ "$overlap" =~ ^[0-9]+$ ]] || overlap=0
            if (( overlap >= PROVOST_RECONCILE_OVERLAP )); then
                # Reconcile into the base dataset: union header, realign both sides.
                # Column 2 is provost's capture column in both, whatever each
                # side named it, so both are first given the one name that no
                # data column of either uses; matching by name then never puts a
                # data column called `capture` into it, or the id into that.
                local unified tmp oh="$old_header" nh="$new_header"
                { IFS= read -r oh; IFS= read -r nh; } < <(_capcol_align "$old_header" "$new_header")
                unified="$(_core_union_header "$oh" "$nh")"
                tmp="$(mktemp "$dir/.recon.XXXXXX")"
                if {
                    printf '%s\n' "$unified"
                    tail -n +2 "$base" | _core_align_rows "$oh" "$unified"
                    tail -n +2 "$src"  | _core_align_rows "$nh" "$unified"
                } > "$tmp"; then
                    mv "$tmp" "$base"
                else
                    rm -f "$tmp"; return 1
                fi
            else
                # Genuinely different shape → variant file.
                local v=2
                while [[ -f "$dir/$name.v$v.tsv" ]]; do
                    _store_fix_row_id "$dir/$name.v$v.tsv" || return 1
                    line=""; IFS= read -r line < "$dir/$name.v$v.tsv" || true
                    [[ "$line" == "$new_header" ]] && break
                    v=$((v+1))
                done
                target="$name.v$v"; file="$dir/$target.tsv"
                if [[ -f "$file" ]]; then tail -n +2 "$src" >> "$file"
                else cp "$src" "$file"; fi
            fi
        fi
    fi
    _SA_TARGET="$target"
}

# Render argv as ONE line of shell: plain words bare, others single-quoted,
# and anything holding a control character (tab, newline, ...) in $'...' form
# via printf %q — so the result never contains a raw tab or newline.
_shell_quote () {
    local a out="" q sq="'\\''"
    for a in "$@"; do
        if [[ -n "$a" && "$a" =~ ^[${_ALNUM}_./=:,+@%^-]+$ ]]; then q="$a"
        elif [[ "$a" == *[[:cntrl:]]* ]]; then printf -v q '%q' "$a"
        else q="'${a//\'/$sq}'"; fi
        out="${out:+$out }$q"
    done
    printf '%s' "$out"
}

# One-line, tab/newline-free rendering of a value for a meta.tsv field.
_meta_safe () { local s="$1"; s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; printf '%s' "$s"; }

# ---------------------------------------------------------------------------
# RUN MANIFEST (PV-020). A profile (extract/manifests/NAME.tsv) names the
# reserved '#%' prologue keys a capture should carry -- requirement, test and
# version, build commit, system under test, ... -- and which are required.
# The check reads a capture's prologue (context.txt) and its later
# annotations (annotations.txt, written by 'provost annotate'); nothing here
# runs unless a profile is asked for, so a capture without a prologue files
# exactly as before.
# ---------------------------------------------------------------------------
_MKEY_RE='^[A-Za-z_][A-Za-z0-9_.-]*$'
# _prologue_kv FILE... -- every key=value word of '#%' lines as KEY<TAB>VALUE,
# in order (a repeated key: the last one is the one that counts). A value may
# be double-quoted to hold spaces -- key="gcc 13.2" -- with \" and \\ inside;
# an unterminated quote is an ordinary word, as before quoting existed. Words
# that are not key=value are skipped. A tab in a value becomes a space.
_prologue_kv () {
    (( $# > 0 )) || return 0
    awk 'function emit(k, v) { gsub(/\t/, " ", v); print k "\t" v }
        { line = $0; sub(/^#%[ \t]*/, "", line)
          while (1) {
              sub(/^[ \t]+/, "", line); if (line == "") break
              if (match(line, /^[A-Za-z_][A-Za-z0-9_.-]*="/)) {
                  k = substr(line, 1, RLENGTH - 2); rest = substr(line, RLENGTH + 1); v = ""; closed = 0
                  while (rest != "") {
                      c = substr(rest, 1, 1)
                      if (c == "\\" && length(rest) > 1) { v = v substr(rest, 2, 1); rest = substr(rest, 3); continue }
                      if (c == "\"") { rest = substr(rest, 2); closed = 1; break }
                      v = v c; rest = substr(rest, 2)
                  }
                  if (closed && (rest == "" || rest ~ /^[ \t]/)) { emit(k, v); line = rest; continue }
              }
              match(line, /^[^ \t]+/); w = substr(line, 1, RLENGTH); line = substr(line, RLENGTH + 1)
              e = index(w, "="); if (e < 2) continue
              k = substr(w, 1, e - 1)
              if (k !~ /^[A-Za-z_][A-Za-z0-9_.-]*$/) continue
              emit(k, substr(w, e + 1))
          } }' "$@"
}
# _prologue_word KEY VALUE -- one key=value word, the value quoted when it
# holds a space or a tab or starts with a quote (so _prologue_kv reads it back).
_prologue_word () {
    local k="$1" v="$2"
    if [[ "$v" == *[[:blank:]]* || "$v" == '"'* ]]; then
        v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="\"$v\""
    fi
    printf '%s=%s' "$k" "$v"
}
# _manifest_dirs -- where a profile NAME is looked for: the user's own first.
_manifest_dirs () {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/provost/manifests" "$PROVOST_ROOT/extract/manifests"
}
# _manifest_profile [SPEC] -- the path of the profile to check against, and
# vets it. SPEC is a NAME (default, proposal, or one of the user's own) or a
# path; empty means PROVOST_MANIFEST_PROFILE, else the store's own
# manifest-profile.tsv, else 'default'.
_manifest_profile () {
    local spec="${1:-${PROVOST_MANIFEST_PROFILE:-}}" d p=""
    if [[ -z "$spec" ]]; then
        if [[ -f "$PROVOST_WORKSPACE/manifest-profile.tsv" ]]; then spec="$PROVOST_WORKSPACE/manifest-profile.tsv"
        else spec=default; fi
    fi
    if [[ "$spec" == */* || "$spec" == *.tsv ]]; then
        [[ -f "$spec" ]] || die "manifest profile not found: $spec"
        p="$(_abspath "$spec")"
    else
        _valid_name "$spec" || usage_die "invalid manifest profile name '$spec' (a NAME, or a path to a .tsv)."
        while IFS= read -r d; do
            if [[ -f "$d/$spec.tsv" ]]; then p="$d/$spec.tsv"; break; fi
        done < <(_manifest_dirs)
        [[ -n "$p" ]] || die "no manifest profile '$spec' (looked in: $(_manifest_dirs | paste -sd ' ' -))."
    fi
    local bad
    bad="$(awk -F'\t' '/^#/ || /^[ \t]*$/ { next }
        { n++ }
        NF < 3 || $1 !~ /^[A-Za-z_][A-Za-z0-9_.-]*$/ || ($2 != "run" && $2 != "post") || ($3 != "yes" && $3 != "no") { print FNR; exit }
        END { if (!n) print "0" }' "$p")"
    if [[ "$bad" == 0 ]]; then die "manifest profile $p names no keys."; fi
    [[ -z "$bad" ]] || die "manifest profile $p, line $bad: want KEY<TAB>run|post<TAB>yes|no<TAB>description."
    printf '%s\n' "$p"
}
# _manifest_missing PROFILE PHASE [FILE...] -- the required keys the '#%'
# FILEs lack (or hold empty), one a line, in the profile's order. PHASE run
# checks the run-time keys; all adds the post-run ones (reviewer, ...).
_manifest_missing () {
    local prof="$1" phase="$2"; shift 2
    local -a fs=()
    local f
    for f in "$@"; do [[ -f "$f" ]] && fs+=("$f"); done
    PROF="$prof" PH="$phase" awk -F'\t' '
        BEGIN { while ((getline l < ENVIRON["PROF"]) > 0) {
                    if (l ~ /^#/ || l ~ /^[ \t]*$/) continue
                    split(l, c, "\t")
                    if (c[3] == "yes" && (ENVIRON["PH"] == "all" || c[2] == "run")) R[++n] = c[1]
                } }
        { V[$1] = $2 }
        END { for (i = 1; i <= n; i++) if (!(R[i] in V) || V[R[i]] ~ /^[ \t]*$/) print R[i] }' \
        < <(_prologue_kv ${fs[@]+"${fs[@]}"})
}
# _manifest_lines FILE -- a --manifest FILE (KEY=VALUE a line; the value is
# the rest of the line, spaces and all; blank and '#' lines skipped) as '#%'
# prologue lines, one key each. Dies on a line that is not KEY=VALUE.
_manifest_lines () {
    local f="$1" line k v n=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        n=$((n + 1)); line="${line%$'\r'}"
        [[ "$line" =~ ^[[:blank:]]*$ || "$line" =~ ^[[:blank:]]*# ]] && continue
        line="${line#"${line%%[![:blank:]]*}"}"
        k="${line%%=*}"; v="${line#*=}"
        [[ "$line" == *=* && "$k" =~ $_MKEY_RE ]] \
            || die "$f, line $n: want KEY=VALUE (a key is letters, digits, '_', '.', '-'), got: $line"
        printf '#%% %s\n' "$(_prologue_word "$k" "$v")"
    done < "$f"
}
# _manifest_capture_setup -- vet the capture options --manifest FILE,
# --manifest-profile and --strict-manifest before anything runs: the manifest
# lines go to _O_MANIFEST_TEXT, and _O_MPROF_PATH is the profile to check
# against ('' = no check was asked for).
_manifest_capture_setup () {
    _O_MANIFEST_TEXT=""; _O_MPROF_PATH=""
    if [[ -n "$_O_MANIFEST" ]]; then
        [[ -f "$_O_MANIFEST" ]] || die "no such manifest file: $_O_MANIFEST"
        _O_MANIFEST_TEXT="$(_manifest_lines "$_O_MANIFEST")" || exit 1
    fi
    if [[ -n "$_O_MANIFEST" || -n "$_O_MPROFILE" || -n "${PROVOST_MANIFEST_PROFILE:-}" || "$PROVOST_MANIFEST_STRICT" == 1 ]]; then
        _O_MPROF_PATH="$(_manifest_profile "$_O_MPROFILE")" || exit 1
    fi
    _env_capture_setup
    return 0
}
# _manifest_apply IN LABEL -- prepend the --manifest lines to the input IN,
# then check its prologue against the profile. A missing required key is a
# warning, or with --strict-manifest an error: return 1, and the input is
# not to be filed.
_manifest_apply () {
    local in="$1" label="$2" missing env=""
    # --env's lines go first, then --manifest's (scrubbed like the input,
    # under --redact), then the input's own prologue; an --env key either of
    # the others sets is left out.
    [[ -z "$_O_ENV_TEXT" ]] || env="$(_env_unset_lines "$in")"
    if [[ -n "$_O_MANIFEST_TEXT" || -n "$env" ]]; then
        : > "$in.mlines"
        [[ -z "$_O_MANIFEST_TEXT" ]] || printf '%s\n' "$_O_MANIFEST_TEXT" > "$in.mlines"
        if [[ -s "$in.mlines" && "$PROVOST_REDACT" == 1 ]]; then _scrub "$in.mlines" "$in.redacted"; fi
        { [[ -z "$env" ]] || printf '%s\n' "$env"
          cat -- "$in.mlines"
          cat -- "$in"; } > "$in.manifest" && mv -- "$in.manifest" "$in"
        rm -f -- "$in.mlines"
    fi
    [[ -n "$_O_MPROF_PATH" ]] || return 0
    awk '!/^#%/ { exit } { print }' "$in" > "$in.prologue"
    missing="$(_manifest_missing "$_O_MPROF_PATH" run "$in.prologue" | paste -sd , - | sed 's/,/, /g')"
    rm -f -- "$in.prologue"
    [[ -n "$missing" ]] || return 0
    local prof; prof="$(basename -- "$_O_MPROF_PATH" .tsv)"
    if [[ "$PROVOST_MANIFEST_STRICT" == 1 ]]; then
        warn "$label: the run manifest (profile $prof) lacks required key(s): $missing -- not captured (--strict-manifest)."
        return 1
    fi
    warn "$label: the run manifest (profile $prof) lacks required key(s): $missing -- filed anyway; 'provost annotate ID KEY=VALUE' adds one later."
    return 0
}

# ---------------------------------------------------------------------------
# ENVIRONMENT CAPTURE (PV-028). --env (PROVOST_ENV=1) adds where a capture was
# taken to its '#%' prologue, as env.* keys: the host, kernel, architecture
# and OS release, the loaded environment modules (Lmod or Environment
# Modules: $LOADEDMODULES), the user, and the Slurm job, node list, cluster
# and partition inside a Slurm job. Variables come only from the allow-list
# PROVOST_ENV_VARS (glob patterns), each as env.var.NAME, never all of them;
# one whose name or value looks like a secret (extract/secrets.tsv) is not
# recorded even when allow-listed, and its name goes to env.withheld.
# --env=modules (PROVOST_ENV=modules) adds the kernel modules (lsmod) as
# env.kernel.modules. A run-manifest profile can claim a reading for a key of
# its own (its 'env' column: default.tsv's sched.job is the Slurm job id), and
# a key the --manifest FILE or the input's own prologue sets is theirs.
# Everything is read once, when the options are checked, so every input of a
# batch carries the same. Nothing here runs without --env.
# ---------------------------------------------------------------------------
# The readings, in the order they are written.
_ENV_READINGS="host kernel arch os modules user slurm.job slurm.nodes slurm.cluster slurm.partition kernel.modules"
_SR_KIND=(); _SR_FIELD=(); _SR_CASE=(); _SR_RE=()

# _env_os -- the OS release: "Ubuntu 24.04.1 LTS" (os-release's PRETTY_NAME,
# else NAME and VERSION_ID), "macOS 14.5" (sw_vers); nothing when neither.
_env_os () {
    local f k v name="" ver="" pretty=""
    if [[ "$(uname -s 2>/dev/null || true)" == Darwin ]] && command -v sw_vers >/dev/null 2>&1; then
        name="$(sw_vers -productName 2>/dev/null || true)"; ver="$(sw_vers -productVersion 2>/dev/null || true)"
        printf '%s' "${name:-macOS}${ver:+ $ver}"
        return 0
    fi
    for f in /etc/os-release /usr/lib/os-release; do
        [[ -r "$f" ]] || continue
        while IFS='=' read -r k v || [[ -n "$k" ]]; do
            v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
            case "$k" in PRETTY_NAME) pretty="$v" ;; NAME) name="$v" ;; VERSION_ID) ver="$v" ;; esac
        done < "$f"
        if [[ -n "$pretty" ]]; then printf '%s' "$pretty"; else printf '%s' "$name${ver:+ $ver}"; fi
        return 0
    done
    return 0
}

# _env_kmods -- the loaded kernel modules, sorted, comma-separated: lsmod's
# first column, else /proc/modules'; nothing when neither is there (macOS).
_env_kmods () {
    {
        if command -v lsmod >/dev/null 2>&1; then lsmod 2>/dev/null | awk 'NR > 1 && $1 != "" { print $1 }'
        elif [[ -r /proc/modules ]]; then awk '$1 != "" { print $1 }' /proc/modules
        fi
    } | LC_ALL=C sort -u | paste -sd , - || true
}

# _env_secret_rules -- load extract/secrets.tsv into the _SR_* arrays (once).
_env_secret_rules () {
    (( ${#_SR_RE[@]} == 0 )) || return 0
    local f="$PROVOST_ROOT/extract/secrets.tsv" kind field cs re n=0
    [[ -r "$f" ]] || die "cannot read $f -- the secret patterns --env checks every variable against; nothing was captured."
    while IFS=$'\t' read -r kind field cs re || [[ -n "$kind" ]]; do
        n=$((n + 1))
        [[ -z "$kind" || "$kind" == '#'* ]] && continue
        [[ ( "$field" == name || "$field" == value ) && ( "$cs" == i || "$cs" == - ) && -n "$re" ]] \
            || die "$f, line $n: want KIND<TAB>name|value<TAB>i|-<TAB>PATTERN; nothing was captured."
        _SR_KIND+=("$kind"); _SR_FIELD+=("$field"); _SR_CASE+=("$cs"); _SR_RE+=("$re")
    done < "$f"
    (( ${#_SR_RE[@]} > 0 )) || die "$f holds no patterns; nothing was captured."
}

# _env_secret_kind NAME VALUE -- succeeds, printing "name (KIND)" or
# "value (KIND)", when the variable's name or value matches a secret pattern.
_env_secret_kind () {
    local up="${1^^}" v="$2" i hit=""
    for (( i = 0; i < ${#_SR_RE[@]}; i++ )); do
        if [[ "${_SR_FIELD[i]}" == name ]]; then
            if [[ "$up" =~ ${_SR_RE[i]} ]]; then hit="name (${_SR_KIND[i]})"; fi
        else
            [[ "${_SR_CASE[i]}" != i ]] || shopt -s nocasematch
            if [[ "$v" =~ ${_SR_RE[i]} ]]; then hit="value (${_SR_KIND[i]})"; fi
            shopt -u nocasematch
        fi
        if [[ -n "$hit" ]]; then printf '%s\n' "$hit"; return 0; fi
    done
    return 1
}

# _env_capture_setup -- with --env, the prologue lines it adds, one
# '#% key=value' a line, in _O_ENV_TEXT ('' without --env).
_env_capture_setup () {
    _O_ENV_TEXT=""
    [[ "$PROVOST_ENV" != 0 ]] || return 0
    local -A R=() claim=()
    local -a lines=() withheld=() pats=() names=()
    local k v key prof n p kind
    R[host]="${HOSTNAME:-}"; [[ -n "${R[host]}" ]] || R[host]="$(uname -n 2>/dev/null || true)"
    R[kernel]="$(uname -sr 2>/dev/null || true)"
    R[arch]="$(uname -m 2>/dev/null || true)"
    R[os]="$(_env_os)"
    R[modules]="${LOADEDMODULES:-}"
    R[user]="$(id -un 2>/dev/null || true)"; [[ -n "${R[user]}" ]] || R[user]="${USER:-${LOGNAME:-}}"
    R[slurm.job]="${SLURM_JOB_ID:-${SLURM_JOBID:-}}"
    R[slurm.nodes]="${SLURM_JOB_NODELIST:-${SLURM_NODELIST:-}}"
    R[slurm.cluster]="${SLURM_CLUSTER_NAME:-}"
    R[slurm.partition]="${SLURM_JOB_PARTITION:-}"
    if [[ "$PROVOST_ENV" == modules ]]; then
        R[kernel.modules]="$(_env_kmods)"
        [[ -n "${R[kernel.modules]}" ]] || warn "--env=modules: no kernel module list on this system (no lsmod or /proc/modules); env.kernel.modules not recorded."
    fi
    # The profile's claims (its 'env' column): reading -> the key(s) it fills.
    prof="${_O_MPROF_PATH:-}"
    [[ -n "$prof" ]] || prof="$(_manifest_profile "$_O_MPROFILE")" || exit 1
    while IFS=$'\t' read -r n key k; do
        if [[ " $_ENV_READINGS " == *" $k "* ]]; then claim[$k]="${claim[$k]:+${claim[$k]} }$key"
        else warn "manifest profile $prof, line $n: its env column names '$k', which --env does not read (one of: $_ENV_READINGS) -- ignored."; fi
    done < <(awk -F'\t' '/^#/ || /^[ \t]*$/ { next } NF >= 5 && $5 != "" && $5 != "-" { print FNR "\t" $1 "\t" $5 }' "$prof")
    for k in $_ENV_READINGS; do
        v="${R[$k]:-}"; [[ -n "$v" ]] || continue
        v="${v//[$'\n\r\t']/ }"
        if [[ -n "${claim[$k]:-}" ]]; then
            for key in ${claim[$k]}; do lines+=("#% $(_prologue_word "$key" "$v")"); done
        else
            lines+=("#% $(_prologue_word "env.$k" "$v")")
        fi
    done
    # The allow-listed variables (exported ones: what a command run here sees).
    read -ra pats <<< "${PROVOST_ENV_VARS//,/ }"
    if (( ${#pats[@]} > 0 )); then
        _env_secret_rules
        while IFS= read -r n; do
            for p in "${pats[@]}"; do
                # (unquoted on the right: a glob, as PROVOST_ENV_VARS means it)
                # shellcheck disable=SC2053
                if [[ "$n" == $p ]]; then names+=("$n"); break; fi
            done
        done < <(compgen -e | LC_ALL=C sort -u)
        for n in ${names[@]+"${names[@]}"}; do
            v="${!n-}"
            if kind="$(_env_secret_kind "$n" "$v")"; then
                withheld+=("$n")
                warn "--env: \$$n not recorded: its $kind looks like a secret."
                continue
            fi
            v="${v//[$'\n\r\t']/ }"
            lines+=("#% $(_prologue_word "env.var.$n" "$v")")
        done
    fi
    if (( ${#withheld[@]} > 0 )); then
        lines+=("#% env.withheld=$(IFS=,; printf '%s' "${withheld[*]}")")
    fi
    (( ${#lines[@]} == 0 )) || _O_ENV_TEXT="$(printf '%s\n' "${lines[@]}")"
    return 0
}

# _env_unset_lines IN -- the --env lines whose key neither the --manifest
# lines nor IN's own prologue sets (theirs are the values that count).
_env_unset_lines () {
    local in="$1"
    { [[ -z "$_O_MANIFEST_TEXT" ]] || printf '%s\n' "$_O_MANIFEST_TEXT"
      awk '!/^#%/ { exit } { print }' "$in"; } > "$in.given"
    _prologue_kv "$in.given" | cut -f1 > "$in.keys"
    printf '%s\n' "$_O_ENV_TEXT" > "$in.env"
    awk 'FILENAME == ARGV[1] { S[$0] = 1; next }
         { k = $0; sub(/^#% /, "", k); sub(/=.*/, "", k); if (!(k in S)) print }' "$in.keys" "$in.env"
    rm -f -- "$in.given" "$in.keys" "$in.env"
}

# Snapshot a controlled directory's contents as commit context: a manifest of
# path/size/mtime/sha for each file (excluding the .provost instance and .git).
_snapshot_context () {
    local dir="$1" ws="$2" f sz mt sha
    local mani="$ws/context/manifest.tsv"
    mkdir -p "$ws/context"
    {
        printf 'path\tsize\tmtime\tsha1\n'
        while IFS= read -r -d '' f; do
            sz="$(stat -c '%s' "$f" 2>/dev/null || echo 0)"
            mt="$(stat -c '%Y' "$f" 2>/dev/null || echo 0)"
            sha="(skipped)"
            if [[ "$sz" =~ ^[0-9]+$ ]] && (( sz <= 1048576 )) && command -v sha1sum >/dev/null 2>&1; then
                sha="$(sha1sum 2>/dev/null < "$f")" || sha="(unreadable)"
                sha="${sha%% *}"
            fi
            printf '%s\t%s\t%s\t%s\n' "$(_meta_safe "${f#"$dir"/}")" "$sz" "$mt" "$sha"
        done < <(find "$dir" -type f -not -path '*/.provost/*' -not -path '*/.git/*' -print0 2>/dev/null)
    } > "$mani.tmp"
    # sort the rows (header stays first) for a stable manifest
    { IFS= read -r f; printf '%s\n' "$f"; LC_ALL=C sort; } < "$mani.tmp" > "$mani"
    rm -f "$mani.tmp"
    local n=0; n=$(( $(wc -l < "$mani") - 1 ))
    printf '%s\n' "$n"
}

# RUN FILES — a capture in a controlled directory also commits the
# directory's files themselves: a commit of their own, tagged files-<id>, so
# any run's files can be listed, read, compared or written out again later
# ('provost files', 'provost diff'). It is built with a scratch index and the
# controlled directory as the work tree, so the store's own tree never holds
# a copy, and git stores a file that did not change between runs once. The
# directory's .gitignore is honoured; .provost and .git never go in; a file
# over PROVOST_FILES_MAX_SIZE bytes (0 = keep no files) is only listed in
# context/manifest.tsv. Each run's commit has the previous run's as its
# parent, so plain git shows the directory's history across runs
# (git log --stat files-c0007); a run whose files did not change is tagged on
# the previous commit rather than given an empty one. Called under the lock.
_snapshot_files () {
    local dir="$1" id="$2" git_dir idx spec tree parent ptree commit out f
    (( PROVOST_FILES_MAX_SIZE > 0 )) || return 0
    git_dir="$PROVOST_WORKSPACE/.git"
    idx="$git_dir/provost-files.index"; spec="$git_dir/provost-files.pathspec"
    rm -f "$idx" "$spec"
    {
        printf ':/\0:(top,exclude,literal).provost\0'
        while IFS= read -r -d '' f; do printf ':(top,exclude,literal)%s\0' "${f#./}"; done \
            < <(cd "$dir" && find . \( -path ./.provost -o -path ./.git \) -prune -o \
                    -type f -size +"${PROVOST_FILES_MAX_SIZE}"c -print0 2>/dev/null)
    } > "$spec"
    out="$(_GIT_INDEX="$idx" _git --work-tree="$dir" add -A \
            --pathspec-from-file="$spec" --pathspec-file-nul 2>&1)" \
        || { rm -f "$idx" "$spec"; printf 'git: %s\n' "$out" >&2; return 1; }
    tree="$(_GIT_INDEX="$idx" _git write-tree 2>/dev/null)" || { rm -f "$idx" "$spec"; return 1; }
    rm -f "$idx" "$spec"
    parent="$(_git for-each-ref --count=1 --sort=-v:refname --format='%(objectname)' 'refs/tags/files-c*' 2>/dev/null)"
    ptree=""; [[ -n "$parent" ]] && ptree="$(_git rev-parse -q --verify "$parent^{tree}" 2>/dev/null)"
    if [[ -n "$parent" && "$ptree" == "$tree" ]]; then
        commit="$parent"
    else
        commit="$(_git commit-tree "$tree" ${parent:+-p "$parent"} \
                    -m "files of $dir at capture $id" 2>/dev/null)" || return 1
    fi
    _git tag "files-$id" "$commit" >/dev/null 2>&1
}

# _quality_exempt ENGINE STRATEGY — true when the quality gate does not apply.
# Coverage and consistency judge GENERIC parses: a tool-specific (bespoke or
# plugin) parser normalises values, so its output legitimately shares few
# tokens with the input (22 correct corpus winners read under 40% coverage),
# and a strict grammar (json/yaml/xml/toml) validates the whole document
# itself. Only parsers under extract/strategies/{delimited,structured} are
# gated. An LLM template's blocks are exempt too: a template is written for
# the tool's layout and deliberately makes key/value tables whose value
# column mixes types (a type-consistency measure built for homogeneous
# tables reads 30-60% on them); _llm_file's own rules judge its blocks.
_quality_exempt () {
    local sdir; sdir="$(dirname "$1")/strategies"
    case "$2" in json|json-array|jsonl|yaml|xml|toml|har|llm-template) return 0 ;; esac
    [[ -f "$sdir/delimited/$2.sh" || -f "$sdir/structured/$2.sh" ]] && return 1
    return 0
}

# _multi_split FILE DIR — split the engine's --multi output into DIR/ds.N.meta
# (`strategy<TAB>confidence<TAB>coverage<TAB>consistency<TAB>lines`, the
# fields after `__DATASET__<TAB>N`) and DIR/ds.N.wide (that dataset's -f tsv).
_multi_split () {
    rm -f "$2"/ds.* 2>/dev/null || true
    DIR="$2" awk -F'\t' '
        /^__DATASET__/ { n = ($2 ~ /^[0-9]+$/) ? $2 : ""; if (n != "") printf "%s\t%s\t%s\t%s\t%s\n", $3, $4, $5, $6, $7 > (ENVIRON["DIR"] "/ds." n ".meta"); next }
        n != "" { print > (ENVIRON["DIR"] "/ds." n ".wide") }
    ' "$1" 2>/dev/null || true
}

# _tidy_cols FILE — a tidy dataset's column names, one per line, without the
# generated row index (`n`).
_tidy_cols () { head -n 1 "$1" | tr '\t' '\n' | awk 'NR == 1 && $0 == "n" { next } { print }'; }

# AUTO-MULTI (PROVOST_AUTO_MULTI, --auto-multi / --no-auto-multi). Called by
# _ingest when the quality gate would hold the single-winner parse for
# low coverage or low consistency. It runs the engine's --multi segmentation
# and files its datasets INSTEAD of holding the capture only when the split
# is clearly better:
#   1. it is a split: the engine's own choice is not the unsplit input, and
#      it yields at least two datasets;
#   2. every dataset passes the gate itself — confidence >= the threshold
#      and, for a generic parser, its own coverage and consistency (measured
#      by the engine against the dataset's own blocks) >= the gate's. A
#      TOOL-SPECIFIC parser (bespoke or plugin) reading a part must keep the
#      gate's coverage of that part's lines too (PV-013): exempt on a whole
#      input, it is an accident on a fragment of some other tool's output
#      (round 4's 048: git-annex-list read a pytest rule line as flags /
#      path at 50%). The strict grammars (json, yaml, xml, toml, har) stay
#      exempt: they validate what they read;
#   3. together they cover MATERIALLY more of the input: the whole input's
#      coverage by all the datasets is at least the gate's minimum and
#      _AM_GAIN (10) points above the single parse's;
#   4. no dataset is a POSITIONAL table — 2+ rows under nothing but generated
#      A/B/C… column names — that shows a header was lost or rows shredded:
#      a column of nothing but box chrome (| || +), cells mostly empty (prose
#      split word-per-column, ragged rows), or a header-like line (2+ words,
#      no digit) right above the part in the input, past blank and rule
#      lines: a header the split cut off. Filing values under positional
#      names there is the misplacement the gate exists to stop. A headerless
#      table with none of these is filed: where the input supplies no header,
#      positional names are the honest answer (the benchmark's rating rule 4;
#      PV-013, round 4's 003, 029 and 137);
#   5. the parser the gate just rejected does not come back unmeasured: a
#      dataset (3+ lines) read by the same strategy must have a judged
#      column-type consistency (a one-record flatten is not judged);
#   6. it is not shattered into trivial fragments: datasets of 3+ lines or
#      3+ rows hold at least half of it (a banner, a footer or a prompt may
#      be a one-line dataset of its own; most of the input may not). A part's
#      size is its input lines or its table's rows, whichever is more: one
#      line can hold many records (a ServerQuery client list is one line of
#      '|'-separated clients), and is no fragment (_am_frag_add).
# Otherwise it returns 1 with the reason in am_note, and the capture is held
# exactly as before. Works on _ingest's locals (dynamic scope): reads engine,
# eargs, body, tmp, threshold, name, strategy, cov; fills ds_* and am_*.
_AM_GAIN=10
_LLM_CATCHALL_SLACK=20   # _llm_file: points a template may trail a catch-all parse by
_AM_FRAG_MIN=3   # a part of fewer lines AND fewer rows than this is a fragment

# _am_frag_add LINES ROWS — add one part to the fragments rule's totals (the
# caller's tot / sub): its size is its non-blank input lines or the rows of
# its table, whichever is more, and it counts as substantial (sub) at
# _AM_FRAG_MIN or more.
_am_frag_add () {
    local n="$1"
    [[ "$2" =~ ^[0-9]{1,9}$ ]] && (( $2 > n )) && n="$2"
    tot=$(( tot + n )); (( n >= _AM_FRAG_MIN )) && sub=$(( sub + n ))
    return 0
}

# _am_positional_why TSV TEXT INPUT — rule 4's evidence that a positional
# table (TSV, tidy) lost its header or shredded its rows: prints why, or
# nothing when the part reads as a genuinely headerless table. TEXT is the
# part's own input lines (the engine's PROVOST_MULTI_TEXT_DIR) and INPUT the
# whole input; without TEXT nothing places the part, so it is declined as
# before.
_am_positional_why () {
    local tsv="$1" text="$2" inp="$3" first
    awk -F'\t' '
        NR == 1 { c0 = ($1 == "n") ? 2 : 1; nc = NF - c0 + 1; next }
        $0 == "" { next }
        { rows++
          for (j = c0; j <= NF; j++) {
              v = $j; gsub(/^[ \t]+|[ \t]+$/, "", v)
              if (v != "") { fill++; if (v !~ /^[|+]+$/) word[j] = 1 } else empty[j] = 1
          } }
        END {
            if (rows == 0 || nc < 1) exit
            for (j = c0; j < c0 + nc; j++) if (!(j in word) && !(j in empty)) { print "box chrome read as cells"; exit }
            if (fill * 3 < rows * nc * 2) print "its cells are mostly empty (prose split into words)"
        }' "$tsv"
    [[ -n "$text" && -s "$text" ]] || { printf 'its place in the input is unknown\n'; return 0; }
    first="$(awk 'NF { print; exit }' "$text")"
    [[ -n "$first" ]] || return 0
    FIRST="$first" awk '
        function rule(s) { return s ~ /^[ \t]*$/ || s ~ /^[ \t]*[-=+_|:*~.#]+([ \t]+[-=+_|:*~.#]+)*[ \t]*$/ }
        function header(s,   n, k, t, w) {
            n = split(s, t, /[ \t]+/); w = 0
            for (k = 1; k <= n; k++) {
                if (t[k] == "") continue
                if (t[k] ~ /[0-9]/) return 0
                if (t[k] ~ /[A-Za-z]/) w++
            }
            return w >= 2
        }
        { line[NR] = $0 }
        $0 == ENVIRON["FIRST"] {
            for (j = NR - 1; j >= 1 && rule(line[j]); j--) ;
            if (j >= 1 && header(line[j])) { print "a header-like line sits right above it (a header the split cut off)"; exit }
        }' "$inp"
}

# _am_part_check I WIDE TSV [TEXT] — the per-part checks of _auto_multi (rules
# 2, 4 and 5) on part I's dstrat / dconf / dcov / dcons / dlines (the caller's
# locals); melts WIDE into TSV. TEXT, the part's own input lines, lets rule 4
# file a genuinely headerless table (see _am_positional_why); without it every
# positional table is declined. Sets _AMP_NOTE (empty = the part passes) and
# _AMP_ROWS.
_am_part_check () {
    local i="$1" wide="$2" tsv="$3" text="${4:-}" ncols nsyn why
    _AMP_NOTE=""; _AMP_ROWS=0
    if [[ -z "$dstrat" ]]; then _AMP_NOTE="part $i has no strategy"; return 0; fi
    if (( dconf < threshold )); then
        _AMP_NOTE="part $i ($dstrat) is low-confidence ($dconf<$threshold)"; return 0
    fi
    if _quality_exempt "$engine" "$dstrat"; then
        case "$dstrat" in
            json|json-array|jsonl|yaml|xml|toml|har|llm-template) ;;
            *)  if [[ "$dcov" != - ]] && (( PROVOST_MIN_COVERAGE > 0 && dcov < PROVOST_MIN_COVERAGE )); then
                    _AMP_NOTE="part $i ($dstrat, a tool-specific parser) keeps $dcov% of its lines"; return 0
                fi ;;
        esac
    else
        if [[ "$dcov" != - ]] && (( PROVOST_MIN_COVERAGE > 0 && dcov < PROVOST_MIN_COVERAGE )); then
            _AMP_NOTE="part $i ($dstrat) keeps $dcov% of its lines"; return 0
        fi
        if [[ "$dcons" != - ]] && (( PROVOST_MIN_CONSISTENCY > 0 && dcons < PROVOST_MIN_CONSISTENCY )); then
            _AMP_NOTE="part $i ($dstrat) columns are $dcons% type-consistent"; return 0
        fi
    fi
    if [[ "$dstrat" == "$strategy" && "$dcons" == - ]] && (( dlines >= _AM_FRAG_MIN )); then
        _AMP_NOTE="part $i is read by the rejected parser ($dstrat) and cannot be judged"; return 0
    fi
    _core_melt_tidy_file "$wide" "" "$tsv.renamed" > "$tsv"
    _AMP_ROWS=$(awk 'NR > 1 && $0 != "" { r++ } END { print r + 0 }' "$tsv")
    read -r ncols nsyn < <(_tidy_cols "$tsv" | awk '{ c++ } /^[A-Z][A-Z]?$/ { s++ } END { print c + 0, s + 0 }')
    if (( _AMP_ROWS >= 2 && ncols >= 2 && nsyn == ncols )); then
        why="$(_am_positional_why "$tsv" "$text" "$body" | head -n 1)"
        [[ -n "$why" ]] && _AMP_NOTE="part $i ($dstrat) is a table with positional columns only: $why"
    fi
    return 0
}

# _model_table INPUT ENGINE_WIDE ENGINE_META TAG — the layout model's table
# for INPUT (the explicit-only layout-model strategy, measured by the engine
# like any parser), arbitrating line by line with the engine's own parse of
# the same lines (ENGINE_WIDE: its -f tsv output; ENGINE_META: strategy,
# confidence, coverage, consistency, tab-separated). Sets _MT_OUT (the -f tsv
# output) and _MT_C / _MT_V / _MT_T (confidence, coverage, consistency; empty
# when unmeasured). Returns 1 when the model produced nothing.
_model_table () {
    local inp="$1" ew="$2" em="$3" tag="$4" lmeta="$tmp/lm.$4.meta" ls=""
    _MT_OUT="$tmp/lm.$tag.tsv"; _MT_C=""; _MT_V=""; _MT_T=""
    PROVOST_LM_ENGINE_WIDE="$ew" PROVOST_LM_ENGINE_META="$em" \
        _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
        ${eargs[@]+"${eargs[@]}"} -s layout-model --emit-meta -f tsv --max-strategies 1 "$inp" \
        >"$_MT_OUT" 2>"$lmeta" || true
    IFS=$'\t' read -r ls _MT_C _MT_V _MT_T < <(awk -F'\t' \
        '/^__EXTRACT_META__/ { s = $2; c = $3; v = $4; t = $5 } END { printf "%s\t%s\t%s\t%s\n", s, c, v, t }' "$lmeta" 2>/dev/null) || true
    [[ "$ls" == layout-model && -s "$_MT_OUT" ]] && grep -q . "$_MT_OUT" || return 1
    [[ "$_MT_C" =~ ^[0-9]{1,9}$ ]] || _MT_C=0
    [[ "$_MT_V" =~ ^[0-9]{1,3}$ ]] || _MT_V=""
    [[ "$_MT_T" =~ ^[0-9]{1,3}$ ]] || _MT_T=""
    return 0
}

_auto_multi () {
    local mo="$tmp/am.txt" mm="$tmp/am.meta" kind="" n="" mcov="" mlines="" textdir="$tmp/amtext"
    # Each part's own input lines: rule 4 places a positional part by them,
    # and the layout model reads a part from them.
    rm -rf "$textdir"; mkdir -p "$textdir"
    PROVOST_MULTI_TEXT_DIR="$textdir" _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
        ${eargs[@]+"${eargs[@]}"} --multi --emit-meta -f tsv --max-strategies 1 "$body" \
        >"$mo" 2>"$mm" || true
    IFS=$'\t' read -r kind n mcov mlines < <(awk -F'\t' \
        '/^__MULTI_META__/ { k = $2; n = $3; c = $4; l = $5 } END { printf "%s\t%s\t%s\t%s\n", k, n, c, l }' "$mm" 2>/dev/null) || true
    [[ "$n" =~ ^[0-9]{1,6}$ ]] || n=0
    if [[ "$kind" != split && "$kind" != strict && "$kind" != hdr ]]; then
        am_note="the unsplit input is still the engine's best reading"; return 1
    fi
    (( n >= 2 )) || { am_note="segmenting yields one dataset"; return 1; }
    [[ "$mcov" =~ ^[0-9]{1,3}$ ]] || { am_note="the segmented coverage is not measured"; return 1; }
    local need=$(( ${cov:-0} + _AM_GAIN ))
    (( need < PROVOST_MIN_COVERAGE )) && need=$PROVOST_MIN_COVERAGE
    if (( need > 100 )); then
        # The single parse already keeps (nearly) every line — it was held for
        # its column types — so no split can keep materially more.
        am_note="the single parse already keeps $cov% of the lines"; return 1
    fi
    if (( mcov < need )); then
        am_note="$n parts keep $mcov% of the lines, <$need%"; return 1
    fi

    _multi_split "$mo" "$tmp"
    local i dstrat dconf dcov dcons dlines nrows ncols nsyn tot=0 sub=0
    local -a an=() as=() ac=() af=() acv=() acs=() arows=()
    for (( i = 1; i <= n; i++ )); do
        if [[ ! -f "$tmp/ds.$i.meta" || ! -s "$tmp/ds.$i.wide" ]]; then
            am_note="part $i is empty"; return 1
        fi
        dstrat=""; dconf=""; dcov=""; dcons=""; dlines=""
        IFS=$'\t' read -r dstrat dconf dcov dcons dlines < "$tmp/ds.$i.meta" || true
        [[ "$dconf" =~ ^[0-9]{1,9}$ ]] || dconf=0
        [[ "$dcov" =~ ^[0-9]{1,3}$ ]] || dcov="-"
        [[ "$dcons" =~ ^[0-9]{1,3}$ ]] || dcons="-"
        [[ "$dlines" =~ ^[0-9]{1,9}$ ]] || dlines=0
        _am_part_check "$i" "$tmp/ds.$i.wide" "$tmp/ds.$i.tsv" "$textdir/ds.$i.txt"
        # LAYOUT MODEL, per part: a part the gate rejects is read again by
        # the model on just that part's lines (its text comes from the engine,
        # PROVOST_MULTI_TEXT_DIR), arbitrating with the engine's own parse of
        # the part line by line. The model's table replaces the part only if
        # it passes the very same checks; otherwise the split is declined as
        # before.
        if [[ -n "$_AMP_NOTE" && "$PROVOST_MODEL" == 1 && -s "$tmp/amtext/ds.$i.txt" ]] &&
           _model_table "$tmp/amtext/ds.$i.txt" "$tmp/ds.$i.wide" "$dstrat"$'\t'"$dconf"$'\t'"$dcov"$'\t'"$dcons" "part$i"; then
            local _pnote="$_AMP_NOTE" _ostrat="$dstrat"
            dstrat=layout-model; dconf="$_MT_C"; dcov="$_MT_V"; dcons="${_MT_T:--}"
            _am_part_check "$i" "$_MT_OUT" "$tmp/ds.$i.lm.tsv" "$textdir/ds.$i.txt"
            if [[ -z "$_AMP_NOTE" ]]; then
                cp "$_MT_OUT" "$tmp/ds.$i.wide"; mv "$tmp/ds.$i.lm.tsv" "$tmp/ds.$i.tsv"
                am_model=$((am_model + 1))
            else
                dstrat="$_ostrat"; _AMP_NOTE="$_pnote; the layout model's reading of it fails too"
            fi
        fi
        [[ -z "$_AMP_NOTE" ]] || { am_note="$_AMP_NOTE"; return 1; }
        nrows="$_AMP_ROWS"
        _am_frag_add "$dlines" "$_AMP_ROWS"
        if _valid_name "$dstrat"; then :; else dstrat="$(_sanitize_name "$dstrat")"; dstrat="${dstrat:-dataset}"; fi
        an+=("${name:+$name.}$dstrat"); as+=("$dstrat"); ac+=("$dconf"); af+=("$tmp/ds.$i.tsv")
        acv+=("$dcov"); acs+=("$dcons"); arows+=("$nrows")
    done
    if (( sub == 0 || sub * 2 < tot )); then
        am_note="the parts are fragments ($sub of $tot lines or rows in parts of $_AM_FRAG_MIN+)"; return 1
    fi

    # Naming. Every part is named as --multi names it: NAME.strategy for
    # 'run' / --name, its strategy for a nameless inject (which is how a
    # nameless inject is always named — after the parser that read it). With
    # a NAME, the part that reads the same columns as the single parse (the
    # store's own reconcile overlap, PROVOST_RECONCILE_OVERLAP) CONTINUES
    # dataset NAME, where that parse would have been filed: a command whose
    # output passes the gate one day and segments the next keeps its rows in
    # one dataset. When several parts qualify, the one with the most rows.
    if [[ -n "$name" && -s "$tmp/wide.tsv" ]]; then
        local best=-1 bi=-1 ov hs hd
        _core_melt_tidy_file "$tmp/wide.tsv" > "$tmp/single.tsv"
        hs="$(_tidy_cols "$tmp/single.tsv" | paste -sd '\t' -)"
        for (( i = 0; i < ${#af[@]}; i++ )); do
            hd="$(_tidy_cols "${af[i]}" | paste -sd '\t' -)"
            ov="$(printf '%s\n%s\n' "$hs" "$hd" | _col_overlap)"
            [[ "$ov" =~ ^[0-9]+$ ]] || ov=0
            if (( ov >= PROVOST_RECONCILE_OVERLAP && arows[i] > best )); then best=${arows[i]}; bi=$i; fi
        done
        (( bi >= 0 )) && an[bi]="$name"
    fi
    ds_name=("${an[@]}"); ds_strategy=("${as[@]}"); ds_conf=("${ac[@]}"); ds_file=("${af[@]}")
    ds_cov=("${acv[@]}"); ds_cons=("${acs[@]}")
    am_cov="$mcov"; am_kind="$kind"
    return 0
}

# LAYOUT MODEL (PROVOST_MODEL, --model / --no-model). Called by _ingest when
# the quality gate would still hold the single parse (after AUTO-MULTI). It
# runs the explicit-only layout-model strategy and adopts its table INSTEAD of
# holding the capture only when the engine's own measures of that table pass
# the gate — coverage >= PROVOST_MIN_COVERAGE, consistency (when judged) >=
# PROVOST_MIN_CONSISTENCY — and it keeps at least as many lines as the held
# parse. Otherwise it returns 1 with the reason in lm_note. Works on
# _ingest's locals (dynamic scope): reads engine, eargs, body, tmp, cov;
# on success replaces wide.tsv and sets strategy, conf, cov, tcons.
_layout_model () {
    local lv lt
    if ! _model_table "$body" "$tmp/wide.tsv" "$strategy"$'\t'"$conf"$'\t'"${cov:--}"$'\t'"${tcons:--}" whole; then
        lm_note="it found nothing to file (it needs python3 and declines inputs over 600 lines, and mixed reports)"; return 1
    fi
    lv="$_MT_V"; lt="$_MT_T"
    [[ -n "$lv" ]] || { lm_note="its line coverage is not measured"; return 1; }
    if (( PROVOST_MIN_COVERAGE > 0 && lv < PROVOST_MIN_COVERAGE )); then
        lm_note="its table keeps $lv% of the lines, <$PROVOST_MIN_COVERAGE%"; return 1
    fi
    if [[ -n "$lt" ]] && (( PROVOST_MIN_CONSISTENCY > 0 && lt < PROVOST_MIN_CONSISTENCY )); then
        lm_note="its columns are $lt% type-consistent, <$PROVOST_MIN_CONSISTENCY%"; return 1
    fi
    if [[ -n "$cov" ]] && (( lv < cov )); then
        lm_note="its table keeps $lv% of the lines, fewer than the held parse ($cov%)"; return 1
    fi
    cp "$_MT_OUT" "$tmp/wide.tsv"
    strategy=layout-model; conf="$_MT_C"; cov="$lv"; tcons="$lt"
    return 0
}

# LAYOUT MODEL, segmenting (after _layout_model declines a whole capture):
# the model cuts a mixed report into uniform runs — a key/value block, a
# table, a list — from its own line roles (layout_model.py --segments), and
# each run's records, made from the whole document's labels, are measured by
# the engine like any parse (PROVOST_LM_RECORDS). The runs are filed as the
# capture's datasets INSTEAD of holding it under AUTO-MULTI's rules: every
# run passes the per-part checks (_am_part_check), the runs hold at least
# _AM_GAIN points more of the input than the held parse (and the gate's
# minimum), and they are not fragments. Otherwise 1, the reason in mm_note.
# Works on _ingest's locals like _auto_multi; fills ds_* and am_cov/am_kind.
_model_multi () {
    local segd="$tmp/lmseg" i f n=0 dstrat dconf dcov dcons dlines tot=0 sub=0 covl=0 alll jcov need
    command -v "${PROVOST_PYTHON:-python3}" >/dev/null 2>&1 || { mm_note="python3 is not installed"; return 1; }
    rm -rf "$segd"; mkdir -p "$segd"
    "${PROVOST_PYTHON:-python3}" "$PROVOST_ROOT/extract/model/layout_model.py" "$body" --segments "$segd" >/dev/null 2>&1 \
        || { mm_note="it finds no two sections it can read"; return 1; }
    while [[ -f "$segd/seg.$((n + 1)).txt" ]]; do n=$((n + 1)); done
    local -a an=() as=() ac=() af=() acv=() acs=()
    for (( i = 1; i <= n; i++ )); do
        f="$segd/seg.$i.txt"
        PROVOST_LM_RECORDS="$segd/seg.$i.rec" _model_table "$f" "" "" "seg$i" \
            || { mm_note="its section $i yields nothing"; return 1; }
        dstrat=layout-model; dconf="$_MT_C"; dcov="${_MT_V:--}"; dcons="${_MT_T:--}"
        dlines=$(grep -c '[^[:space:]]' "$f" || true)
        _am_part_check "$i" "$_MT_OUT" "$segd/seg.$i.tsv"
        [[ -z "$_AMP_NOTE" ]] || { mm_note="${_AMP_NOTE/#part/section}"; return 1; }
        _am_frag_add "$dlines" "$_AMP_ROWS"
        [[ "$dcov" == - ]] || covl=$(( covl + dcov * dlines ))
        an+=("${name:+$name.}layout-model"); as+=(layout-model); ac+=("$dconf"); af+=("$segd/seg.$i.tsv")
        acv+=("$dcov"); acs+=("$dcons")
    done
    if (( sub == 0 || sub * 2 < tot )); then
        mm_note="its sections are fragments ($sub of $tot lines or rows in sections of $_AM_FRAG_MIN+)"; return 1
    fi
    alll=$(grep -c '[^[:space:]]' "$body" || true)
    (( alll > 0 )) || { mm_note="the input is empty"; return 1; }
    jcov=$(( covl / alll ))
    need=$(( ${cov:-0} + _AM_GAIN ))
    (( need < PROVOST_MIN_COVERAGE )) && need=$PROVOST_MIN_COVERAGE
    if (( need > 100 )); then mm_note="the held parse already keeps $cov% of the lines"; return 1; fi
    if (( jcov < need )); then mm_note="its $n sections keep $jcov% of the lines, <$need%"; return 1; fi
    ds_name=("${an[@]}"); ds_strategy=("${as[@]}"); ds_conf=("${ac[@]}"); ds_file=("${af[@]}")
    ds_cov=("${acv[@]}"); ds_cons=("${acs[@]}")
    am_cov="$jcov"; am_kind=layout-model
    return 0
}

# _llm_table INPUT TAG — the engine's measure of records an LLM template made
# for INPUT (the explicit-only llm-template strategy emits PROVOST_LLM_RECORDS,
# set by the caller). Sets _MT_OUT / _MT_C / _MT_V / _MT_T like _model_table.
_llm_table () {
    local inp="$1" tag="$2" lmeta="$tmp/llm.$2.meta" ls=""
    _MT_OUT="$tmp/llm.$tag.tsv"; _MT_C=""; _MT_V=""; _MT_T=""
    _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
        ${eargs[@]+"${eargs[@]}"} -s llm-template --emit-meta -f tsv --max-strategies 1 "$inp" \
        >"$_MT_OUT" 2>"$lmeta" || true
    IFS=$'\t' read -r ls _MT_C _MT_V _MT_T < <(awk -F'\t' \
        '/^__EXTRACT_META__/ { s = $2; c = $3; v = $4; t = $5 } END { printf "%s\t%s\t%s\t%s\n", s, c, v, t }' "$lmeta" 2>/dev/null) || true
    [[ "$ls" == llm-template && -s "$_MT_OUT" ]] && grep -q . "$_MT_OUT" || return 1
    [[ "$_MT_C" =~ ^[0-9]{1,9}$ ]] || _MT_C=0
    [[ "$_MT_V" =~ ^[0-9]{1,3}$ ]] || _MT_V=""
    [[ "$_MT_T" =~ ^[0-9]{1,3}$ ]] || _MT_T=""
    return 0
}

# _llm_file TEMPLATE — apply one LLM template to the capture and file what it
# yields under the gate's rules: each block the template finds is measured by
# the engine on that block's own lines and must pass the per-part checks
# (_am_part_check); the blocks are not fragments; and together they keep at
# least _AM_GAIN points more of the input than the held parse (and the gate's
# minimum), the lines the template marks as decoration not counted — as the
# SKIP AUDIT allows (template.py audit): a skipped line with no letter or
# digit, or one of a kind Claude has judged decoration. A skipped line that
# carries a word or a number and has not been judged counts as unread. One
# block replaces the held parse (wide.tsv); several are filed as the
# capture's datasets, named NAME.<block>. Otherwise 1, the reason in
# llm_note; llm_audit holds the counts (skipped decoration judged unjudged
# read unread).
_llm_file () {
    local t="$1" py="$PROVOST_ROOT/extract/llm/template.py" bd="$tmp/llmblk" out n=0 skipped=0 i f bname
    local dstrat dconf dcov dcons dlines tot=0 sub=0 covl=0 alll jcov need
    local _ab _ac a_deco=0 a_judged=0 a_unj=0 a_read=0 a_unread=0 _v
    llm_notes=""; llm_audit=""; rm -rf "$bd"
    out="$(python3 "$py" apply "$t" "$body" --out "$bd" 2>/dev/null)" \
        || { llm_note="it matches nothing in the input"; return 1; }
    IFS=$'\t' read -r _ab _ac skipped a_deco a_judged a_unj a_read a_unread <<< "$out" || true
    for _v in skipped a_deco a_judged a_unj a_read a_unread; do
        [[ "${!_v}" =~ ^[0-9]{1,9}$ ]] || printf -v "$_v" 0
    done
    llm_audit="$skipped $a_deco $a_judged $a_unj $a_read $a_unread"
    while [[ -f "$bd/blk.$((n + 1)).rec" ]]; do n=$((n + 1)); done
    (( n >= 1 )) || { llm_note="it matches nothing in the input"; return 1; }
    # a nameless capture's datasets are named after the template's tool
    local dsbase="$name"
    if [[ -z "$dsbase" ]]; then
        dsbase="$(head -n 1 "$bd/tool" 2>/dev/null)"; _valid_name "$dsbase" || dsbase=""
    fi
    local -a an=() as=() ac=() af=() acv=() acs=() aw=()
    for (( i = 1; i <= n; i++ )); do
        f="$bd/blk.$i.txt"; bname="$(head -n 1 "$bd/blk.$i.name" 2>/dev/null)"
        _valid_name "$bname" || bname="block$i"
        PROVOST_LLM_RECORDS="$bd/blk.$i.rec" _llm_table "$f" "blk$i" \
            || { llm_note="its block '$bname' yields nothing"; return 1; }
        # a block's lines are, by construction, the lines the template read
        # into its records (its text is written from them), so its coverage
        # is 100 and jcov below is the share of the input's data lines the
        # template read. The engine's token-recall measure is not used here:
        # it counts a value the template dropped on purpose (a broadcast
        # address, a trailing flag) as a missed line. Its type consistency
        # is recorded, not gated (see _quality_exempt); the shape checks
        # still apply.
        dstrat=llm-template; dconf="$_MT_C"; dcov=100; dcons="${_MT_T:--}"
        dlines=$(grep -c '[^[:space:]]' "$f" || true)
        _am_part_check "$i" "$_MT_OUT" "$bd/blk.$i.tsv"
        [[ -z "$_AMP_NOTE" ]] || { llm_note="${_AMP_NOTE/#part $i/block $bname}"; return 1; }
        _am_frag_add "$dlines" "$_AMP_ROWS"
        [[ "$dcov" == - ]] || covl=$(( covl + dcov * dlines ))
        an+=("${dsbase:+$dsbase.}$bname"); as+=(llm-template); ac+=("$dconf"); af+=("$bd/blk.$i.tsv")
        acv+=("$dcov"); acs+=("$dcons"); aw+=("$_MT_OUT")
    done
    if (( n > 1 )) && (( sub == 0 || sub * 2 < tot )); then
        llm_note="its blocks are fragments ($sub of $tot lines or rows in blocks of $_AM_FRAG_MIN+)"; return 1
    fi
    alll=$(grep -c '[^[:space:]]' "$body" || true)
    # the lines a template marks as decoration are not counted against it
    # when the skip audit allows: rules and box glyphs, and set-aside lines of
    # a kind Claude has judged decoration. None is lost: every skipped line
    # that carries a word or a number is filed in its NAME.notes (template.py
    # notes). A set-aside line not judged counts as unread (PV-008: a skip
    # pattern that swallowed a diff once read as 100%). Against a CATCH-ALL
    # parse the gate passed (text-lines, line-records: the engine's own
    # lossless readings, _FR_COV_CATCHALL) it may trail by
    # _LLM_CATCHALL_SLACK points rather than _AM_GAIN.
    local catchall=0
    case " $strategy " in *" text-lines "*|*" line-records "*) [[ "$llm_floor" == match ]] && catchall=1 ;; esac
    alll=$(( alll - a_deco - a_judged ))
    (( alll > 0 )) || { llm_note="it keeps none of the input's data lines"; return 1; }
    jcov=$(( covl / alll ))
    # against a held parse the template must gain _AM_GAIN points; against a
    # generic parse the gate passed (llm_floor=match) it may trail by that
    # much: it was written for this tool's layout, the heuristic was not, and
    # a title or prompt the heuristic counted as a row is decoration here
    if (( catchall )); then need=$(( ${cov:-0} - _LLM_CATCHALL_SLACK ))
    elif [[ "$llm_floor" == match ]]; then need=$(( ${cov:-0} - _AM_GAIN ))
    else need=$(( ${cov:-0} + _AM_GAIN )); fi
    (( need < PROVOST_MIN_COVERAGE )) && need=$PROVOST_MIN_COVERAGE
    (( need > 100 )) && need=100
    if (( jcov < need )); then
        llm_note="its $n block(s) keep $jcov% of the input's data lines, <$need%"; return 1
    fi
    [[ -s "$bd/notes.tsv" ]] && { llm_notes="$bd/notes.tsv"; llm_notes_base="$dsbase"; }
    if (( n == 1 )); then
        cp "${aw[0]}" "$tmp/wide.tsv"
        strategy=llm-template; conf="${ac[0]}"; cov="$jcov"; tcons="${acs[0]/#-/}"
        [[ -z "$name" && -n "$dsbase" ]] && name="$dsbase"
        llm_multi=0
    else
        ds_name=("${an[@]}"); ds_strategy=("${as[@]}"); ds_conf=("${ac[@]}"); ds_file=("${af[@]}")
        ds_cov=("${acv[@]}"); ds_cons=("${acs[@]}")
        am_cov="$jcov"; am_kind=llm-template; llm_multi=1
    fi
    return 0
}

# LLM TEMPLATES (PROVOST_LLM, --llm / --no-llm). Called by _ingest on a
# capture the quality gate would hold, and on a generic parse it passed. A
# template is a set of regular expressions per kind of line, or a boxed
# parser, that Claude wrote for one tool (extract/llm/). provost looks for one
# in the store (llm-templates/, committed with the captures: the tool's name,
# or any template whose `detect` pattern recognises the input), then in
# PROVOST_LLM_TEMPLATE_DIRS and among the templates shipped with provost, and
# files what it yields (_llm_file). With an API key, a stored template that
# meets a kind of line it has not met before is first sent back to Claude to
# be extended (repair), and when none fits Claude writes one from this
# capture — the steps that send the capture's text to the Anthropic API.
# After either, one more call reviews what the template makes of the capture
# (the judge, PROVOST_LLM_JUDGE; template.py review_template) and may revise
# it once; a revision that fails the gate falls back to the template as it
# was before the review (NEW.before). A new or extended template is kept
# only when what it yields passes the same rules. Every later capture of the
# tool is then parsed offline. With LEARN=0 Claude is never asked (only a
# stored template can fit). Otherwise 1, the reason in llm_note. On 0,
# llm_seen_how (learned, extended, checked or read) and llm_seen_tpl (the
# template file) say how, for the template's ledger (_llm_seen, written with
# the capture).
_llm_reviewed () { # NEW: file the template Claude wrote or extended; if the
    # judge's revision fails the gate, the template as it was before the
    # review. The review's line is in llm_rev (amended for a fallback).
    local t="$1" n0
    _llm_file "$t" && return 0
    [[ -f "$t.before" ]] || return 1
    n0="$llm_note"
    _llm_file "$t.before" || { llm_note="$n0"; return 1; }
    mv -f "$t.before" "$t"
    llm_rev="${llm_rev:+$llm_rev, }but the revision fails the gate ($n0), so the template as it was is kept"
    return 0
}
_llm_template () {
    local learn="${1:-1}" py="$PROVOST_ROOT/extract/llm/template.py" tdir="$PROVOST_WORKSPACE/llm-templates"
    local tool="$name" kf tpl="" found="" new="$tmp/llm-new.json" err prev out jflag=""
    [[ "$PROVOST_LLM_JUDGE" == 1 ]] || jflag="--no-judge"
    local llm_rev=""
    llm_seen_how=""; llm_seen_tpl=""
    command -v python3 >/dev/null 2>&1 || { llm_note="python3 is not installed"; return 1; }
    [[ -z "$tool" && -n "$cmd" ]] && { tool="${cmd%% *}"; tool="${tool##*/}"; }
    kf="$(python3 "$py" key "$body" --name "$tool" 2>/dev/null)" || { llm_note="the input could not be read"; return 1; }
    # the store's templates, then the user's own libraries
    # (PROVOST_LLM_TEMPLATE_DIRS), then the ones shipped with provost
    local d dirs="$tdir:${PROVOST_LLM_TEMPLATE_DIRS:-}"
    IFS=: read -ra _dl <<< "$dirs"
    for d in "${_dl[@]}"; do [[ -n "$d" && -f "$d/$kf" ]] && { tpl="$d/$kf"; break; }; done
    if [[ -z "$tpl" ]]; then
        found="$(python3 "$py" find "$body" --dirs "$dirs" 2>/dev/null)" && tpl="${found%%$'\t'*}"
    fi
    if [[ -n "$tpl" ]]; then
        # REPAIR: a stored template that meets a kind of line it has not met
        # before (left unread, or dropped by a skip pattern) goes back to
        # Claude once to be extended; the extension is kept only if it still
        # reads the captures the template was written from and passes the
        # same rules. Otherwise the template stays as it was.
        local miss="" rnote="" rstat=""
        if (( learn )) && [[ -n "${PROVOST_LLM_API_KEY:-}${ANTHROPIC_API_KEY:-}" ]] \
            && miss="$(python3 "$py" misses "$tpl" "$body" 2>/dev/null)" && [[ -n "$miss" ]]; then
            # every other capture the template was written from that the store
            # still has (its ledger names them): the extension (and a judge's
            # revision of it) must still read them too, though only its
            # examples are sent
            local -a earlier=(); local _c _h _r
            if [[ -f "$tdir/$(_llm_seen_stem "$tpl").seen.tsv" ]]; then
                while IFS=$'\t' read -r _c _h _r; do
                    case "$_h" in learned|extended|checked) ;; *) continue ;; esac
                    [[ "$_c" =~ ^c[0-9]{4,}$ && -f "$(_cap_dir)/$_c/output.txt" ]] \
                        && earlier+=(--earlier "$(_cap_dir)/$_c/output.txt")
                done < "$tdir/$(_llm_seen_stem "$tpl").seen.tsv"
            fi
            if rstat="$(python3 "$py" repair "$tpl" "$body" --out "$new" --tool "$tool" --model "$PROVOST_LLM_MODEL" $jflag \
                    ${earlier[@]+"${earlier[@]}"} 2>"$tmp/llm-repair.err")"; then
                [[ "$rstat" == *$'\n'* ]] && llm_rev="${rstat#*$'\n'}"
                if _llm_reviewed "$new"; then
                    # kept even when unchanged: it now holds this capture, so
                    # these lines are not sent again
                    mkdir -p "$tdir" && cp "$new" "$tdir/$kf"
                    if [[ "${rstat%%$'\n'*}" == unchanged ]]; then
                        llm_how="template ${tpl##*/}, which Claude checked for $miss and left as it was (llm-templates/$kf)${llm_rev:+, $llm_rev}"
                        llm_seen_how=checked
                    else
                        llm_how="template ${tpl##*/}, which Claude extended for $miss (llm-templates/$kf)${llm_rev:+, $llm_rev}"
                        llm_seen_how=extended
                    fi
                    llm_learned="llm-templates/$kf"; llm_seen_tpl="$tdir/$kf"
                    return 0
                fi
                rnote="the template Claude extended for $miss fails the gate: $llm_note"
            else
                err="$(cat "$tmp/llm-repair.err" 2>/dev/null)"
                rnote="Claude could not extend it for $miss: ${err#template: }"
            fi
        fi
        if _llm_file "$tpl"; then
            llm_how="template ${tpl##*/}${rnote:+ ($rnote)}"; llm_seen_how=read; llm_seen_tpl="$tpl"
            return 0
        fi
        llm_note="template ${tpl##*/} does not fit: $llm_note${rnote:+; $rnote}"
        # a repair was tried: don't also have Claude start the tool's template over
        [[ -z "$rnote" ]] || return 1
    fi
    (( learn )) || { llm_note="${llm_note:-no stored template fits}"; return 1; }
    if [[ -z "${PROVOST_LLM_API_KEY:-}${ANTHROPIC_API_KEY:-}" ]]; then
        llm_note="${llm_note:-no stored template fits}; no API key to have Claude write one (PROVOST_LLM_API_KEY or ANTHROPIC_API_KEY)"
        return 1
    fi
    prev="$llm_note"
    if ! out="$(python3 "$py" learn "$body" --out "$new" --tool "$tool" --model "$PROVOST_LLM_MODEL" $jflag 2>"$tmp/llm-learn.err")"; then
        err="$(cat "$tmp/llm-learn.err" 2>/dev/null)"
        llm_note="${prev:+$prev; }Claude wrote no usable template: ${err#template: }"; return 1
    fi
    [[ "$out" == *$'\n'* ]] && llm_rev="${out#*$'\n'}"
    if ! _llm_reviewed "$new"; then
        llm_note="${prev:+$prev; }the template Claude wrote fails the gate: $llm_note"; return 1
    fi
    mkdir -p "$tdir" && cp "$new" "$tdir/$kf"
    llm_how="a new template Claude wrote (llm-templates/$kf)${llm_rev:+, $llm_rev}"; llm_learned="llm-templates/$kf"
    llm_seen_how=learned; llm_seen_tpl="$tdir/$kf"
    return 0
}

# THE LEDGER: every capture an LLM template files is recorded beside the
# store's templates, in llm-templates/NAME.seen.tsv (NAME: the template's file
# name without .json, whichever directory it came from), one row a capture:
#   capture  how  template  read  unread  skipped  unjudged  input_sha256
# how: learned (Claude wrote it from this capture), extended or checked (a
# repair: Claude saw this capture and changed the template, or left it as it
# was), read (filed by it as it was). template: llm-templates/NAME.json, or
# shipped:NAME.json, or the library path it came from. The counts are its
# lines on this capture (template.py audit): read, left unread, skipped, and
# of the skipped those set aside unjudged (counted as unread). A repair reads
# it for the captures the template was written from (learned, extended,
# checked) and checks the extension against every one the store still has.
# Written by _ingest_store under the store lock, with the capture's id;
# committed with the capture. A capture `rm --capture` purges keeps its row
# (as its commit keeps its Input-SHA256 trailer); a repair skips it.
_llm_seen_stem () { local b="${1##*/}"; printf '%s\n' "${b%.json}"; }

# _llm_seen ID — append this capture's row to its template's ledger.
_llm_seen () {
    local cid="$1" tdir="$PROVOST_WORKSPACE/llm-templates" led src
    [[ -n "${llm_seen_how:-}" && -n "${llm_seen_tpl:-}" ]] || return 0
    led="$tdir/$(_llm_seen_stem "$llm_seen_tpl").seen.tsv"
    case "$llm_seen_tpl" in
        "$tdir"/*) src="llm-templates/${llm_seen_tpl##*/}" ;;
        "$PROVOST_ROOT/extract/llm/templates"/*) src="shipped:${llm_seen_tpl##*/}" ;;
        *) src="$llm_seen_tpl" ;;
    esac
    src="${src//[$'\t\r\n']/ }"
    local _s _d _j _u _r _n
    read -r _s _d _j _u _r _n <<< "${llm_audit:-}" || true
    mkdir -p "$tdir"
    [[ -s "$led" ]] || printf 'capture\thow\ttemplate\tread\tunread\tskipped\tunjudged\tinput_sha256\n' > "$led"
    local sha="${in_sha:-}"; [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || sha=""
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$cid" "$llm_seen_how" "$src" \
        "${_r:-}" "${_n:-}" "${_s:-}" "${_u:-}" "$sha" >> "$led"
}

# Core ingest pipeline shared by `inject` (pipe/file), `run` (a command) and
# `batch` (many inputs, one commit). A capture is two halves:
#   _ingest_parse  extracts → classifies → melts, into a work dir, touching
#                  nothing in the store (LLM templates aside, see _llm_template);
#   _ingest_store  assigns a global #N to each row → stores → records
#                  provenance (#N → capture) → commits, under the store lock.
# The halves meet in the work dir: the dataset files, and state.sh (the parse's
# verdict, as `declare -p`), which _ingest_store sources back into locals.
# `batch` runs the parse halves in parallel and the store halves in one lock.
#   $1 input file  $2 threshold  $3 source (inject|run|batch)  $4 cmd ("" for
#   inject)  $5 rc ("" for inject)  $6 dataset name ("" = the winning
#   strategy's name)
_ingest () {
    local in="$1" threshold="$2" source="$3" cmd="${4:-}" rc="${5:-}" name="${6:-}"
    _mktempd provost; local tmp="$_MKTEMPD"
    _ingest_parse "$in" "$threshold" "$cmd" "$name" "$tmp"
    _ingest_store "$in" "$source" "$cmd" "$rc" "$tmp" 1
    rm -rf "$tmp"
}

# _ingest_parse IN THRESHOLD CMD NAME WORKDIR — the parse half of a capture.
# _read_engine_meta METAF — the engine's __EXTRACT_META__ line into the
# caller's strategy, conf, cov and tcons. Besides the winner and its
# confidence the line carries its LINE COVERAGE (the share of the input's
# non-blank lines that reached the dataset) and its COLUMN-TYPE CONSISTENCY
# (the share of typed cells that match their column's type); '' = not
# measured, e.g. a very large input.
_read_engine_meta () {
    strategy=""; conf=""; cov=""; tcons=""
    IFS=$'\t' read -r strategy conf cov tcons < <(awk -F'\t' \
        '/^__EXTRACT_META__/ { s = $2; c = $3; v = $4; t = $5 } END { printf "%s\t%s\t%s\t%s\n", s, c, v, t }' "$1" 2>/dev/null) || true
    [[ "$conf" =~ ^[0-9]{1,9}$ ]] || conf=0
    [[ "$cov" =~ ^[0-9]{1,3}$ ]] || cov=""
    [[ "$tcons" =~ ^[0-9]{1,3}$ ]] || tcons=""
}

_ingest_parse () {
    local in="$1" threshold="$2" cmd="${3:-}" name="${4:-}" tmp="$5"
    local engine; engine="$(_find_engine)" \
        || die "extract engine not found (expected at $PROVOST_ROOT/extract/provost-extract)."

    # A metadata prologue — a leading run of '#%' lines, as prepended by
    # wrappers like deframe — is capture context, not data: peel it off before
    # detection so it can never corrupt a parse. The prologue is recorded with
    # the capture (context.txt) and 'provost source' still shows the input
    # verbatim; a '#%' line after the first data line is data, not context.
    local ctxf="$tmp/context.txt" body="$in" first2=""
    first2="$(head -c 2 "$in" 2>/dev/null || true)"
    if [[ "$first2" == '#%' ]]; then
        body="$tmp/body.txt"
        CTX="$ctxf" awk \
            '!started && /^#%/ { print > (ENVIRON["CTX"]); next } { started=1; print }' \
            "$in" > "$body"
    fi

    local metaf="$tmp/meta.txt" strategy="" conf="" cov="" tcons=""
    # Extra strategy dir (deframe et al.): --plugin-dir / $PROVOST_PLUGIN_DIR is
    # forwarded to the engine, which already searches it alongside its own
    # strategies/ and the ~/.config/provost/strategies user dir.
    local eargs=()
    if [[ -n "${PROVOST_PLUGIN_DIR:-}" ]]; then
        eargs+=(--plugin-dir "$PROVOST_PLUGIN_DIR")
    fi

    # The datasets this capture will file, each as a content FILE (header +
    # rows). A normal capture yields exactly one; --multi (PROVOST_MULTI=1) can
    # yield several, because some reports genuinely hold more than one table
    # (iostat -x: a uname banner, an avg-cpu kv block and a Device table).
    # Everything downstream — row ids, provenance, the commit — loops over
    # these, so the single-dataset case is just N=1.
    local -a ds_name=() ds_strategy=() ds_conf=() ds_file=() ds_cov=() ds_cons=()
    local reason=""
    # AUTO-MULTI state (see _auto_multi): am_reason = why the gate held the
    # single parse that was segmented instead; am_note = why segmenting was
    # declined (the capture is then held as before); am_cov = the coverage of
    # all the datasets together.
    local am_reason="" am_note="" am_cov="" am_kind="" single_strategy="" single_conf="" am_model=0
    # LAYOUT MODEL state (see _layout_model): lm_reason = why the gate held the
    # engine's parse that the model's table replaced; lm_note = why the model
    # was declined; single_cov / single_cons = the held parse's measures.
    local lm_reason="" lm_note="" single_cov="" single_cons="" mm_note=""
    local llm_reason="" llm_note="" llm_how="" llm_learned="" llm_multi=0 llm_floor=gain llm_notes="" llm_notes_base=""
    local llm_audit="" llm_seen_how="" llm_seen_tpl=""

    if [[ "$PROVOST_MULTI" == 1 ]]; then
        # --multi splits the input into blocks, groups them, and emits each
        # surviving dataset behind a `__DATASET__ n strategy confidence
        # coverage consistency lines` line.
        local multi_out="$tmp/multi.txt"
        _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
            ${eargs[@]+"${eargs[@]}"} --multi -f tsv --max-strategies 1 "$body" \
            >"$multi_out" 2>"$metaf" || true
        _multi_split "$multi_out" "$tmp"
        local i=1 dstrat dconf dcov dcons
        while [[ -f "$tmp/ds.$i.meta" ]]; do
            dstrat=""; dconf=""; dcov=""; dcons=""
            IFS=$'\t' read -r dstrat dconf dcov dcons _ < "$tmp/ds.$i.meta" || true
            [[ "$dconf" =~ ^[0-9]{1,9}$ ]] || dconf=0
            [[ "$dcov" =~ ^[0-9]{1,3}$ ]] || dcov="-"
            [[ "$dcons" =~ ^[0-9]{1,3}$ ]] || dcons="-"
            # A dataset below the threshold is dropped rather than queued: it is
            # a fragment of an input whose other parts did match, and the whole
            # input is stored with the capture either way.
            if [[ -n "$dstrat" && -s "$tmp/ds.$i.wide" ]] && (( dconf >= threshold )); then
                _core_melt_tidy_file "$tmp/ds.$i.wide" "" "$tmp/ds.$i.tsv.renamed" > "$tmp/ds.$i.tsv"
                if _valid_name "$dstrat"; then :; else dstrat="$(_sanitize_name "$dstrat")"; dstrat="${dstrat:-dataset}"; fi
                ds_name+=("${name:+$name.}$dstrat"); ds_strategy+=("$dstrat"); ds_conf+=("$dconf")
                ds_cov+=("$dcov"); ds_cons+=("$dcons")
                ds_file+=("$tmp/ds.$i.tsv")
            fi
            i=$((i + 1))
        done
    fi

    if [[ ${#ds_file[@]} -eq 0 ]]; then
        # Single-dataset path — also the fallback when --multi found nothing
        # worth filing, so an unmatched input still reaches the triage queue.
        # DETECTION REUSE (batch): an input of a group whose first input was
        # read cleanly (see cmd_batch) is parsed with that input's strategy
        # first, skipping detection -- a seventh of the engine's time on a
        # small input -- and the result is kept only if it is the same table:
        # the same strategy, the same header, coverage no lower. Anything
        # else is parsed from scratch, as without the hint.
        local reused=""
        if [[ -n "${_BATCH_HINT:-}" && -s "$_BATCH_HINT" ]]; then
            local h_strat h_cov h_head
            h_strat="$(sed -n 1p "$_BATCH_HINT")"
            h_cov="$(sed -n 2p "$_BATCH_HINT")"
            h_head="$(sed -n 3p "$_BATCH_HINT")"
            _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
                ${eargs[@]+"${eargs[@]}"} -s "$h_strat" \
                --emit-meta -f tsv --max-strategies 1 "$body" >"$tmp/wide.tsv" 2>"$metaf" || true
            _read_engine_meta "$metaf"
            if [[ "$strategy" == "$h_strat" && -n "$cov" && "$h_cov" =~ ^[0-9]{1,3}$ ]] \
                && (( cov >= h_cov )) && [[ "$(head -n 1 "$tmp/wide.tsv")" == "$h_head" ]]; then
                reused="$h_strat"
            fi
        fi
        if [[ -z "$reused" ]]; then
            _run_engine "$engine" --max-input-size "$PROVOST_MAX_INPUT" \
                ${eargs[@]+"${eargs[@]}"} \
                --emit-meta -f tsv --max-strategies 1 "$body" >"$tmp/wide.tsv" 2>"$metaf" || true
            _read_engine_meta "$metaf"
        fi

        # Build the content to file (header + data rows), pre-#-index, for both
        # the matched and the held-back (unsorted) paths.
        if [[ -z "$strategy" || ! -s "$tmp/wide.tsv" ]] || ! grep -q . "$tmp/wide.tsv"; then reason="no-match"
        elif (( conf < threshold )); then reason="low-confidence ($conf<$threshold)"
        elif ! _quality_exempt "$engine" "$strategy"; then
            if [[ -n "$cov" ]] && (( PROVOST_MIN_COVERAGE > 0 && cov < PROVOST_MIN_COVERAGE )); then
                reason="low-coverage ($strategy kept $cov% of the lines, <$PROVOST_MIN_COVERAGE%)"
            elif [[ -n "$tcons" ]] && (( PROVOST_MIN_CONSISTENCY > 0 && tcons < PROVOST_MIN_CONSISTENCY )); then
                reason="low-consistency ($strategy columns $tcons% type-consistent, <$PROVOST_MIN_CONSISTENCY%)"
            fi
        fi
        single_strategy="$strategy"; single_conf="$conf"
        # AUTO-MULTI: before holding a parse the quality gate rejects, try
        # segmenting the input (the engine's --multi); file the datasets when
        # every one of them passes the gate and together they keep materially
        # more of the input (see _auto_multi). Only gate failures pay for this
        # second engine run — a parse that passes is never re-run.
        # LLM TEMPLATES, FIRST (PROVOST_LLM=1): a template Claude wrote for this
        # tool — stored, or written now — is tried before the heuristics'
        # fallbacks on a held capture, and before a GENERIC parse the gate
        # passed is trusted (the gate cannot see a title or prompt read as the
        # header; a template written for the tool's layout can). Never over an
        # exact-format or tool-specific parser, with one exception: yaml. Its
        # grammar is lax enough that plain `Label: text` output is valid YAML
        # (golangci-lint's linter list reads as one 110-column record, its
        # section titles lost), so a template ALREADY STORED for the tool may
        # better a yaml parse under the same rule as a generic one. Claude is
        # never asked to write one for it: a real YAML document has no
        # template and costs nothing. See _llm_template, _llm_file.
        if [[ "$PROVOST_LLM" == 1 ]]; then
            single_cov="$cov"; single_cons="$tcons"
            if [[ "$reason" == low-coverage* || "$reason" == low-consistency* ]]; then
                if _llm_template 1; then
                    if (( llm_multi )); then am_reason="$reason"; else llm_reason="$reason"; fi
                    reason=""
                fi
            elif [[ -z "$reason" ]] && { [[ "$strategy" == yaml ]] || ! _quality_exempt "$engine" "$strategy"; }; then
                local _held="passed over (the engine read it as $strategy, coverage ${cov:--}%): a template" _learn=1
                [[ "$strategy" == yaml ]] && _learn=0
                llm_floor=match
                if _llm_template "$_learn"; then
                    if [[ -n "$llm_learned" ]]; then _held="$_held Claude wrote for this tool fits"
                    else _held="$_held stored for this tool fits"; fi
                    if (( llm_multi )); then am_reason="$_held"; else llm_reason="$_held"; fi
                fi
                llm_floor=gain
            fi
        fi
        if [[ "$PROVOST_AUTO_MULTI" == 1 && ( "$reason" == low-coverage* || "$reason" == low-consistency* ) ]]; then
            if _auto_multi; then am_reason="$reason"; reason=""; fi
        fi
        # LAYOUT MODEL: still held after that? Try the learned layout model's
        # table, filed only if it passes the same gate (see _layout_model).
        if [[ "$PROVOST_MODEL" == 1 && -z "$am_reason" && ( "$reason" == low-coverage* || "$reason" == low-consistency* ) ]]; then
            single_cov="$cov"; single_cons="$tcons"
            if _layout_model; then lm_reason="$reason"; reason=""
            elif _model_multi; then am_reason="$reason"; reason=""
            else lm_note="$lm_note; segmenting it itself: $mm_note"; fi
        fi
        # (a generic parse the gate passed and no template bettered is filed
        # as it was; meta.tsv still records why the template was declined)
        if [[ -z "$am_reason" ]]; then
            local dsname content="$tmp/content.tsv"
            if [[ -n "$reason" ]]; then
                dsname="unsorted"; strategy="${strategy:-none}"
                {
                    printf 'raw\n'
                    if ! base64 -w0 < "$in" 2>/dev/null; then base64 < "$in" | tr -d '\n'; fi
                    printf '\n'
                } > "$content"
            else
                if _valid_name "$strategy"; then dsname="$strategy"
                else dsname="$(_sanitize_name "$strategy")"; dsname="${dsname:-dataset}"; fi
                [[ -n "$name" ]] && dsname="$name"
                _core_melt_tidy_file "$tmp/wide.tsv" "" "$content.renamed" > "$content"
            fi
            ds_name=("$dsname"); ds_strategy=("$strategy"); ds_conf=("$conf")
            ds_file=("$content")
        fi
    fi
    # LLM NOTES: the lines a template set aside that still carry a word or a
    # number (a title, a version banner, a summary count, a warning or an
    # error between the rows, a line it could not read) are filed beside its
    # datasets as NAME.notes (line, kind, text): the tables stay clean and
    # nothing that carries information is lost (template.py notes).
    if [[ -z "$reason" && -n "$llm_notes" && -s "$llm_notes" ]] \
        && [[ "$strategy" == llm-template || "$am_kind" == llm-template ]]; then
        local nn="${ds_name[0]}.notes" nk="${#ds_name[@]}" _dn
        if (( llm_multi )); then nn="${llm_notes_base:+$llm_notes_base.}notes"
        else ds_cov[0]="${cov:--}"; ds_cons[0]="${tcons:--}"; fi
        for _dn in "${ds_name[@]}"; do [[ "$_dn" == "$nn" ]] && nn="${nn}_2"; done
        ds_name[nk]="$nn"; ds_strategy[nk]=llm-template; ds_conf[nk]="${ds_conf[0]}"
        ds_file[nk]="$llm_notes"; ds_cov[nk]="-"; ds_cons[nk]="-"
    fi

    # UNITS (--units base, PROVOST_UNITS=base; transform/units.sh): beside
    # each column whose unit can be read exactly (from its name, from a
    # NAME_unit column, or from its cells), a NAME[UNIT] column of the same
    # values as plain numbers in a base unit (B, B/s, bit, bit/s, s); the
    # original column is kept as it was. Off by default: tidy output does not
    # change unasked. A held capture (`unsorted`) and an LLM template's notes
    # are left as they are. Each dataset's record (ds_units[k], a file of
    # column, unit_column, base, from, read) becomes the capture's units.tsv.
    local -a ds_units=(); local units_mode=off uk
    if [[ "$PROVOST_UNITS" == base && -z "$reason" ]]; then
        units_mode=base
        for (( uk=0; uk<${#ds_file[@]}; uk++ )); do
            ds_units[uk]=""
            [[ "${ds_name[uk]}" == unsorted ]] && continue
            [[ -n "$llm_notes" && "${ds_file[uk]}" == "$llm_notes" ]] && continue
            if _core_units_base "${ds_file[uk]}" "${ds_file[uk]}.u" "${ds_file[uk]}.units" \
                "${ds_strategy[uk]}" "${ds_name[uk]%%.*}" ${name:+"$name"}; then
                mv "${ds_file[uk]}.u" "${ds_file[uk]}"
                [[ -s "${ds_file[uk]}.units" ]] && ds_units[uk]="${ds_file[uk]}.units"
            else
                rm -f "${ds_file[uk]}.u"
                warn "could not read the units of dataset ${ds_name[uk]}; it is filed without NAME[UNIT] columns."
            fi
        done
    fi

    # The verdict, for the store half: every variable it reads, as `declare -p`
    # (sourced inside _ingest_store, each comes back as a local there).
    local detection=""
    [[ -n "${reused:-}" ]] && detection="reused ($reused, from the batch's first input of this name)"
    declare -p ds_name ds_strategy ds_conf ds_file ds_cov ds_cons reason \
        strategy conf cov tcons am_reason am_note am_cov am_kind am_model \
        single_strategy single_conf single_cov single_cons lm_reason lm_note \
        llm_reason llm_note llm_how llm_learned llm_audit llm_seen_how llm_seen_tpl ctxf detection \
        ds_units units_mode > "$tmp/state.sh"
}

# _ingest_store IN SOURCE CMD RC WORKDIR COMMIT — the store half of a capture
# parsed into WORKDIR. COMMIT=1 takes the store lock, commits and tags, as one
# capture always has; COMMIT=0 is for `batch`, which holds the lock across all
# its captures and makes one commit, and leaves the capture id in $_CAPID.
_ingest_store () {
    local in="$1" source="$2" cmd="${3:-}" rc="${4:-}" tmp="$5" commit="${6:-1}"
    # shellcheck source=/dev/null
    source "$tmp/state.sh"

    # --- critical section: assign #N, append, provenance, commit -----------
    if (( commit )); then
        _lock
        _require_on_branch
    fi

    local id capd ts
    _next_capture_id; id="$_CAPID"; capd="$(_cap_dir)/$id"; mkdir -p "$capd"
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cp "$in" "$capd/output.txt"
    if [[ -s "$ctxf" ]]; then cp "$ctxf" "$capd/context.txt"; fi
    # The input's hashes (PV-026): as received (before CRs were stripped), and
    # of output.txt as stored, which is what 'provost verify' re-hashes.
    local in_sha="" in_bytes="" out_sha=""
    if [[ -f "$in.received" ]]; then IFS=$'\t' read -r in_sha in_bytes < "$in.received" || true; fi
    # What the secret scrub replaced (PV-033): kind=n,..., none, or off.
    local redacted=""
    if [[ -f "$in.redacted" ]]; then redacted="$(_redacted_summary "$in.redacted")"; fi
    out_sha="$(_sha256 "$capd/output.txt")"
    local prov; prov="$(_prov_file)"
    [[ -f "$prov" ]] || printf '#\tdataset\tcapture\n' > "$prov"

    # CONTEXT COLUMNS (--context-columns, PROVOST_CONTEXT_COLUMNS=1): every
    # `key=value` word in the '#%' prologue becomes a column on each of this
    # capture's rows (a value may be double-quoted to hold spaces: see
    # _prologue_kv), after `#` and `capture` -- so a wrapper that captures one
    # host's output can say `#% host=web03 rack=r2` and every row carries it.
    # The last value of a repeated key wins; words that are not `key=value`
    # stay context only. A data column of the same name keeps its name and the
    # context one takes a leading `_` (melt's clash rule, as `capture` does);
    # the names are chosen once per capture, against the data columns of all
    # its datasets (and `capture`), and recorded in meta.tsv as
    # `context_columns` (key=column,...), so a reader can tell a context
    # column from a data column of the same name.
    # A held capture (`unsorted`) stays as it is: one raw column.
    local ctx_keys="" ctx_vals="" ctx_cols="" ctx_map=""
    if [[ "$PROVOST_CONTEXT_COLUMNS" == 1 && -s "$ctxf" ]]; then
        { IFS= read -r ctx_keys; IFS= read -r ctx_vals; } < <(_prologue_kv "$ctxf" | awk -F'\t' '
            { k = $1; if (!(k in V)) O[++n] = k; V[k] = $2 }
            END { for (j = 1; j <= n; j++) { ks = ks (j > 1 ? "\t" : "") O[j]; vs = vs (j > 1 ? "\t" : "") V[O[j]] }
                  print ks; print vs }') || true
        local -a ctx_files=(); local ci
        for (( ci=0; ci<${#ds_name[@]}; ci++ )); do
            [[ "${ds_name[ci]}" == unsorted ]] || ctx_files+=("${ds_file[ci]}")
        done
        if [[ -n "$ctx_keys" ]] && (( ${#ctx_files[@]} > 0 )); then
            { IFS= read -r ctx_cols; IFS= read -r ctx_map; } < <(CK="$ctx_keys" awk -F'\t' '
                !(FILENAME in H) && length($0) { H[FILENAME] = 1; for (i = 1; i <= NF; i++) U[$i] = 1 }
                END { U["capture"] = 1
                      n = split(ENVIRON["CK"], K, "\t")
                      for (j = 1; j <= n; j++) {
                          m = K[j]; while (m in U) m = "_" m
                          U[m] = 1; cs = cs (j > 1 ? "\t" : "") m; ms = ms (j > 1 ? "," : "") K[j] "=" m
                      }
                      print cs; print ms }' "${ctx_files[@]}") || true
        fi
    fi

    # File each dataset in turn: allocate its own #N range, store it, and record
    # a provenance line per row. Row ids run consecutively across the datasets
    # of one capture, so every row still maps back to this one input.
    local nextid firstid startid nrows nf totalrows=0 fields=0 k final ck cv
    nextid="$(cat "$(_rowid_file)" 2>/dev/null || true)"
    [[ "$nextid" =~ ^[0-9]{1,15}$ ]] || die "corrupt row counter in $(_rowid_file): '$nextid'"
    nextid=$((10#$nextid)); firstid="$nextid"
    local -a out_names=() out_ranges=(); local renamed=""
    for (( k=0; k<${#ds_file[@]}; k++ )); do
        startid="$nextid"
        # Prepend the visible, globally-unique '#' index and the capture id
        # (which run each row came from) to the header + each row (blank lines
        # dropped), counting rows and header fields as we go. A data column
        # already named `capture` keeps its name; the added one becomes
        # `_capture` (melt's clash rule); a later reconcile renames the two
        # sides' column 2 alike (_capcol_align), so a by-name union never merges them.
        ck="$ctx_cols"; cv="$ctx_vals"
        [[ "${ds_name[k]}" == unsorted ]] && { ck=""; cv=""; }
        CNTF="$tmp/cnt" CAPID="$id" CK="$ck" CV="$cv" awk -F'\t' -v s="$startid" '
            length($0) == 0 { next }
            !h { h = 1; nf = NF + 1
                 for (i = 1; i <= NF; i++) U[$i] = 1
                 nc = (ENVIRON["CK"] == "") ? 0 : split(ENVIRON["CK"], K, "\t")
                 split(ENVIRON["CV"], W, "\t")
                 ch = ""; cr = ""
                 for (j = 1; j <= nc; j++) {
                     m = K[j]; while (m in U) m = "_" m
                     U[m] = 1; ch = ch m "\t"; cr = cr W[j] "\t"
                 }
                 c = "capture"; while (c in U) c = "_" c
                 print "#\t" c "\t" ch $0; next }
            { print (s + n) "\t" ENVIRON["CAPID"] "\t" cr $0; n++ }
            END { print n + 0, nf + 0 > (ENVIRON["CNTF"]) }' "${ds_file[k]}" > "$tmp/id.tsv"
        read -r nrows nf < "$tmp/cnt"
        [[ $k -eq 0 ]] && fields="$nf"

        _store_append "${ds_name[k]}" "$tmp/id.tsv"
        final="$_SA_TARGET"
        out_names+=("$final")
        # the columns --units base added, as units.tsv (see _ingest_parse)
        if [[ -n "${ds_units[k]:-}" && -s "${ds_units[k]}" ]]; then
            [[ -f "$capd/units.tsv" ]] || printf 'dataset\tcolumn\tunit_column\tbase\tfrom\tread\n' > "$capd/units.tsv"
            DS="$final" awk 'BEGIN { ds = ENVIRON["DS"] } { print ds "\t" $0 }' "${ds_units[k]}" >> "$capd/units.tsv"
        fi
        if (( nrows > 0 )); then out_ranges+=("#${startid}..$((startid+nrows-1))"); else out_ranges+=("none"); fi
        # a data column the melt renamed off the row id (`#` -> `#_2`, see
        # transform/melt.sh): recorded as DATASET:old=new,...
        if [[ -s "${ds_file[k]}.renamed" ]]; then
            local rn; rn="$(paste -sd , "${ds_file[k]}.renamed")"
            renamed="${renamed:+$renamed,}$final:${rn//,/,$final:}"
        fi

        # One provenance line per row (#N → dataset, capture), in one awk.
        if (( nrows > 0 )); then
            PDS="$final" PID="$id" awk -v s="$startid" -v n="$nrows" 'BEGIN {
                ds = ENVIRON["PDS"]; id = ENVIRON["PID"]
                for (i = 0; i < n; i++) printf "%d\t%s\t%s\n", s + i, ds, id }' >> "$prov"
        fi
        nextid=$((startid + nrows)); totalrows=$((totalrows + nrows))
    done
    echo "$nextid" > "$(_rowid_file)"

    # meta.tsv keeps its single-dataset keys; with several datasets they carry a
    # comma-joined value and `datasets` records how many (plus each one's rows).
    local j all_names="" all_strats="" all_confs="" all_rows="" all_covs="" all_conss=""
    for (( j=0; j<${#out_names[@]}; j++ )); do
        all_names="${all_names:+$all_names,}${out_names[j]}"
        all_strats="${all_strats:+$all_strats,}${ds_strategy[j]}"
        all_confs="${all_confs:+$all_confs,}${ds_conf[j]}"
        all_rows="${all_rows:+$all_rows,}${out_names[j]}:${out_ranges[j]}"
        all_covs="${all_covs:+$all_covs,}${out_names[j]}:${ds_cov[j]:--}"
        all_conss="${all_conss:+$all_conss,}${out_names[j]}:${ds_cons[j]:--}"
    done
    {
        printf 'id\t%s\n' "$id";            printf 'ts\t%s\n' "$ts"
        printf 'source\t%s\n' "$source";    printf 'command\t%s\n' "$(_meta_safe "$cmd")"
        printf 'rc\t%s\n' "$rc";            printf 'strategy\t%s\n' "$(_meta_safe "$all_strats")"
        printf 'confidence\t%s\n' "$all_confs";  printf 'dataset\t%s\n' "$all_names"
        printf 'row_ids\t%s\n' "$( (( totalrows > 0 )) && echo "$firstid-$((nextid-1))" || echo none)"
        if [[ -n "$am_reason" ]]; then
            # Segmented by auto-multi: coverage is that of all the datasets
            # together; the single parse the gate held is kept for the record.
            printf 'coverage\t%s\n' "$am_cov"
            printf 'auto_multi\t%s\n' "$(_meta_safe "segmented ($am_kind): $am_reason")"
            (( am_model > 0 )) && printf 'auto_multi_model_parts\t%s\n' "$am_model"
            printf 'single_strategy\t%s\n' "$(_meta_safe "$single_strategy")"
            printf 'single_confidence\t%s\n' "$single_conf"
            [[ -n "$cov" ]] && printf 'single_coverage\t%s\n' "$cov"
            [[ -n "$tcons" ]] && printf 'single_consistency\t%s\n' "$tcons"
        else
            [[ -n "$cov" && -z "$reason" ]] && printf 'coverage\t%s\n' "$cov"
            [[ -n "$tcons" && -z "$reason" ]] && printf 'consistency\t%s\n' "$tcons"
        fi
        [[ -n "$am_note" ]] && printf 'auto_multi\t%s\n' "$(_meta_safe "declined: $am_note")"
        if [[ -n "$lm_reason" ]]; then
            printf 'layout_model\t%s\n' "$(_meta_safe "filed: the engine's parse was $lm_reason")"
            printf 'single_strategy\t%s\n' "$(_meta_safe "$single_strategy")"
            printf 'single_confidence\t%s\n' "$single_conf"
            [[ -n "$single_cov" ]] && printf 'single_coverage\t%s\n' "$single_cov"
            [[ -n "$single_cons" ]] && printf 'single_consistency\t%s\n' "$single_cons"
        fi
        [[ -n "$lm_note" ]] && printf 'layout_model\t%s\n' "$(_meta_safe "declined: $lm_note")"
        if [[ -n "$llm_how" ]]; then
            printf 'llm_template\t%s\n' "$(_meta_safe "filed by $llm_how")"
            # the skip audit: what the template skipped, and how much of it
            # counted against it (set aside, of a kind not judged decoration)
            if [[ -n "${llm_audit:-}" ]]; then
                local _as _ad _aj _au _ar _an
                read -r _as _ad _aj _au _ar _an <<< "$llm_audit" || true
                printf 'llm_skip_audit\t%s skipped: %s decoration, %s judged decoration, %s not judged (counted as unread)\n' \
                    "${_as:-0}" "${_ad:-0}" "${_aj:-0}" "${_au:-0}"
            fi
            if [[ -n "$llm_reason" ]]; then
                printf 'single_strategy\t%s\n' "$(_meta_safe "$single_strategy")"
                printf 'single_confidence\t%s\n' "$single_conf"
                [[ -n "$single_cov" ]] && printf 'single_coverage\t%s\n' "$single_cov"
            fi
        fi
        [[ -n "$llm_note" && -z "$llm_how" ]] && printf 'llm_template\t%s\n' "$(_meta_safe "declined: $llm_note")"
        if [[ ${#out_names[@]} -gt 1 ]]; then
            printf 'datasets\t%s\n' "${#out_names[@]}"
            printf 'dataset_rows\t%s\n' "$all_rows"
            if [[ ${#ds_cov[@]} -gt 0 ]]; then
                printf 'dataset_coverage\t%s\n' "$all_covs"
                printf 'dataset_consistency\t%s\n' "$all_conss"
            fi
        fi
        if [[ -n "${PROVOST_PLUGIN_DIR:-}" ]]; then
            printf 'plugin_dir\t%s\n' "$(_meta_safe "$PROVOST_PLUGIN_DIR")"
        fi
        if [[ -s "$ctxf" ]]; then printf 'context\tcontext.txt\n'; fi
        if [[ -n "$ctx_map" ]]; then printf 'context_columns\t%s\n' "$ctx_map"; fi
        if [[ "${units_mode:-off}" == base ]]; then
            printf 'units\tbase\n'
            [[ -f "$capd/units.tsv" ]] && printf 'units_columns\tunits.tsv\n'
        fi
        if [[ -n "$renamed" ]]; then printf 'renamed_columns\t%s\n' "$(_meta_safe "$renamed")"; fi
        if [[ -n "${detection:-}" ]]; then printf 'detection\t%s\n' "$(_meta_safe "$detection")"; fi
        [[ -n "$redacted" ]] && printf 'redacted\t%s\n' "$redacted"
        [[ "$in_sha" =~ ^[0-9a-f]{64}$ ]] && printf 'input_sha256\t%s\n' "$in_sha"
        [[ "$in_bytes" =~ ^[0-9]+$ ]] && printf 'input_bytes\t%s\n' "$in_bytes"
        [[ -n "$out_sha" ]] && printf 'output_sha256\t%s\n' "$out_sha"
    } > "$capd/meta.tsv"
    # the template that filed it records the capture (its ledger)
    [[ -n "$llm_how" ]] && _llm_seen "$id"
    startid="$firstid"; nrows="$totalrows"; final="$all_names"; strategy="$all_strats"; conf="$all_confs"

    if (( commit )); then
        # In a controlled directory, snapshot the directory's contents as commit
        # context so the capture is tied to what the tree looked like at the time.
        local ctl_dir=""
        if [[ "${PROVOST_STORE_KIND:-}" == controlled:* ]]; then
            ctl_dir="$(dirname "$PROVOST_WORKSPACE")"
            _snapshot_context "$ctl_dir" "$PROVOST_WORKSPACE" >/dev/null \
                || warn "could not snapshot the controlled directory's context."
        fi
        local msg="capture $id: $source $strategy → $final (#${startid}..$((startid+nrows-1)))"
        [[ -n "$cmd" ]] && msg="$msg [$cmd]"
        msg="$msg$(_hash_trailers "$id")"
        _commit "$msg"
        local out
        out="$(_git tag "capture-$id" 2>&1)" || { printf 'git: %s\n' "$out" >&2; die "capture $id was committed but could not be tagged capture-$id."; }
        if [[ -n "$ctl_dir" ]]; then
            _snapshot_files "$ctl_dir" "$id" \
                || warn "could not save the controlled directory's files for $id (the capture itself is filed)."
        fi
        _unlock
    fi
    _CAPID="$id"

    local idrange="#${startid}..$((startid+nrows-1))"; (( nrows == 0 )) && idrange="(no rows)"
    if [[ -n "$reason" ]]; then
        info "$id: $reason — queued in 'unsorted' as $idrange (committed)."
        [[ -n "$am_note" ]] && info "      segmenting it did not help: $am_note."
        [[ -n "$lm_note" ]] && info "      the layout model did not help: $lm_note."
        [[ -n "$llm_note" ]] && info "      no LLM template helped: $llm_note."
    elif [[ ${#out_names[@]} -gt 1 ]]; then
        if [[ -n "$am_reason" ]]; then
            ok "$id: → ${#out_names[@]} datasets, rows $idrange — segmented: the single parse was $am_reason; the ${#out_names[@]} parts keep $am_cov%:"
            (( am_model > 0 )) && info "      the layout model read $am_model of the parts the engine could not."
            [[ "$am_kind" == layout-model ]] && info "      the layout model segmented it (the engine's own segmenting did not help: $am_note)."
            [[ "$am_kind" == llm-template ]] && info "      read by $llm_how${llm_learned:+ (committed with this capture; later captures of the tool are parsed offline)}."
        else
            ok "$id: → ${#out_names[@]} datasets, rows $idrange:"
            [[ -n "$llm_reason" ]] && info "      the engine's parse ($single_strategy) was $llm_reason; read by $llm_how${llm_learned:+ (committed with this capture; later captures of the tool are parsed offline)}."
        fi
        for (( j=0; j<${#out_names[@]}; j++ )); do
            local dq=""
            [[ "${ds_cov[j]:-}" =~ ^[0-9]+$ ]] && dq+=", coverage ${ds_cov[j]}%"
            [[ "${ds_cons[j]:-}" =~ ^[0-9]+$ ]] && dq+=", consistency ${ds_cons[j]}%"
            info "      ${out_names[j]}  ${out_ranges[j]}  (strategy ${ds_strategy[j]}, conf ${ds_conf[j]}$dq)"
        done
    else
        ok "$id: → dataset '$final' rows $idrange (strategy $strategy, conf $conf${cov:+, coverage $cov%}) — $((fields-1)) field(s)."
        [[ -n "$lm_reason" ]] && info "      the engine's parse ($single_strategy) was $lm_reason; the layout model's table passes the gate."
        [[ -n "$llm_reason" ]] && info "      the engine's parse ($single_strategy) was $llm_reason; read by $llm_how${llm_learned:+ (committed with this capture; later captures of the tool are parsed offline)}."
        # Low line coverage: the parse kept only part of the input. Say so —
        # silently filing a fragment is the failure this guards against.
        if [[ -n "$cov" ]] && (( cov < 60 )); then
            info "      only $cov% of the input's lines reached '$final'; the whole input stays with capture $id ('provost source'), and --multi files each section as a dataset of its own."
        fi
    fi
    if [[ "$redacted" == *=* ]]; then
        info "      secrets scrubbed before filing: ${redacted//,/, } ('provost source' shows [REDACTED:kind] in their place)."
    fi
    # (the messages above end in `[[ ]] &&` tests; the capture itself is filed)
    return 0
}

# Background ingest: spool the input and run _ingest in a detached child so the
# prompt returns immediately. Used only when interactive (stderr is a TTY) or
# forced with --async / PROVOST_ASYNC=1; scripts get the synchronous path.
# The spool lives OUTSIDE the workspace (never swept into a commit). On success
# the child removes it. On failure it is kept (input + full log, so the capture
# can be retried) and a one-line record is appended to the store's
# .async-failures.log — every later provost invocation warns about it until
# it is seen with 'provost log --failed' or 'provost doctor'.
_ingest_async () {
    local in="$1" threshold="$2" source="$3" cmd="${4:-}" rc="${5:-}" name="${6:-}"
    local spool
    spool="$(mktemp -d "$PROVOST_TEMP_DIR/provost-async.XXXXXX")" \
        || die "cannot create a spool dir in $PROVOST_TEMP_DIR (set TMPDIR)."
    cp "$in" "$spool/in.txt" || { rm -rf "$spool"; die "cannot spool the input to $spool"; }
    if [[ -f "$in.received" ]]; then cp "$in.received" "$spool/in.txt.received" 2>/dev/null || true; fi
    if [[ -f "$in.redacted" ]]; then cp "$in.redacted" "$spool/in.txt.redacted" 2>/dev/null || true; fi
    (
        trap '' HUP                                   # survive the shell exiting
        _TMPDIRS=(); _LOCKS_HELD=(); _LOCKS_OWNER=()  # nothing of the parent's
        trap _cleanup EXIT
        set +e
        ( set -e; trap _cleanup EXIT; _ingest "$spool/in.txt" "$threshold" "$source" "$cmd" "$rc" "$name" ) \
            >"$spool/log.txt" 2>&1
        irc=$?
        if [[ $irc -eq 0 ]]; then
            rm -rf "$spool"
        else
            last="$(awk 'NF { l = $0 } END { print l }' "$spool/log.txt" 2>/dev/null)"
            last="${last//$'\033'\[[0-9]m/}"; last="${last//$'\033'\[[0-9][0-9]m/}"
            printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$source" \
                "$(_meta_safe "${cmd:-(stdin)}")" "$(_meta_safe "$spool")" \
                "$(_meta_safe "rc=$irc: ${last:-no output}")" >> "$(_faillog)" 2>/dev/null
        fi
        exit 0
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    info "queued (async, pid $!) — capturing in the background; see 'provost log' shortly."
}

# Decide foreground vs background: --async / --sync win, then PROVOST_ASYNC
# (1 / 0), else background only when interactive (stderr is a terminal).
_want_async () {
    case "$1" in
        1) return 0 ;; 0) return 1 ;;
    esac
    case "$PROVOST_ASYNC" in
        1) return 0 ;; 0) return 1 ;;
    esac
    _is_tty
}

# Unacknowledged background failures → one warning line on stderr.
_warn_failures () {
    local log seen=0 n
    log="$(_faillog)"
    [[ -s "$log" ]] || return 0
    n="$(wc -l < "$log")"; n="${n//[!0-9]/}"
    seen="$(cat "$(_failseen)" 2>/dev/null || echo 0)"
    [[ "$seen" =~ ^[0-9]{1,12}$ ]] || seen=0
    if (( n > seen )); then
        warn "$((n - seen)) background capture(s) failed — see 'provost log --failed'."
    fi
}
# Print the failure log and mark every entry seen.
_show_failures () {
    local log n; log="$(_faillog)"
    if [[ ! -s "$log" ]]; then info "no failed background captures."; return 0; fi
    printf '%-20s %-7s %-24s %s\n' "WHEN" "SOURCE" "COMMAND" "ERROR (input + full log kept in SPOOL)" >&2
    awk -F'\t' '{ printf "%-20s %-7s %-24s %s\n      spool: %s\n", $1, $2, $3, $5, $4 }' "$log"
    n="$(wc -l < "$log")"; n="${n//[!0-9]/}"
    printf '%s\n' "$n" > "$(_failseen)" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# Dataset naming for `run`: the command's basename, looking through common
# wrappers (sudo, doas, env, nice, ionice, nohup, time, command, exec, stdbuf,
# timeout) and their options. `xargs` is NOT a wrapper. Prints a valid dataset
# name, or nothing.
# ---------------------------------------------------------------------------
_run_name () {
    local -a a=("$@") sp=()
    local i=0 n=$# w
    while (( i < n )); do
        w="${a[i]##*/}"
        case "$w" in
            sudo)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -u|-g|-h|-p|-C|-D|-r|-t|-U|-T|--user|--group|--host|--prompt|--close-from|--chdir|--role|--type|--other-user|--command-timeout) i=$((i+2)) ;;
                    -*|*=*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            doas)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -u|-C) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            env)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -u|--unset|-C|--chdir) i=$((i+2)) ;;
                    -S|--split-string)
                        read -r -a sp <<< "${a[i+1]:-}" || true
                        a=(${sp[@]+"${sp[@]}"} "${a[@]:i+2}"); n=${#a[@]}; i=0; continue 2 ;;
                    --split-string=*|-S?*)
                        w="${a[i]#--split-string=}"; [[ "$w" == "${a[i]}" ]] && w="${a[i]#-S}"
                        read -r -a sp <<< "$w" || true
                        a=(${sp[@]+"${sp[@]}"} "${a[@]:i+1}"); n=${#a[@]}; i=0; continue 2 ;;
                    -*|*=*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            nice)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -n|--adjustment) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            ionice)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -c|-n|-p|-P|-u|--class|--classdata|--pid|--pgid|--uid) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            nohup)
                i=$((i+1)); [[ "${a[i]:-}" == "--" ]] && i=$((i+1)) ;;
            time)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -f|-o|--format|--output) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            command)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            exec)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -a) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            stdbuf)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -i|-o|-e) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done ;;
            timeout)
                i=$((i+1))
                while (( i < n )); do case "${a[i]}" in
                    --) i=$((i+1)); break ;;
                    -s|-k|--signal|--kill-after) i=$((i+2)) ;;
                    -*) i=$((i+1)) ;;
                    *) break ;;
                esac; done
                i=$((i+1)) ;;                          # the DURATION
            *)
                w="$(_sanitize_name "$w")"
                [[ "$w" == unsorted ]] && w="unsorted-cmd"   # never the triage bucket
                printf '%s' "$w"; return 0 ;;
        esac
    done
    return 0
}

