{
 "format": 1,
 "tool": "openvms-show-system",
 "detect": "^\\s*Pid\\s+Process Name\\s+State\\s+Pri\\s+I/O\\s+CPU",
 "skip": [
  "^\\$"
 ],
 "blocks": [
  {
   "name": "system",
   "kind": "table",
   "line": "^OpenVMS\\s+(?P<version>\\S+)\\s+on node\\s+(?P<node>\\S+)\\s+(?P<time>\\d{1,2}-[A-Z]{3}-\\d{4}\\s+\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?)\\s+Uptime\\s+(?P<uptime>\\d+\\s+\\d\\d:\\d\\d:\\d\\d)\\s*$",
   "columns": {
    "version": "Version",
    "node": "Node",
    "time": "Time",
    "uptime": "Uptime"
   }
  },
  {
   "name": "processes",
   "kind": "table",
   "header": "^\\s*Pid\\s+Process Name\\s+State",
   "line": "^(?P<pid>[0-9A-Fa-f]{8})\\s(?P<name>\\S(?:.*?\\S)?)\\s+(?P<state>[A-Z]+)\\s+(?P<pri>\\d+)\\s+(?P<io>\\d+)\\s+(?P<cpu>\\d+\\s+\\d\\d:\\d\\d:\\d\\d\\.\\d+)\\s+(?P<page_flts>\\d+)\\s+(?P<pages>\\d+)(?:\\s+(?P<flag>\\S+))?\\s*$",
   "columns": {
    "pid": "Pid",
    "name": "Process Name",
    "state": "State",
    "pri": "Pri",
    "io": "I/O",
    "cpu": "CPU",
    "page_flts": "Page flts",
    "pages": "Pages",
    "flag": "Flag"
   }
  }
 ],
 "examples": [
