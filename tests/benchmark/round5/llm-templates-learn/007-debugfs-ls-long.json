{
 "format": 1,
 "tool": "debugfs-ls-long",
 "detect": "^debugfs \\d",
 "skip": [
  "^debugfs \\d"
 ],
 "blocks": [
  {
   "name": "entries",
   "kind": "table",
   "line": "^\\s*(?P<inode>\\d+)\\s+(?P<mode>[0-7]+)\\s+\\((?P<type>\\d+)\\)\\s+(?P<uid>\\d+)\\s+(?P<gid>\\d+)\\s+(?P<size>\\d+(?:,\\s*\\d+)?)\\s+(?P<mtime>\\d{1,2}-[A-Za-z]{3}-\\d{4} \\d{1,2}:\\d{2})\\s(?P<name>.*)$",
   "columns": {
    "inode": "inode",
    "mode": "mode",
    "type": "type",
    "uid": "uid",
    "gid": "gid",
    "size": "size",
    "mtime": "mtime",
    "name": "name"
   }
  }
 ],
