{
 "format": 1,
 "tool": "checkm-qa",
 "detect": "\\[CheckM - qa\\]|Bin Id\\s+Marker lineage",
 "skip": [
  "^\\$ ",
  "^\\*+\\s*$",
  "^-{10,}\\s*$",
  "\\[CheckM - \\w+\\]",
  "^\\s+(?:Calculating|Reading|Parsing|Finished|Tabulating)\\b",
  "^\\s*\\{ Current stage:"
 ],
 "blocks": [
  {
   "name": "bins",
   "kind": "table",
   "header": "^\\s*Bin Id\\s+Marker lineage",
   "line": "^\\s*(?P<bin_id>\\S+)\\s+(?P<marker_lineage>\\S+(?: \\S+)*?)\\s+(?P<genomes>\\d+)\\s+(?P<markers>\\d+)\\s+(?P<marker_sets>\\d+)\\s+(?P<c0>\\d+)\\s+(?P<c1>\\d+)\\s+(?P<c2>\\d+)\\s+(?P<c3>\\d+)\\s+(?P<c4>\\d+)\\s+(?P<c5plus>\\d+)\\s+(?P<completeness>[\\d.]+)\\s+(?P<contamination>[\\d.]+)\\s+(?P<strain_heterogeneity>[\\d.]+)\\s*$",
   "columns": {
    "bin_id": "Bin Id",
    "marker_lineage": "Marker lineage",
    "genomes": "# genomes",
    "markers": "# markers",
    "marker_sets": "# marker sets",
    "c0": "0",
    "c1": "1",
    "c2": "2",
    "c3": "3",
    "c4": "4",
    "c5plus": "5+",
    "completeness": "Completeness",
    "contamination": "Contamination",
    "strain_heterogeneity": "Strain heterogeneity"
   }
  },
  {
   "name": "timing",
   "kind": "kv",
   "line": "^\\s*\\{?\\s*(?P<key>Current stage|Total):\\s*(?P<value>[\\d:.]+)\\s*\\}?\\s*$"
  }
 ],
