{
 "format": 1,
 "tool": "pyright-stats",
 "detect": "^(?:Analysis stats|Timing stats|pyright \\d+\\.\\d+|\\d+ errors?, \\d+ warnings?)",
 "skip": [
  "^(?:Analysis|Timing) stats$",
  "^\\S+$"
 ],
 "blocks": [
  {
   "name": "diagnostics",
   "kind": "table",
   "line": "^\\s+(?P<file>.+?):(?P<line>\\d+):(?P<col>\\d+) - (?P<severity>error|warning|information): (?P<message>.*?)(?: \\((?P<rule>\\w+)\\))?$",
   "columns": {
    "file": "file",
    "line": "line",
    "col": "column",
    "severity": "severity",
    "message": "message",
    "rule": "rule"
   }
  },
  {
   "name": "result_summary",
   "kind": "table",
   "line": "^(?P<errors>\\d+) errors?, (?P<warnings>\\d+) warnings?, (?P<informations>\\d+) informations?$",
   "columns": {
    "errors": "errors",
    "warnings": "warnings",
    "informations": "informations"
   }
  },
  {
   "name": "auto_excludes",
   "kind": "table",
   "line": "^Auto-excluding (?P<pattern>\\S.*)$",
   "columns": {
    "pattern": "Auto-excluding"
   }
  },
  {
   "name": "python_version",
   "kind": "table",
   "line": "^Assuming Python version (?P<python_version>\\S+)$",
   "columns": {
    "python_version": "Python version"
   }
  },
  {
   "name": "source_files",
   "kind": "table",
   "line": "^Found (?P<source_files>\\d+) source files?$",
   "columns": {
    "source_files": "source files"
   }
  },
  {
   "name": "pyright_version",
   "kind": "table",
   "line": "^pyright (?P<version>\\S+)$",
   "columns": {
    "version": "pyright"
   }
  },
  {
   "name": "completion",
   "kind": "table",
   "line": "^Completed in (?P<duration>[\\d.]+\\s*sec)$",
   "columns": {
    "duration": "Completed in"
   }
  },
  {
   "name": "timing_stats",
   "kind": "kv",
   "line": "^(?P<key>[A-Za-z][A-Za-z ]*?):\\s+(?P<value>[\\d.]+sec)$"
  },
  {
   "name": "analysis_stats",
   "kind": "kv",
   "line": "^(?P<key>[A-Za-z][A-Za-z ]*?):\\s+(?P<value>\\d+)$"
  }
 ],
 "examples": [
  "Auto-excluding **/node_modules\nAuto-excluding **/__pycache__\nAuto-excluding **/.*\nAuto-excluding **/__editable__.*\nAssuming Python version 3.13.18.final.0\nFound 1 source file\npyright 1.1.414\n/home/dev/cart/cart.py\n  /home/dev/cart/cart.py:37:27 - error: \"undefined_name\" is not defined (reportUndefinedVariable)\n1 error, 0 warnings, 0 informations\nCompleted in 1.125sec\n\nAnalysis stats\nTotal files parsed and bound: 23\nTotal files checked: 1\n\nTiming stats\nFind Source Files:    0sec\nRead Source Files:    0.01sec\nTokenize:             0.05sec\nParse:                0.08sec\nResolve Imports:      0.02sec\nBind:                 0.1sec\nCheck:                0.13sec\nDetect Cycles:        0sec"
 ]
}
