{
  "format": 1,
  "tool": "cisco-show-mac-address-table",
  "detect": "(?m)^\\s*Mac Address Table\\s*$",
  "skip": [
    "^\\S+#",
    "^\\s*Mac Address Table\\s*$",
    "^-{5,}\\s*$",
    "^[-\\s]+$"
  ],
  "blocks": [
    {
      "name": "mac_addresses",
      "kind": "table",
      "header": "^\\s*Vlan\\s+Mac Address\\s+Type\\s+Ports",
      "line": "\\s*(?P<vlan>\\S+)\\s+(?P<mac>[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4}\\.[0-9a-fA-F]{4})\\s+(?P<type>\\S+)\\s+(?P<ports>\\S(?:.*?\\S)?)\\s*",
      "columns": {
        "vlan": "Vlan",
        "mac": "Mac Address",
        "type": "Type",
        "ports": "Ports"
      }
    },
    {
      "name": "summary",
      "kind": "kv",
      "line": "(?P<key>Total Mac Addresses for this criterion)\\s*:\\s*(?P<value>\\d+)\\s*"
    }
  ]
}
