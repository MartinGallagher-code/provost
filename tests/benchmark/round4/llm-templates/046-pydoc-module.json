{
 "format": 1,
 "tool": "pydoc-module",
 "detect": "^Help on (?:module|package|class|function|built-in \\w+) \\S+:$",
 "skip": [
  "^[A-Z][A-Z ]+$",
  "^\\s{4}The following documentation is automatically generated from the Python$",
  "^\\s{4}source files\\.\\s+It may be incomplete, incorrect or include features that$",
  "^\\s{4}are considered implementation detail and may vary between Python$",
  "^\\s{4}implementations\\.\\s+When in doubt, consult the module reference at the$",
  "^\\s{4}location listed above\\.$"
 ],
 "blocks": [
  {
   "name": "help",
   "kind": "kv",
   "line": "^Help on (?P<key>module|package|class|function|built-in \\w+) (?P<value>\\S+):$"
  },
  {
   "name": "name",
   "kind": "table",
   "line": "^\\s{4}(?P<module>[\\w.]+) - (?P<summary>\\S.*?)\\s*$"
  },
  {
   "name": "reference",
   "kind": "table",
   "line": "^\\s{4}(?P<url>https?://\\S+)\\s*$"
  },
  {
   "name": "file",
   "kind": "table",
   "line": "^\\s{4}(?P<path>/\\S+)\\s*$"
  },
  {
   "name": "functions",
   "kind": "table",
   "line": "^\\s{4,}(?P<name>\\w+)\\((?P<args>[^()]*)\\)(?: --> (?P<returns>\\S.*?))?\\s*$"
  },
  {
   "name": "data",
   "kind": "kv",
   "line": "^\\s{4}(?P<key>\\w+) = (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "description_items",
   "kind": "kv",
   "line": "^\\s{4}(?P<key>[^:]+?): (?P<value>\\S.*?)\\s*$"
  }
 ]
}
