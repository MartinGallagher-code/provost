{
 "format": 1,
 "tool": "teradata-bteq-select",
 "detect": "^\\s*\\*\\*\\* (?:Logon successfully completed|Query completed\\. \\d+ rows? found)",
 "skip": [
  "^\\+-{3,}",
  "^\\s*BTEQ \\d+\\.\\d+",
  "^\\.(?:LOGON|LOGOFF|QUIT|SET|EXPORT|IMPORT|OS)\\b",
  "^\\s*(?:SELECT|SEL|WITH|INSERT|UPDATE|DELETE)\\b",
  "^\\s*\\*\\*\\* (?:Logon successfully completed|Query completed\\.|You are now logged off|Exiting BTEQ|Warning:|Failure )"
 ],
 "blocks": [
  {
   "name": "rows",
   "kind": "table",
   "header": "^region_cd\\s+store_nm\\s+sales_amt\\s+last_upd_ts\\s*$|^-+(?:\\s+-+)+\\s*$",
   "line": "^(?P<region_cd>\\S+)\\s+(?P<store_nm>\\S(?:.*?\\S)?)\\s{2,}(?P<sales_amt>-?[\\d,]*\\.\\d+|\\?)\\s+(?P<last_upd_ts>\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?|\\?)\\s*$",
   "columns": {
    "region_cd": "region_cd",
    "store_nm": "store_nm",
    "sales_amt": "sales_amt",
    "last_upd_ts": "last_upd_ts"
   }
  },
  {
   "name": "session",
   "kind": "kv",
   "line": "^\\s*\\*\\*\\* (?P<key>[A-Z][\\w ()]*?) (?:is|was|are|=) '?(?P<value>\\S(?:.*?\\S)?)'?\\.?\\s*$"
  }
 ]
}
