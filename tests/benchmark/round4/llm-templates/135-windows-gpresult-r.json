{
 "format": 1,
 "tool": "windows-gpresult-r",
 "detect": "^RSOP data for \\S+ on \\S+ : ",
 "skip": [
  "^Microsoft \\(R\\) Windows \\(R\\)",
  "Microsoft Corporation\\. All rights reserved",
  "^\\s*-{5,}\\s*$",
  "^(?:COMPUTER|USER) SETTINGS\\s*$",
  "^\\s{4}(?:Applied Group Policy Objects\\s*$|The following GPOs were not applied|The (?:computer|user) is a part of the following security groups)"
 ],
 "blocks": [
  {
   "name": "rsop",
   "kind": "table",
   "line": "^RSOP data for (?P<user>\\S+) on (?P<computer>\\S+) : (?P<mode>\\S(?:.*?\\S)?)\\s*$",
   "columns": {
    "user": "user",
    "computer": "computer",
    "mode": "mode"
   }
  },
  {
   "name": "run",
   "kind": "kv",
   "line": "^(?P<key>Created on) (?P<value>\\S(?:.*?\\S)?)\\s*$"
  },
  {
   "name": "distinguished_names",
   "kind": "table",
   "line": "^\\s{4}(?P<dn>CN=\\S(?:.*?\\S)?)\\s*$",
   "columns": {
    "dn": "distinguished name"
   }
  },
  {
   "name": "settings",
   "kind": "table",
   "line": "^\\s*(?P<setting>[A-Za-z][^:]*?):\\s+(?P<value>\\S(?:.*?\\S)?)\\s*$",
   "columns": {
    "setting": "setting",
    "value": "value"
   }
  },
  {
   "name": "items",
   "kind": "table",
   "line": "^\\s{8}(?P<name>\\S(?:.*?\\S)?)\\s*$",
   "columns": {
    "name": "name"
   }
  }
 ]
}
