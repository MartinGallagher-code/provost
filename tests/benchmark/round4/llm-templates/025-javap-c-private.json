{
 "format": 1,
 "tool": "javap-c-private",
 "detect": "^Compiled from \\\"[^\\\"]+\\\"$|^\\s+\\d+: \\w+",
 "skip": [
  "^\\s*Code:\\s*$",
  "^\\s*LineNumberTable:\\s*$",
  "^\\s*Exception table:\\s*$",
  "^\\s*LocalVariableTable:\\s*$",
  "^\\}\\s*$"
 ],
 "blocks": [
  {
   "name": "source",
   "kind": "kv",
   "line": "^(?P<key>Compiled from) \\\"(?P<value>[^\\\"]+)\\\"\\s*$"
  },
  {
   "name": "class",
   "kind": "table",
   "line": "^(?P<modifiers>(?:(?:public|private|protected|static|final|abstract|synchronized|native|transient|volatile|strictfp|default) )*)(?P<kind>class|interface|enum|record|@interface) (?P<name>\\S+)(?: extends (?P<extends>\\S.*?))?(?: implements (?P<implements>\\S.*?))? \\{\\s*$",
   "columns": {
    "modifiers": "modifiers",
    "kind": "kind",
    "name": "name",
    "extends": "extends",
    "implements": "implements"
   }
  },
  {
   "name": "members",
   "kind": "table",
   "line": "^  (?P<modifiers>(?:(?:public|private|protected|static|final|abstract|synchronized|native|transient|volatile|strictfp|default) )*)(?:(?P<type>[\\w.$\\[\\]]+(?:<.*?>)?(?:\\[\\])*) )?(?P<name>[\\w.$<>]+)(?:\\((?P<parameters>[^)]*)\\))?(?: throws (?P<throws>\\S.*?))?;\\s*$",
   "columns": {
    "modifiers": "modifiers",
    "type": "type",
    "name": "name",
    "parameters": "parameters",
    "throws": "throws"
   }
  },
  {
   "name": "descriptors",
   "kind": "table",
   "line": "^\\s+descriptor: (?P<descriptor>\\S+)\\s*$",
   "columns": {
    "descriptor": "descriptor"
   }
  },
  {
   "name": "exception table",
   "kind": "table",
   "header": "^\\s+from\\s+to\\s+target\\s+type\\s*$",
   "line": "^\\s+(?P<from_>\\d+)\\s+(?P<to>\\d+)\\s+(?P<target>\\d+)\\s+(?P<type>\\S.*?)\\s*$",
   "columns": {
    "from_": "from",
    "to": "to",
    "target": "target",
    "type": "type"
   }
  },
  {
   "name": "line number table",
   "kind": "table",
   "line": "^\\s+line (?P<line>\\d+): (?P<offset>\\d+)\\s*$",
   "columns": {
    "line": "line",
    "offset": "offset"
   }
  },
  {
   "name": "bytecode",
   "kind": "table",
   "line": "^\\s+(?P<offset>\\d+): (?P<opcode>\\w+)(?:\\s+(?P<operands>[^\\s/](?:.*?\\S)?))?(?:\\s+// (?P<kind>\\w+) (?P<ref>\\S.*?))?\\s*$",
   "columns": {
    "offset": "offset",
    "opcode": "opcode",
    "operands": "operands",
    "kind": "kind",
    "ref": "ref"
   }
  }
 ]
}
