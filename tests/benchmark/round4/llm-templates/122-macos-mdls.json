{
 "format": 1,
 "tool": "macos-mdls",
 "detect": "^kMDItem\\w+\\s+= ",
 "skip": [
  "^\\)$"
 ],
 "blocks": [
  {
   "name": "attributes",
   "kind": "kv",
   "line": "^(?P<key>_?kMDItem\\w+)\\s+= (?:\\(|\\\"?(?P<value>.*?)\\\"?)\\s*$"
  },
  {
   "name": "list items",
   "kind": "table",
   "line": "^\\s+\\\"?(?P<item>.*?)\\\"?,?\\s*$",
   "columns": {
    "item": "item"
   }
  }
 ]
}
