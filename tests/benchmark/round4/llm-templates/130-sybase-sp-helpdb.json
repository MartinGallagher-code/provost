{
 "format": 1,
 "tool": "sybase-sp-helpdb",
 "detect": "^\\s*name\\s+db_size\\s+owner\\s+dbid\\s+created",
 "skip": [
  "^\\d+> ",
  "^\\s*-+(?:\\s+-+)*\\s*$",
  "^\\(\\d+ rows? affected\\)"
 ],
 "blocks": [
  {
   "name": "database",
   "kind": "table",
   "header": "^\\s*name\\s+db_size\\s+owner\\s+dbid",
   "line": "^\\s*(?P<name>\\S+)\\s+(?P<db_size>[\\d.]+ [KMGTP]?B)\\s+(?P<owner>\\S+)\\s+(?P<dbid>\\d+)\\s+(?P<created>[A-Z][a-z]{2} \\d{1,2}, \\d{4})\\s+(?P<durability>\\S+)\\s+(?P<lobcomplvl>\\S+)\\s+(?P<inrowlen>\\S+)(?:\\s+(?P<status>\\S(?:.*?\\S)?))?\\s*$",
   "columns": {
    "name": "name",
    "db_size": "db_size",
    "owner": "owner",
    "dbid": "dbid",
    "created": "created",
    "durability": "durability",
    "lobcomplvl": "lobcomplvl",
    "inrowlen": "inrowlen",
    "status": "status"
   }
  },
  {
   "name": "device_fragments",
   "kind": "table",
   "header": "^\\s*device_fragments\\s+size\\s+usage",
   "line": "^\\s*(?P<device_fragments>\\S+)\\s+(?P<size>[\\d.]+ [KMGTP]?B)\\s+(?P<usage>\\S(?:.*?\\S)?)\\s{2,}(?P<created>[A-Z][a-z]{2}\\s+\\d{1,2} \\d{4}\\s+\\d{1,2}:\\d\\d[AP]M)\\s+(?P<free_kbytes>\\d+)\\s*$",
   "columns": {
    "device_fragments": "device_fragments",
    "size": "size",
    "usage": "usage",
    "created": "created",
    "free_kbytes": "free kbytes"
   }
  },
  {
   "name": "summary",
   "kind": "kv",
   "line": "^\\s*\\(?(?P<key>[a-z][a-z ]*?)\\s*=\\s*(?P<value>\\S+?)\\)?\\s*$"
  },
  {
   "name": "segments",
   "kind": "table",
   "header": "^\\s*device\\s+segment\\s*$",
   "line": "^\\s*(?P<device>\\S+)\\s+(?P<segment>\\S+)\\s*$",
   "columns": {
    "device": "device",
    "segment": "segment"
   }
  }
 ]
}
