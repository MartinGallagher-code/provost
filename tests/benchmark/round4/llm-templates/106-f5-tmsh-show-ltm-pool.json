{
 "format": 1,
 "tool": "f5-tmsh-show-ltm-pool",
 "detect": "^\\s*Ltm::Pool: ",
 "skip": [
  "\\(tmos\\)# ",
  "^\\s*-{5,}\\s*$",
  "^\\s*Status\\s*$"
 ],
 "blocks": [
  {
   "name": "status",
   "kind": "kv",
   "line": "^\\s*(?P<key>[A-Za-z][A-Za-z: ]*?)\\s*: (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "traffic",
   "kind": "table",
   "header": "^\\s*Traffic\\s+ServerSide",
   "line": "^\\s+(?P<counter>[A-Za-z][A-Za-z ]*?)\\s{2,}(?P<serverside>\\S+)(?:\\s+(?P<general>\\S+))?\\s*$",
   "columns": {
    "counter": "Traffic",
    "serverside": "ServerSide",
    "general": "General"
   }
  }
 ]
}
