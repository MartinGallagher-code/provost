{
 "format": 1,
 "tool": "infocmp-terminfo",
 "detect": "^#\\s*Reconstructed via infocmp",
 "skip": [],
 "blocks": [
  {
   "name": "source",
   "kind": "kv",
   "line": "^#\\s*Reconstructed via infocmp from (?P<key>file): (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "terminal",
   "kind": "table",
   "line": "^(?P<name>[^\\s|,]+)(?:\\|(?P<aliases>.*?))?\\|(?P<description>[^|,]+),\\s*$",
   "columns": {
    "name": "name",
    "aliases": "aliases",
    "description": "description"
   }
  },
  {
   "name": "capabilities",
   "kind": "table",
   "line": "^\\s+(?P<capabilities>\\S.*?),?\\s*$",
   "columns": {
    "capabilities": "capabilities"
   }
  }
 ]
}
