{
 "format": 1,
 "tool": "kops-validate-cluster",
 "detect": "^Validating cluster \\S+$|^INSTANCE GROUPS$",
 "skip": [
  "^INSTANCE GROUPS$",
  "^NODE STATUS$",
  "^VALIDATION ERRORS$"
 ],
 "blocks": [
  {
   "name": "instance groups",
   "kind": "table",
   "header": "^NAME\\t+ROLE\\t+MACHINETYPE\\t+MIN\\t+MAX\\t+SUBNETS",
   "line": "^(?P<name>\\S+)\\t+(?P<role>\\S+)\\t+(?P<machinetype>\\S+)\\t+(?P<min>\\d+)\\t+(?P<max>\\d+)\\t+(?P<subnets>\\S+)\\s*$",
   "columns": {
    "name": "NAME",
    "role": "ROLE",
    "machinetype": "MACHINETYPE",
    "min": "MIN",
    "max": "MAX",
    "subnets": "SUBNETS"
   }
  },
  {
   "name": "node status",
   "kind": "table",
   "header": "^NAME\\t+ROLE\\t+READY",
   "line": "^(?P<name>\\S+)\\t+(?P<role>\\S+)\\t+(?P<ready>True|False)\\s*$",
   "columns": {
    "name": "NAME",
    "role": "ROLE",
    "ready": "READY"
   }
  },
  {
   "name": "validation errors",
   "kind": "table",
   "header": "^KIND\\t+NAME\\t+MESSAGE",
   "line": "^(?P<kind>\\S+)\\t+(?P<name>\\S+)\\t+(?P<message>\\S.*?)\\s*$",
   "columns": {
    "kind": "KIND",
    "name": "NAME",
    "message": "MESSAGE"
   }
  },
  {
   "name": "summary",
   "kind": "kv",
   "line": "^(?P<key>Using cluster from kubectl context|Validating cluster|Validation|Error|Your cluster)[: ]\\s*(?P<value>\\S.*?)\\s*$"
  }
 ]
}
