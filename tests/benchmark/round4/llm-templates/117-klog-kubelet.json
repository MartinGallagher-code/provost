{
 "format": 1,
 "tool": "klog-kubelet",
 "detect": "^[IWEF]\\d{4} \\d{2}:\\d{2}:\\d{2}\\.\\d+\\s+\\d+ \\S+\\.go:\\d+\\] .*[Kk]ubelet",
 "skip": [
  "^\\s*>$"
 ],
 "blocks": [
  {
   "name": "log lines",
   "kind": "table",
   "line": "^(?P<level>[IWEF])(?P<timestamp>\\d{4} \\d{2}:\\d{2}:\\d{2}\\.\\d+)\\s+(?P<pid>\\d+) (?P<source>\\S+\\.go:\\d+)\\] (?P<message>\\S.*?)\\s*$",
   "columns": {
    "level": "level",
    "timestamp": "timestamp",
    "pid": "pid",
    "source": "source",
    "message": "message"
   }
  },
  {
   "name": "continuation",
   "kind": "table",
   "line": "^\\t(?P<text>\\S.*?)\\s*$",
   "columns": {
    "text": "text"
   }
  }
 ]
}
