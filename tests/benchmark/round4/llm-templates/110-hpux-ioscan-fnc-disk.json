{
 "format": 1,
 "tool": "hpux-ioscan-fnc-disk",
 "detect": "^Class\\s+I\\s+H/W Path\\s+Driver",
 "skip": [
  "^=+\\s*$"
 ],
 "blocks": [
  {
   "name": "devices",
   "kind": "table",
   "header": "^Class\\s+I\\s+H/W Path\\s+Driver",
   "line": "^(?P<class>\\S+)\\s+(?P<instance>\\d+)\\s+(?P<hw_path>\\S+)\\s+(?P<driver>\\S+)\\s+(?P<sw_state>\\S+)\\s+(?P<hw_type>\\S+)\\s+(?P<description>\\S.*?)\\s*$",
   "columns": {
    "class": "Class",
    "instance": "I",
    "hw_path": "H/W Path",
    "driver": "Driver",
    "sw_state": "S/W State",
    "hw_type": "H/W Type",
    "description": "Description"
   }
  },
  {
   "name": "device_files",
   "kind": "table",
   "line": "^\\s+(?P<device_file>/dev/\\S+)(?:\\s+(?P<raw_device_file>/dev/\\S+))?\\s*$",
   "columns": {
    "device_file": "Device file",
    "raw_device_file": "Raw device file"
   }
  }
 ]
}
