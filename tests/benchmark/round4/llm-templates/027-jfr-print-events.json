{
 "format": 1,
 "tool": "jfr-print-events",
 "detect": "^[\\w.$]+ \\{$",
 "skip": [
  "^\\s*\\}\\s*$",
  "^\\s*\\]\\s*$",
  "^\\s*\\.\\.\\.\\s*$",
  "^\\s+\\w+ = \\[\\s*$"
 ],
 "blocks": [
  {
   "name": "events",
   "kind": "table",
   "line": "^(?P<event>[\\w.$]+) \\{\\s*$",
   "columns": {
    "event": "event"
   }
  },
  {
   "name": "stack frames",
   "kind": "table",
   "line": "^\\s{4,}(?P<frame>\\S.*?) line: (?P<line>\\d+)\\s*$",
   "columns": {
    "frame": "frame",
    "line": "line"
   }
  },
  {
   "name": "fields",
   "kind": "table",
   "line": "^\\s+(?P<field>\\w+) = (?P<value>\\S.*?)\\s*$",
   "columns": {
    "field": "field",
    "value": "value"
   }
  }
 ]
}
