{
 "format": 1,
 "tool": "podchecker-errors",
 "detect": "^\\*\\*\\* (?:ERROR|WARNING): .* at line \\d+ in file \\S+$",
 "skip": [],
 "blocks": [
  {
   "name": "diagnostics",
   "kind": "table",
   "line": "^\\*\\*\\* (?P<level>[A-Z]+): (?P<message>.*?) at line (?P<line>\\d+) in file (?P<file>\\S+)\\s*$"
  },
  {
   "name": "summary",
   "kind": "table",
   "line": "^(?P<file>\\S+) (?:has (?P<errors>\\d+) pod syntax errors?|pod syntax (?P<ok>OK))\\.\\s*$"
  }
 ]
}
