{
 "format": 1,
 "tool": "gitlab-ci-job-log",
 "detect": "^Running with gitlab-runner ",
 "skip": [
  "^[=_-]{3,} .* [=_-]{3,}$",
  "^[=_-]{5,}$",
  "^\\x1b\\[0K\\s*$"
 ],
 "blocks": [
  {
   "name": "sections",
   "kind": "table",
   "line": "^section_(?P<event>start|end):(?P<timestamp>\\d+):(?P<section>\\w+)(?:\\r?\\x1b\\[0K(?P<title>.*?))?\\s*$",
   "columns": {
    "event": "Event",
    "timestamp": "Timestamp",
    "section": "Section",
    "title": "Title"
   }
  },
  {
   "name": "section_titles",
   "kind": "table",
   "line": "^\\x1b\\[0K(?P<title>\\S.*?)\\s*$",
   "columns": {
    "title": "Title"
   }
  },
  {
   "name": "runner",
   "kind": "table",
   "line": "^Running with gitlab-runner (?P<version>\\S+) \\((?P<revision>\\w+)\\)\\s*$",
   "columns": {
    "version": "Version",
    "revision": "Revision"
   }
  },
  {
   "name": "runner_host",
   "kind": "table",
   "line": "^\\s+on (?P<runner>\\S+) (?P<token>\\S+), system ID: (?P<system_id>\\S+)\\s*$",
   "columns": {
    "runner": "Runner",
    "token": "Token",
    "system_id": "System ID"
   }
  },
  {
   "name": "result",
   "kind": "kv",
   "line": "^(?P<key>ERROR|WARNING): (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "commands",
   "kind": "table",
   "line": "^\\$ (?P<command>\\S.*?)\\s*$",
   "columns": {
    "command": "Command"
   }
  },
  {
   "name": "log",
   "kind": "table",
   "line": "^\\s*(?P<message>\\S.*?)\\s*$",
   "columns": {
    "message": "Message"
   }
  }
 ]
}
