{
  "format": 1,
  "tool": "windows-schtasks-query-list",
  "detect": "^TaskName:\\s{2,}",
  "skip": [],
  "blocks": [
    {
      "name": "folder",
      "kind": "kv",
      "line": "^(?P<key>Folder): (?P<value>\\S.*?)\\s*$"
    },
    {
      "name": "tasks",
      "kind": "kv",
      "line": "^(?P<key>\\S.*?):\\s*(?<=^.{38})(?P<value>\\S.*?)\\s*$"
    }
  ]
}
