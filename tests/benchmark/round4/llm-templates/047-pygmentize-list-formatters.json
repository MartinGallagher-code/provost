{
 "format": 1,
 "tool": "pygmentize-list-formatters",
 "detect": "^Pygments version \\d",
 "skip": [
  "^Pygments version \\d",
  "^(?:Formatters|Lexers|Filters|Styles):$",
  "^~+$"
 ],
 "blocks": [
  {
   "name": "formatters",
   "kind": "table",
   "line": "^\\* (?P<aliases>[^:]+):\\s*$"
  },
  {
   "name": "descriptions",
   "kind": "table",
   "line": "^\\s{4}(?P<description>\\S.*?)(?:\\s*\\(filenames (?P<filenames>[^)]+)\\))?\\s*$"
  }
 ]
}
