{
 "format": 1,
 "tool": "clang-ast-dump-filter",
 "detect": "^(?:[ |`]*[|`]-)?\\w+ 0x[0-9a-f]+ <",
 "skip": [
  "^Dumping \\S+:$",
  "^[ |`]*[|`]-<<<NULL>>>$"
 ],
 "blocks": [
  {
   "name": "nodes",
   "kind": "table",
   "line": "^(?:[ |`]*[|`]-)?(?P<kind>[A-Z]\\w+) (?P<address>0x[0-9a-f]+)(?: <(?P<range>.*?)>(?= |$))?(?: (?P<location>(?:line|col|\\S+\\.\\w+):\\d+(?::\\d+)?))?(?: (?P<detail>\\S.*))?$"
  }
 ]
}
