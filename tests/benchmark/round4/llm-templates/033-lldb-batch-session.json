{
  "format": 1,
  "tool": "lldb-batch-session",
  "detect": "^\\(lldb\\) ",
  "skip": [
    "^\\(lldb\\) ",
    "^\\([^)]*\\) \\{$",
    "^\\}$",
    "^\\s+\\t\\s*\\^$"
  ],
  "blocks": [
    {"name": "executable", "kind": "table",
     "line": "^Current executable set to '(?P<path>[^']*)' \\((?P<arch>[^)]*)\\)\\.$"},
    {"name": "breakpoints", "kind": "table",
     "line": "^Breakpoint (?P<id>[\\d.]+): where = (?P<where>\\S(?:.*?\\S)?), address = (?P<address>0x[0-9a-fA-F]+)\\s*$"},
    {"name": "process_events", "kind": "table",
     "line": "^Process (?P<pid>\\d+) (?P<event>[a-z]+)(?::? (?P<detail>\\S.*?))?\\s*$"},
    {"name": "threads", "kind": "table",
     "line": "^\\s*\\*?\\s*thread #(?P<thread>\\d+), name = '(?P<name>[^']*)', stop reason = (?P<stop_reason>\\S(?:.*?\\S)?)\\s*$"},
    {"name": "frames", "kind": "table",
     "line": "^\\s*(?P<selected>\\*)?\\s*frame #(?P<frame>\\d+): (?P<address>0x[0-9a-fA-F]+) (?P<module>[^`]+)`(?P<function>\\S(?:.*?\\S)?)(?: at (?P<location>\\S+))?\\s*$"},
    {"name": "source", "kind": "table",
     "line": "^(?P<marker>->)?\\s*(?P<lineno>\\d+)\\s+\\t(?P<code>.*)$",
     "columns": {"lineno": "line"}},
    {"name": "variables", "kind": "table",
     "line": "^\\((?P<type>[^)]*)\\) (?P<name>\\S+) = (?P<value>.*)$"},
    {"name": "struct_fields", "kind": "table",
     "line": "^\\s+(?P<field>\\w+) = (?P<value>.*)$"},
    {"name": "images", "kind": "table",
     "line": "^\\[\\s*(?P<index>\\d+)\\] (?P<image>\\S.*?)\\s*$"}
  ]
}
