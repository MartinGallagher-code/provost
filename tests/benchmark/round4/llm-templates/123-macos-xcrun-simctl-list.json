{
 "format": 1,
 "tool": "macos-xcrun-simctl-list",
 "detect": "^== Device Types ==$",
 "skip": [
  "^== .* ==$",
  "^-- .* --$"
 ],
 "blocks": [
  {
   "name": "device types",
   "kind": "table",
   "line": "^(?P<name>\\S.*?) \\((?P<identifier>com\\.apple\\.CoreSimulator\\.SimDeviceType\\.\\S+)\\)\\s*$",
   "columns": {
    "name": "name",
    "identifier": "identifier"
   }
  },
  {
   "name": "runtimes",
   "kind": "table",
   "line": "^(?P<name>\\S.*?) \\((?P<version>\\S+) - (?P<build>\\S+)\\) - (?P<identifier>com\\.apple\\.CoreSimulator\\.SimRuntime\\.\\S+)(?: \\((?P<availability>.*)\\))?\\s*$",
   "columns": {
    "name": "name",
    "version": "version",
    "build": "build",
    "identifier": "identifier",
    "availability": "availability"
   }
  },
  {
   "name": "device pair members",
   "kind": "table",
   "line": "^\\s+(?P<role>Watch|Phone): (?P<name>\\S.*?) \\((?P<udid>[0-9A-Fa-f-]{36})\\) \\((?P<state>[^)]*)\\)(?: \\((?P<availability>.*)\\))?\\s*$",
   "columns": {
    "role": "role",
    "name": "name",
    "udid": "udid",
    "state": "state",
    "availability": "availability"
   }
  },
  {
   "name": "devices",
   "kind": "table",
   "line": "^\\s+(?P<name>\\S.*?) \\((?P<udid>[0-9A-Fa-f-]{36})\\) \\((?P<state>[^)]*)\\)(?: \\((?P<availability>.*)\\))?\\s*$",
   "columns": {
    "name": "name",
    "udid": "udid",
    "state": "state",
    "availability": "availability"
   }
  },
  {
   "name": "device pairs",
   "kind": "table",
   "line": "^(?P<udid>[0-9A-Fa-f-]{36}) \\((?P<state>[^)]*)\\)\\s*$",
   "columns": {
    "udid": "udid",
    "state": "state"
   }
  }
 ]
}
