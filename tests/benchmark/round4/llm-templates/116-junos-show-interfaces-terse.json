{
 "format": 1,
 "tool": "junos-show-interfaces-terse",
 "detect": "^Interface\\s+Admin\\s+Link\\s+Proto\\s+Local\\s+Remote",
 "skip": [
  "^\\S+@\\S+> ",
  "^\\{[^}]*\\}$"
 ],
 "blocks": [
  {
   "name": "interfaces",
   "kind": "table",
   "header": "^Interface\\s+Admin\\s+Link\\s+Proto",
   "line": "^(?P<interface>\\S+)\\s+(?P<admin>up|down)\\s+(?P<link>up|down)(?:\\s+(?P<proto>[a-z][a-z0-9-]*))?(?:\\s+(?P<local>\\S*[./:]\\S*))?(?:\\s+-->\\s+(?P<remote>\\S+))?\\s*$",
   "columns": {
    "interface": "Interface",
    "admin": "Admin",
    "link": "Link",
    "proto": "Proto",
    "local": "Local",
    "remote": "Remote"
   }
  },
  {
   "name": "additional addresses",
   "kind": "table",
   "line": "^\\s+(?:(?P<proto>[a-z][a-z0-9-]*)(?=\\s|$))?\\s*(?:(?P<local>\\S*[./:]\\S*)(?:\\s+-->\\s+(?P<remote>\\S+))?)?\\s*$",
   "columns": {
    "proto": "Proto",
    "local": "Local",
    "remote": "Remote"
   }
  }
 ]
}
