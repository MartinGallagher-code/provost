{
  "format": 1,
  "tool": "jstack-thread-dump",
  "detect": "^Full thread dump ",
  "skip": [
    "^\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d$",
    "^Full thread dump ",
    "^Threads class SMR info:$",
    "^_java_thread_list=",
    "^(?:0x[0-9a-f]+,?\\s*)+$",
    "^\\}$",
    "^\\s+No compile task$"
  ],
  "blocks": [
    {"name": "threads", "kind": "table",
     "line": "^\"(?P<name>[^\"]*)\" #(?P<id>\\d+)(?: \\[(?P<pid>\\d+)\\])?(?: (?P<daemon>daemon))? prio=(?P<prio>\\d+) os_prio=(?P<os_prio>\\d+)(?: cpu=(?P<cpu>\\S+))?(?: elapsed=(?P<elapsed>\\S+))? tid=(?P<tid>0x[0-9a-f]+) nid=(?P<nid>\\S+) (?P<state>\\S(?:.*?\\S)?)\\s+\\[(?P<addr>0x[0-9a-f]+)\\]\\s*$"},
    {"name": "vm_threads", "kind": "table",
     "line": "^(?:\"(?P<name>[^\"]*)\"\\s+)?os_prio=(?P<os_prio>\\d+)(?: cpu=(?P<cpu>\\S+))?(?: elapsed=(?P<elapsed>\\S+))? tid=(?P<tid>0x[0-9a-f]+) nid=(?P<nid>\\S+) (?P<state>\\S(?:.*?\\S)?)\\s*$"},
    {"name": "thread_states", "kind": "table",
     "line": "^\\s+java\\.lang\\.Thread\\.State: (?P<state>\\S(?:.*?\\S)?)\\s*$",
     "columns": {"state": "java.lang.Thread.State"}},
    {"name": "frames", "kind": "table",
     "line": "^\\s+at (?P<method>\\S+)\\((?P<location>[^)]*)\\)\\s*$"},
    {"name": "monitors", "kind": "table",
     "line": "^\\s+- (?P<action>\\S(?:.*?\\S)?)\\s+<(?P<ref>[^>]*)>(?: \\(a (?P<class>[^)]*)\\))?\\s*$"},
    {"name": "jni_refs", "kind": "table",
     "line": "^JNI global refs: (?P<global_refs>\\d+), weak refs: (?P<weak_refs>\\d+)\\s*$"}
  ]
}
