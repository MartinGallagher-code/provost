{
  "format": 1,
  "tool": "perl-concise-optree",
  "detect": "\\s->\\(end\\)\\s*$",
  "skip": [],
  "blocks": [
    {"name": "syntax_check", "kind": "table",
     "line": "^(?P<file>\\S+) syntax OK\\s*$"},
    {"name": "ops", "kind": "table",
     "line": "^(?P<seq>\\w+|-)\\s+<(?P<class>[^>]+)>\\s+(?P<op>\\S(?:.*?\\S)?)\\s+(?P<flags>\\S+)\\s+->(?P<next>\\S+)\\s*$"}
  ]
}
