{
 "format": 1,
 "tool": "paloalto-show-session-all",
 "detect": "Src\\[Sport\\]/Zone/Proto",
 "skip": [
  "^-{10,}\\s*$",
  "^\\S+@\\S+> show session"
 ],
 "blocks": [
  {
   "name": "sessions",
   "kind": "table",
   "header": "^ID\\s+Application\\s+State\\s+Type\\s+Flag",
   "line": "^(?P<id>\\d+)\\s+(?P<application>\\S+)\\s+(?P<state>\\S+)\\s+(?P<type>\\S+)\\s+(?:(?P<flag>[A-Z]+)\\s+)?(?P<src>[^\\s\\[]+)\\[(?P<sport>\\d+)\\]/(?P<zone>[^\\s/]+)/(?P<proto>\\d+)\\s+\\((?P<translated_ip>[^\\s\\[]+)\\[(?P<translated_port>\\d+)\\]\\)\\s*$",
   "columns": {
    "id": "ID",
    "application": "Application",
    "state": "State",
    "type": "Type",
    "flag": "Flag",
    "src": "Src",
    "sport": "Sport",
    "zone": "Zone",
    "proto": "Proto",
    "translated_ip": "translated IP",
    "translated_port": "translated Port"
   }
  },
  {
   "name": "destinations",
   "kind": "table",
   "header": "^Vsys\\s+Dst\\[Dport\\]/Zone",
   "line": "^(?P<vsys>vsys\\S*)\\s+(?P<dst>[^\\s\\[]+)\\[(?P<dport>\\d+)\\]/(?P<zone>\\S+)\\s+\\((?P<translated_ip>[^\\s\\[]+)\\[(?P<translated_port>\\d+)\\]\\)\\s*$",
   "columns": {
    "vsys": "Vsys",
    "dst": "Dst",
    "dport": "Dport",
    "zone": "Zone",
    "translated_ip": "translated IP",
    "translated_port": "translated Port"
   }
  }
 ]
}
