{
  "format": 1,
  "tool": "fc-match-verbose",
  "detect": "^Pattern has \\d+ elts \\(size \\d+\\)",
  "skip": ["^\\([a-z]\\)$"],
  "blocks": [
    {"name": "pattern",
     "kind": "table",
     "line": "Pattern has (?P<elts>\\d+) elts \\(size (?P<size>\\d+)\\)",
     "columns": {"elts": "elts", "size": "size"}},
    {"name": "charset",
     "kind": "table",
     "line": "\\t(?P<page>[0-9a-f]{4}): (?P<bits>[0-9a-f]{8}(?: [0-9a-f]{8})*)",
     "columns": {"page": "page", "bits": "bits"}},
    {"name": "properties",
     "kind": "kv",
     "line": "\\t(?P<key>[a-z]+): \"?(?P<value>.*?)\"?(?:\\([a-z]\\))*\\s*"}
  ]
}
