{
 "format": 1,
 "tool": "juju-status",
 "detect": "^Model\\s+Controller\\s+Cloud/Region\\s+Version",
 "skip": [],
 "blocks": [
  {
   "name": "offers",
   "kind": "table",
   "header": "^Offer\\s+Application\\s+Charm\\s+",
   "line": "^(?P<offer>\\S+)\\s+(?P<application>\\S+)\\s+(?P<charm>\\S+)\\s+(?P<rev>\\d+)\\s+(?P<connected>\\d+/\\d+)\\s+(?P<endpoint>\\S+)\\s+(?P<interface>\\S+)\\s+(?P<role>\\S+)\\s*$",
   "columns": {
    "offer": "Offer",
    "application": "Application",
    "charm": "Charm",
    "rev": "Rev",
    "connected": "Connected",
    "endpoint": "Endpoint",
    "interface": "Interface",
    "role": "Role"
   }
  },
  {
   "name": "units",
   "kind": "table",
   "header": "^Unit\\s+Workload\\s+Agent\\s+",
   "line": "^(?P<unit>\\S+/\\d+)(?P<leader>\\*)?\\s+(?P<workload>\\S+)\\s+(?P<agent>\\S+)\\s+(?P<machine>\\S+)\\s+(?P<public_address>\\S+)(?:\\s+(?P<ports>\\S*/(?:tcp|udp)\\S*))?(?:\\s+(?P<message>\\S.*?))?\\s*$",
   "columns": {
    "unit": "Unit",
    "leader": "Leader",
    "workload": "Workload",
    "agent": "Agent",
    "machine": "Machine",
    "public_address": "Public address",
    "ports": "Ports",
    "message": "Message"
   }
  },
  {
   "name": "machines",
   "kind": "table",
   "header": "^Machine\\s+State\\s+Address\\s+",
   "line": "^(?P<machine>\\d+(?:/\\S+)?)\\s+(?P<state>\\S+)\\s+(?P<address>\\S+)\\s+(?P<inst_id>\\S+)\\s+(?P<base>\\S+@\\S+)\\s+(?P<az>\\S+)(?:\\s+(?P<message>\\S.*?))?\\s*$",
   "columns": {
    "machine": "Machine",
    "state": "State",
    "address": "Address",
    "inst_id": "Inst id",
    "base": "Base",
    "az": "AZ",
    "message": "Message"
   }
  },
  {
   "name": "apps",
   "kind": "table",
   "header": "^App\\s+Version\\s+Status\\s+Scale",
   "line": "^(?P<app>\\S+)\\s+(?:(?P<version>\\S+)\\s+)?(?P<status>\\S+)\\s+(?P<scale>\\d+)\\s+(?P<charm>\\S+)\\s+(?P<channel>\\S+/\\S+)\\s+(?P<rev>\\d+)\\s+(?P<exposed>yes|no)(?:\\s+(?P<message>\\S.*?))?\\s*$",
   "columns": {
    "app": "App",
    "version": "Version",
    "status": "Status",
    "scale": "Scale",
    "charm": "Charm",
    "channel": "Channel",
    "rev": "Rev",
    "exposed": "Exposed",
    "message": "Message"
   }
  },
  {
   "name": "model",
   "kind": "table",
   "header": "^Model\\s+Controller\\s+Cloud/Region\\s+Version",
   "line": "^(?P<model>\\S+)\\s+(?P<controller>\\S+)\\s+(?P<cloud_region>\\S+)\\s+(?P<version>\\S+)\\s+(?P<sla>\\S+)\\s+(?P<timestamp>\\S+)(?:\\s+(?P<notes>\\S.*?))?\\s*$",
   "columns": {
    "model": "Model",
    "controller": "Controller",
    "cloud_region": "Cloud/Region",
    "version": "Version",
    "sla": "SLA",
    "timestamp": "Timestamp",
    "notes": "Notes"
   }
  }
 ]
}
