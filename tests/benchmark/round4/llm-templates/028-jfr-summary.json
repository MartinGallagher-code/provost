{
 "format": 1,
 "tool": "jfr-summary",
 "detect": "^\\s*Event Type\\s+Count\\s+Size \\(bytes\\)",
 "skip": [
  "^=+\\s*$"
 ],
 "blocks": [
  {
   "name": "recording",
   "kind": "kv",
   "line": "^\\s*(?P<key>\\w+): (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "event types",
   "kind": "table",
   "header": "^\\s*Event Type\\s+Count\\s+Size \\(bytes\\)",
   "line": "^\\s*(?P<type>\\S+)\\s+(?P<count>\\d+)\\s+(?P<size>\\d+)\\s*$",
   "columns": {
    "type": "Event Type",
    "count": "Count",
    "size": "Size (bytes)"
   }
  }
 ]
}
