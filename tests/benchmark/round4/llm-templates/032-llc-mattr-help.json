{
  "format": 1,
  "tool": "llc-mattr-help",
  "detect": "^Available features for this target:$",
  "skip": [
    "^Use \\+feature to enable a feature",
    "^For example, llc "
  ],
  "blocks": [
    {"name": "cpus", "kind": "table",
     "header": "^Available CPUs for this target:$",
     "line": "^\\s+(?P<cpu>\\S+)\\s+- (?P<description>Select the \\S+ processor\\.)\\s*$"},
    {"name": "features", "kind": "table",
     "header": "^Available features for this target:$",
     "line": "^\\s+(?P<feature>\\S+)\\s+- (?P<description>\\S(?:.*?\\S)?)\\s*$"}
  ]
}
