{
 "format": 1,
 "tool": "pg-test-timing",
 "detect": "^Histogram of timing durations:$",
 "skip": [
  "^Histogram of timing durations:$"
 ],
 "blocks": [
  {
   "name": "histogram",
   "kind": "table",
   "header": "^\\s*< us\\s+% of total\\s+count\\s*$",
   "line": "^\\s*(?P<lt_us>\\d+)\\s+(?P<pct>[\\d.]+)\\s+(?P<count>\\d+)\\s*$",
   "columns": {
    "lt_us": "< us",
    "pct": "% of total",
    "count": "count"
   }
  },
  {
   "name": "summary",
   "kind": "kv",
   "line": "^(?P<key>[^:]+?)(?::| for)\\s+(?P<value>\\S.*?)\\.?\\s*$"
  }
 ]
}
