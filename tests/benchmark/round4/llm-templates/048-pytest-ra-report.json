{
 "format": 1,
 "tool": "pytest-ra-report",
 "detect": "^=+ test session starts =+$",
 "skip": [
  "^=+ (?:test session starts|FAILURES|ERRORS|PASSES|warnings summary|short test summary info) =+$"
 ],
 "blocks": [
  {
   "name": "session",
   "kind": "kv",
   "line": "^(?P<key>platform|rootdir|configfile|cachedir|plugins|collected)(?::| ) ?(?P<value>\\S.*?)(?: items?)?\\s*$"
  },
  {
   "name": "progress",
   "kind": "table",
   "line": "^(?P<file>\\S+) (?P<results>[.FEsxX]+)\\s+\\[\\s*(?P<percent>\\d+%)\\]$"
  },
  {
   "name": "results",
   "kind": "table",
   "line": "^(?P<outcome>PASSED|FAILED|ERROR|SKIPPED|XFAIL|XPASS)(?: \\[(?P<count>\\d+)\\])? (?P<test>\\S+?):?(?:(?: -)? (?P<message>\\S.*?))?\\s*$"
  },
  {
   "name": "summary",
   "kind": "table",
   "line": "^=+ (?P<summary>\\S.*?) in (?P<duration>[\\d.]+s) =+$"
  },
  {
   "name": "test_sections",
   "kind": "table",
   "line": "^_+ (?P<test>\\S.*?) _+$"
  },
  {
   "name": "captured",
   "kind": "table",
   "line": "^-+ Captured (?P<stream>\\w+) (?P<phase>\\w+) -+$"
  },
  {
   "name": "log",
   "kind": "table",
   "line": "^(?P<level>DEBUG|INFO|WARNING|ERROR|CRITICAL)\\s+(?P<logger>\\S+?):(?P<file>[^:\\s]+):(?P<line>\\d+) (?P<message>\\S.*?)\\s*$"
  },
  {
   "name": "errors",
   "kind": "table",
   "line": "^E\\s+(?P<error>\\S.*?)\\s*$"
  },
  {
   "name": "location",
   "kind": "table",
   "line": "^(?P<file>\\S+):(?P<line>\\d+): (?P<exception>\\S.*?)\\s*$"
  },
  {
   "name": "source",
   "kind": "table",
   "line": "^(?P<marker>>)?\\s{3,}(?P<code>\\S.*?)\\s*$"
  }
 ]
}
