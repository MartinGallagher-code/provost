{
 "format": 1,
 "tool": "firebird-isql-show-table",
 "detect": "^SQL> SHOW TABLE ",
 "skip": [
  "^SQL> ",
  "^Triggers on Table \\S+:\\s*$",
  "^\\s{8,}\\S"
 ],
 "blocks": [
  {
   "name": "triggers",
   "kind": "table",
   "line": "^(?P<trigger>\\S+), Sequence: (?P<sequence>\\d+), Type: (?P<type>[A-Z ]+?), (?P<status>Active|Inactive)\\s*$",
   "columns": {
    "trigger": "Trigger",
    "sequence": "Sequence",
    "type": "Type",
    "status": "Status"
   }
  },
  {
   "name": "constraints",
   "kind": "table",
   "line": "^CONSTRAINT (?P<constraint>\\S+):\\s*$",
   "columns": {
    "constraint": "Constraint"
   }
  },
  {
   "name": "constraint_definitions",
   "kind": "table",
   "line": "^\\s{1,4}(?P<kind>Foreign key|Primary key|Unique key|CHECK)\\s+(?P<columns>\\([^)]*\\))(?:\\s+(?P<clause>\\S.*?))?\\s*$",
   "columns": {
    "kind": "Kind",
    "columns": "Columns",
    "clause": "Clause"
   }
  },
  {
   "name": "columns",
   "kind": "table",
   "line": "^(?P<column>\\S+)\\s{2,}(?P<type>\\S.*?)\\s+(?P<nullability>Not Null|Nullable)(?:\\s+DEFAULT\\s+(?P<default>\\S.*?))?\\s*$",
   "columns": {
    "column": "Column",
    "type": "Type",
    "nullability": "Nullability",
    "default": "Default"
   }
  }
 ]
}
