{
  "format": 1,
  "tool": "llvm-readobj-headers",
  "detect": "^ElfHeader \\{$",
  "skip": [
    "^\\s*[\\w ]+ [\\[{]$",
    "^\\s*[\\]}]$"
  ],
  "blocks": [
    {"name": "section_fields", "kind": "table",
     "line": "^ {4}(?P<field>Index|Name|Type|Address|Offset|Size|Link|Info|AddressAlignment|EntrySize):\\s*(?P<value>.*?)\\s*$"},
    {"name": "flags", "kind": "table",
     "line": "^\\s*Flags \\[ \\((?P<flags>0x[0-9A-Fa-f]+)\\)\\s*$"},
    {"name": "flag_bits", "kind": "table",
     "line": "^\\s+(?P<flag>[A-Z][A-Z0-9_]+) \\((?P<value>0x[0-9A-Fa-f]+)\\)\\s*$"},
    {"name": "file", "kind": "kv",
     "line": "^(?P<key>[\\w/]+):\\s*(?P<value>.*?)\\s*$"},
    {"name": "elf_header", "kind": "kv",
     "line": "^ {2,4}(?P<key>[\\w/]+):\\s*(?P<value>.*?)\\s*$"}
  ]
}
