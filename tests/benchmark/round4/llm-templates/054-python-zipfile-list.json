{
  "format": 1,
  "tool": "python-zipfile-list",
  "detect": "^File Name\\s+Modified\\s+Size\\s*$",
  "skip": [],
  "blocks": [
    {
      "name": "members",
      "kind": "table",
      "header": "^File Name\\s+Modified\\s+Size\\s*$",
      "line": "^(?P<name>\\S(?:.*?\\S)?)\\s+(?P<modified>\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d)\\s+(?P<size>\\d+)\\s*$",
      "columns": {
        "name": "File Name",
        "modified": "Modified",
        "size": "Size"
      }
    }
  ]
}
