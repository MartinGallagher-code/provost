{
  "format": 1,
  "tool": "systemd-delta",
  "detect": "^\\[(EXTENDED|OVERRIDDEN|EQUIVALENT|REDIRECTED|MASKED|UNCHANGED)\\]\\s+/",
  "skip": [
    "^(--- |\\+\\+\\+ |@@ )",
    "^[ +-]"
  ],
  "blocks": [
    {
      "name": "files",
      "kind": "table",
      "line": "^\\[(?P<status>[A-Z]+)\\]\\s+(?P<file>\\S+)(?:\\s+(?:\\u2192|->)\\s+(?P<other>\\S+))?\\s*$",
      "columns": {
        "status": "status",
        "file": "file",
        "other": "other file"
      }
    },
    {
      "name": "summary",
      "kind": "table",
      "line": "^(?P<overridden>\\d+) overridden configuration files? found\\.$",
      "columns": {
        "overridden": "overridden configuration files"
      }
    }
  ]
}
