{
  "format": 1,
  "tool": "ruby-dump-insns",
  "detect": "^== disasm: #<ISeq:",
  "skip": [
    "^== catch table",
    "^\\| catch type:",
    "^\\[ *\\d+\\] \\S+@\\d+"
  ],
  "blocks": [
    {
      "name": "iseqs",
      "kind": "table",
      "line": "^== disasm: #<ISeq:(?P<iseq>.*?)@(?P<file>.+?):(?P<line>\\d+) (?P<range>\\(\\d+,\\d+\\)-\\(\\d+,\\d+\\))>$",
      "columns": {
        "iseq": "iseq",
        "file": "file",
        "line": "line",
        "range": "range"
      }
    },
    {
      "name": "local_tables",
      "kind": "table",
      "line": "^local table \\(size: (?P<size>-?\\d+), argc: (?P<argc>-?\\d+) \\[opts: (?P<opts>-?\\d+), rest: (?P<rest>-?\\d+), post: (?P<post>-?\\d+), block: (?P<block>-?\\d+), kw: (?P<kw>-?\\d+@-?\\d+), kwrest: (?P<kwrest>-?\\d+)\\]\\)$",
      "columns": {
        "size": "size",
        "argc": "argc",
        "opts": "opts",
        "rest": "rest",
        "post": "post",
        "block": "block",
        "kw": "kw",
        "kwrest": "kwrest"
      }
    },
    {
      "name": "instructions",
      "kind": "table",
      "line": "^(?P<offset>\\d{4}) (?P<insn>\\S+)(?:\\s+(?!(?:\\(\\s*\\d+\\))?(?:\\[[A-Za-z]+\\])?\\s*$)(?P<operands>\\S.*?))?(?:\\s*\\(\\s*(?P<line>\\d+)\\))?(?:\\s*\\[(?P<events>[A-Za-z]+)\\])?\\s*$",
      "columns": {
        "offset": "offset",
        "insn": "insn",
        "operands": "operands",
        "line": "line",
        "events": "events"
      }
    }
  ]
}
