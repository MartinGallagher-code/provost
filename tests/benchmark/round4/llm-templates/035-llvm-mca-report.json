{
  "format": 1,
  "tool": "llvm-mca-report",
  "detect": "^Block RThroughput:",
  "skip": [
    "^Instruction Info:$",
    "^Resources:$",
    "^Resource pressure per iteration:$",
    "^Resource pressure by instruction:$"
  ],
  "blocks": [
    {"name": "instruction_info", "kind": "table",
     "header": "^\\[1\\]\\s+\\[2\\]\\s+.*Instructions:\\s*$",
     "line": "^(?P<uops> *\\d+ *)(?P<latency> *\\d+ *)(?P<rthroughput> *(?:[\\d.]+|-) *)(?P<mayload>[ *]{7})(?P<maystore>[ *]{7})(?P<sideeffects>[ *UI]{7})(?P<instruction>[A-Za-z]\\S*(?:\\s.*?)?)\\s*$",
     "columns": {"uops": "#uOps", "latency": "Latency", "rthroughput": "RThroughput", "mayload": "MayLoad", "maystore": "MayStore", "sideeffects": "HasSideEffects", "instruction": "Instructions"}},
    {"name": "instruction_info_legend", "kind": "table",
     "line": "^\\[(?P<column>\\d+)\\]: (?P<meaning>\\S(?:.*?\\S)?)\\s*$"},
    {"name": "resources", "kind": "table",
     "line": "^\\[(?P<index>\\d+)\\]\\s+- (?P<resource>\\S+)\\s*$"},
    {"name": "summary", "kind": "kv",
     "line": "^(?P<key>[A-Za-z][\\w ]*?):\\s+(?P<value>\\S.*?)\\s*$"},
    {"name": "pressure_by_instruction", "kind": "table",
     "header": "^\\[0\\]\\s+\\[1\\]\\s+.*Instructions:\\s*$",
     "line": "^(?P<pressures>(?:\\s*(?:[\\d.]+|-))+)\\s+(?P<instruction>[A-Za-z]\\S*(?:\\s.*?)?)\\s*$"},
    {"name": "pressure_per_iteration", "kind": "table",
     "header": "^\\[0\\]\\s+\\[1\\]\\s+(?:\\[\\d+\\]\\s*)+$",
     "line": "^(?P<pressures>(?:\\s*(?:[\\d.]+|-))+)\\s*$"}
  ]
}
