{
 "format": 1,
 "tool": "windows-bcdedit-enum",
 "detect": "^identifier\\s{2,}\\{",
 "skip": [
  "^-{5,}\\s*$"
 ],
 "blocks": [
  {
   "name": "entries",
   "kind": "table",
   "header": "^[A-Z][A-Za-z]*(?: [A-Za-z]+)+\\s*$",
   "line": "^(?:(?P<setting>[a-z][a-z0-9]*)\\s+|\\s{2,})(?P<value>\\S(?:.*?\\S)?)\\s*$",
   "columns": {
    "setting": "setting",
    "value": "value"
   }
  }
 ]
}
