{
  "format": 1,
  "tool": "windows-whoami-priv",
  "detect": "^PRIVILEGES INFORMATION\\s*$",
  "skip": ["^PRIVILEGES INFORMATION\\s*$", "^-{5,}\\s*$", "^=+(?: =+)+\\s*$"],
  "blocks": [
    {"name": "privileges",
     "kind": "table",
     "header": "^Privilege Name\\s+Description\\s+State\\s*$",
     "line": "^(?P<name>\\S+)\\s+(?P<description>\\S(?:.*?\\S)?)\\s+(?P<state>\\S+)\\s*$",
     "columns": {"name": "Privilege Name", "description": "Description", "state": "State"}}
  ]
}
