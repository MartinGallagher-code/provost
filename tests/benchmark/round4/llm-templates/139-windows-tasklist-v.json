{
  "format": 1,
  "tool": "windows-tasklist-v",
  "detect": "^Image Name\\s+PID\\s+Session Name\\s+Session#\\s+Mem Usage\\s+Status\\s+User Name\\s+CPU Time\\s+Window Title",
  "skip": [
    "^=+(?: =+)+\\s*$"
  ],
  "blocks": [
    {
      "name": "processes",
      "kind": "table",
      "header": "^Image Name\\s+PID\\s+Session Name\\s+Session#\\s+Mem Usage\\s+Status\\s+User Name\\s+CPU Time\\s+Window Title",
      "line": "^(?P<image>.{25})\\s+(?P<pid>\\d+)\\s+(?P<session>\\S+)\\s+(?P<sessionno>\\d+)\\s+(?P<mem>\\S+ K) (?P<status>.{15}) (?P<user>\\S(?:.*?\\S)?)\\s+(?P<cpu>\\d+:\\d\\d:\\d\\d) (?P<title>\\S.*?)\\s*$",
      "columns": {
        "image": "Image Name",
        "pid": "PID",
        "session": "Session Name",
        "sessionno": "Session#",
        "mem": "Mem Usage",
        "status": "Status",
        "user": "User Name",
        "cpu": "CPU Time",
        "title": "Window Title"
      }
    }
  ]
}
