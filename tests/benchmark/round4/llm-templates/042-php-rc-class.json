{
 "format": 1,
 "tool": "php-rc-class",
 "detect": "^Class \\[ <[^>]*> (?:\\w+ )*class \\S+.* \\] \\{$",
 "skip": [
  "^\\s*\\}\\s*$",
  "^\\s*- Parameters \\[\\d+\\] \\{\\s*$"
 ],
 "blocks": [
  {
   "name": "class",
   "kind": "table",
   "line": "^Class \\[ <(?P<source>[^>]*)>(?: (?P<modifiers>.*?))? class (?P<name>\\S+)(?: (?P<inheritance>(?:extends|implements) .*?))? \\] \\{\\s*$"
  },
  {
   "name": "sections",
   "kind": "table",
   "line": "^\\s*- (?P<section>[A-Z][A-Za-z ]*?) \\[(?P<count>\\d+)\\] \\{\\s*$"
  },
  {
   "name": "methods",
   "kind": "table",
   "line": "^\\s*Method \\[ <(?P<source>[^>]*)>(?: (?P<modifiers>.*?))? method (?P<name>\\S+) \\] \\{\\s*$"
  },
  {
   "name": "parameters",
   "kind": "table",
   "line": "^\\s*Parameter #(?P<index>\\d+) \\[ <(?P<requirement>\\w+)>(?: (?P<type>[^$\\s]\\S*))? (?P<name>(?:\\.\\.\\.)?&?\\$\\w+)(?: = (?P<default>.*?))? \\]\\s*$"
  },
  {
   "name": "returns",
   "kind": "table",
   "line": "^\\s*- (?P<kind>Tentative return|Return) \\[ (?P<type>.*?) \\]\\s*$"
  }
 ]
}
