{
  "format": 1,
  "tool": "dircolors-database",
  "detect": "^# Configuration file for dircolors",
  "skip": ["^\\s*#"],
  "blocks": [
    {"name": "terminals",
     "kind": "table",
     "line": "(?P<key>COLORTERM|TERM)\\s+(?P<pattern>\\S+)",
     "columns": {"key": "key", "pattern": "pattern"}},
    {"name": "colors",
     "kind": "table",
     "line": "(?P<key>\\S+)\\s+(?P<color>\\S+)(?:\\s*#\\s*(?P<comment>.*))?",
     "columns": {"key": "key", "color": "color", "comment": "comment"}}
  ]
}
