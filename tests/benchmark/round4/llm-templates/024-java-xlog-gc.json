{
 "format": 1,
 "tool": "java-xlog-gc",
 "detect": "^\\[[^\\]]+\\]\\[\\w+\\]\\[gc[\\w,]*\\s*\\] ",
 "skip": [],
 "blocks": [
  {
   "name": "gc pauses",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc\\s*\\] GC\\((?P<gc>\\d+)\\) (?P<pause>\\S.*?) (?P<before>\\d+[KMGT]?)->(?P<after>\\d+[KMGT]?)\\((?P<heap>\\d+[KMGT]?)\\) (?P<duration>[\\d.]+ms)\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "gc": "gc",
    "pause": "pause",
    "before": "before",
    "after": "after",
    "heap": "heap",
    "duration": "duration"
   }
  },
  {
   "name": "gc phases",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc,phases\\s*\\] GC\\((?P<gc>\\d+)\\)\\s+(?P<phase>\\S[^:]*?): (?P<time>[\\d.]+ms)\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "gc": "gc",
    "phase": "phase",
    "time": "time"
   }
  },
  {
   "name": "gc heap regions",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc,heap\\s*\\] GC\\((?P<gc>\\d+)\\) (?P<region>\\S.*?) regions: (?P<before>\\d+)->(?P<after>\\d+)(?:\\((?P<target>\\d+)\\))?\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "gc": "gc",
    "region": "region",
    "before": "before",
    "after": "after",
    "target": "target"
   }
  },
  {
   "name": "gc metaspace",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc,metaspace\\s*\\] GC\\((?P<gc>\\d+)\\) Metaspace: (?P<metaspace>\\S+) NonClass: (?P<nonclass>\\S+) Class: (?P<class_>\\S+)\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "gc": "gc",
    "metaspace": "Metaspace",
    "nonclass": "NonClass",
    "class_": "Class"
   }
  },
  {
   "name": "gc cpu",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc,cpu\\s*\\] GC\\((?P<gc>\\d+)\\) User=(?P<user>[\\d.]+s) Sys=(?P<sys>[\\d.]+s) Real=(?P<real>[\\d.]+s)\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "gc": "gc",
    "user": "User",
    "sys": "Sys",
    "real": "Real"
   }
  },
  {
   "name": "gc init",
   "kind": "kv",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[gc,init\\s*\\] (?P<key>[^:]+): (?P<value>\\S.*?)\\s*$"
  },
  {
   "name": "gc log",
   "kind": "table",
   "line": "^\\[(?P<uptime>[^\\]]+)\\]\\[(?P<level>\\w+)\\]\\[(?P<tags>[\\w,]+)\\s*\\] (?:GC\\((?P<gc>\\d+)\\) )?(?P<message>\\S.*?)\\s*$",
   "columns": {
    "uptime": "uptime",
    "level": "level",
    "tags": "tags",
    "gc": "gc",
    "message": "message"
   }
  }
 ]
}
