{
 "format": 1,
 "tool": "mssql-sp-who2",
 "detect": "^SPID\\s+Status\\s+Login\\s+HostName\\s+BlkBy\\s+DBName",
 "skip": [
  "^-{3,}(?:\\s+-+)+\\s*$"
 ],
 "blocks": [
  {
   "name": "sessions",
   "kind": "table",
   "header": "^SPID\\s+Status\\s+Login\\s+HostName",
   "line": "^(?P<spid>\\d+)\\s+(?P<status>\\S+)\\s+(?P<login>\\S+)\\s+(?P<hostname>\\S+)\\s+(?P<blkby>\\S+)\\s+(?P<dbname>\\S+)\\s+(?P<command>\\S(?:.*?\\S)?)\\s+(?P<cputime>\\d+)\\s+(?P<diskio>\\d+)\\s+(?P<lastbatch>\\d\\d/\\d\\d \\d\\d:\\d\\d:\\d\\d)(?:\\s+(?P<programname>\\S(?:.*?\\S)?))?\\s+(?P<spid2>\\d+)\\s+(?P<requestid>\\d+)\\s*$",
   "columns": {
    "spid": "SPID",
    "status": "Status",
    "login": "Login",
    "hostname": "HostName",
    "blkby": "BlkBy",
    "dbname": "DBName",
    "command": "Command",
    "cputime": "CPUTime",
    "diskio": "DiskIO",
    "lastbatch": "LastBatch",
    "programname": "ProgramName",
    "spid2": "SPID2",
    "requestid": "REQUESTID"
   }
  }
 ]
}
