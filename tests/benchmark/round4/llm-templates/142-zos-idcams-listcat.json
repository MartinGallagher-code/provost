{
  "format": 1,
  "tool": "zos-idcams-listcat",
  "detect": "^.?IDCAMS\\s+SYSTEM SERVICES\\s+TIME:",
  "skip": [
    "^.?IDCAMS\\s+SYSTEM SERVICES\\s+TIME:",
    "^[01]\\s*$",
    "^\\s+LISTC(?:AT)?\\b",
    "^\\s+[A-Z]+\\s*$",
    "^.?\\s+THE NUMBER OF ENTRIES PROCESSED WAS:\\s*$",
    "^\\s+SHROPTNS\\("
  ],
  "blocks": [
    {"name": "entries",
     "kind": "table",
     "line": "^[01 -]?\\s*(?P<type>[A-Z]+) -+ (?P<name>\\S+)\\s*$",
     "columns": {"type": "Type", "name": "Entry"}},
    {"name": "entries processed",
     "kind": "kv",
     "line": "^\\s+(?P<key>[A-Z]+) -+(?P<value>\\d+)\\s*$"},
    {"name": "suppressed",
     "kind": "kv",
     "line": "^.?\\s+THE NUMBER OF (?P<key>[A-Z ]+?) WAS (?P<value>\\d+)\\s*$"},
    {"name": "messages",
     "kind": "table",
     "line": "^.?(?P<msgid>IDC\\d{4}[A-Z]) (?P<text>\\S.*?)\\s*$",
     "columns": {"msgid": "Message", "text": "Text"}},
    {"name": "attributes",
     "kind": "table",
     "line": "^\\s+(?P<key1>[A-Z][A-Z0-9/%]*(?:-[A-Z0-9/%]+)*)(?: ?-{2,} ?(?P<value1>\\S+)|:)(?:\\s+(?P<key2>[A-Z][A-Z0-9/%]*(?:-[A-Z0-9/%]+)*)(?: ?-{2,} ?(?P<value2>\\S+)|:))?(?:\\s+(?P<key3>[A-Z][A-Z0-9/%]*(?:-[A-Z0-9/%]+)*)(?: ?-{2,} ?(?P<value3>\\S+)|:))?(?:\\s+(?P<key4>[A-Z][A-Z0-9/%]*(?:-[A-Z0-9/%]+)*)(?: ?-{2,} ?(?P<value4>\\S+)|:))?(?:\\s+(?P<timestamp>X'[0-9A-F]*'))?\\s*$",
     "columns": {"key1": "key1", "value1": "value1", "key2": "key2", "value2": "value2", "key3": "key3", "value3": "value3", "key4": "key4", "value4": "value4", "timestamp": "timestamp"}}
  ]
}
