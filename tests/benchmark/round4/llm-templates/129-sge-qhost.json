{
 "format": 1,
 "tool": "sge-qhost",
 "detect": "^HOSTNAME\\s+ARCH\\s+NCPU\\s+NSOC\\s+NCOR\\s+NTHR\\s+LOAD\\s+MEMTOT",
 "skip": [
  "^-{20,}\\s*$"
 ],
 "blocks": [
  {
   "name": "hosts",
   "kind": "table",
   "header": "^HOSTNAME\\s+ARCH\\s+NCPU",
   "line": "^(?P<hostname>\\S+)\\s+(?P<arch>\\S+)\\s+(?P<ncpu>\\S+)\\s+(?P<nsoc>\\S+)\\s+(?P<ncor>\\S+)\\s+(?P<nthr>\\S+)\\s+(?P<load>\\S+)\\s+(?P<memtot>\\S+)\\s+(?P<memuse>\\S+)\\s+(?P<swapto>\\S+)\\s+(?P<swapus>\\S+)\\s*$",
   "columns": {
    "hostname": "HOSTNAME",
    "arch": "ARCH",
    "ncpu": "NCPU",
    "nsoc": "NSOC",
    "ncor": "NCOR",
    "nthr": "NTHR",
    "load": "LOAD",
    "memtot": "MEMTOT",
    "memuse": "MEMUSE",
    "swapto": "SWAPTO",
    "swapus": "SWAPUS"
   }
  }
 ]
}
