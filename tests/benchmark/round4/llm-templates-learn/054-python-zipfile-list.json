{
 "format": 1,
 "tool": "python-zipfile-list",
 "detect": "^File Name\\s+Modified\\s+Size\\s*$",
 "skip": [],
 "blocks": [
  {
   "name": "entries",
   "kind": "table",
   "header": "^File Name\\s+Modified\\s+Size\\s*$",
   "line": "^(?P<name>\\S(?:.*?\\S)?)\\s+(?P<modified>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})\\s+(?P<size>\\d+)\\s*$",
   "columns": {
    "name": "File Name",
    "modified": "Modified",
    "size": "Size"
   }
  }
 ],
 "examples": [
  "File Name                                             Modified             Size\ndocs/                                          2026-10-20 22:23:38            0\ndocs/pr├╝fbericht.txt                          2026-10-19 08:15:00           13\ndocs/stock list.csv                            2026-10-19 08:15:00           17\ndocs/numbers.txt                               2026-10-19 08:15:00        13893\nrun.sh                                         2026-10-19 08:15:00           18\nempty/                                         2026-10-19 08:15:00            0"
 ]
}
