{
 "format": 1,
 "tool": "pg-test-timing",
 "detect": "^(?:Testing timing overhead for|Histogram of timing durations:)",
 "skip": [
  "^Testing timing overhead for",
  "^Histogram of timing durations:"
 ],
 "blocks": [
  {
   "name": "histogram",
   "kind": "table",
   "header": "^\\s*<\\s*us\\s+%\\s+of\\s+total\\s+count\\s*$",
   "line": "^\\s*(?P<us>\\d+)\\s+(?P<pct>[\\d.]+)\\s+(?P<count>\\d+)\\s*$",
   "columns": {
    "us": "< us",
    "pct": "% of total",
    "count": "count"
   }
  },
  {
   "name": "summary",
   "kind": "kv",
   "line": "^(?P<key>Per loop time including overhead):\\s*(?P<value>[\\d.]+\\s*\\S+)\\s*$"
  }
 ],
 "examples": [
  "Testing timing overhead for 2 seconds.\nPer loop time including overhead: 34.52 ns\nHistogram of timing durations:\n  < us   % of total      count\n     1     96.74485   56056229\n     2      3.23507    1874476\n     4      0.01111       6436\n     8      0.00362       2095\n    16      0.00233       1349\n    32      0.00243       1406\n    64      0.00040        232\n   128      0.00012         69\n   256      0.00004         26\n   512      0.00002         10\n  1024      0.00001          5\n  2048      0.00000          1\n  4096      0.00000          1\n  8192      0.00000          1\n 16384      0.00000          1"
 ]
}
