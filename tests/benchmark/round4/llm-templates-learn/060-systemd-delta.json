{
 "format": 1,
 "tool": "systemd-delta",
 "detect": "^\\[(?:EXTENDED|OVERRIDDEN|MASKED|EQUIVALENT|REDIRECTED|UNCHANGED)\\]|overridden configuration files found",
 "skip": [],
 "blocks": [
  {
   "name": "entries",
   "kind": "table",
   "line": "^\\[(?P<type>[A-Z]+)\\]\\s+(?P<path>\\S(?:.*?\\S)?)(?:\\s+(?:→|->)\\s+(?P<target>\\S(?:.*?\\S)?))?\\s*$",
   "columns": {
    "type": "Type",
    "path": "Path",
    "target": "Target"
   }
  },
  {
   "name": "summary",
   "kind": "kv",
   "line": "^(?P<value>\\d+)\\s+(?P<key>overridden configuration files found)\\.?\\s*$"
  }
 ],
 "examples": [
  "[EXTENDED]   /usr/lib/systemd/system/rc-local.service → /usr/lib/systemd/system/rc-local.service.d/debian.conf\n[EXTENDED]   /usr/lib/systemd/system/systemd-journald.service → /usr/lib/systemd/system/systemd-journald.service.d/nice.conf\n[EXTENDED]   /usr/lib/systemd/system/systemd-localed.service → /usr/lib/systemd/system/systemd-localed.service.d/x11-keyboard.conf\n[EXTENDED]   /usr/lib/systemd/system/systemd-logind.service → /usr/lib/systemd/system/systemd-logind.service.d/dbus.conf\n[EXTENDED]   /usr/lib/systemd/system/user@.service → /usr/lib/systemd/system/user@.service.d/10-login-barrier.conf\n[EXTENDED]   /usr/lib/systemd/system/user@.service → /usr/lib/systemd/system/user@.service.d/timeout.conf\n\n6 overridden configuration files found."
 ]
}
