{
 "format": 1,
 "tool": "redis-cli-stat",
 "detect": "^keys\\s+mem\\s+clients\\s+blocked\\s+requests\\s+connections",
 "skip": [
  "^-+\\s+data\\s+-+"
 ],
 "blocks": [
  {
   "name": "stats",
   "kind": "table",
   "header": "^keys\\s+mem\\s+clients",
   "line": "^\\s*(?P<keys>\\d+)\\s+(?P<mem>[\\d.]+[KMGTB]?)\\s+(?P<clients>\\d+)\\s+(?P<blocked>\\d+)\\s+(?P<requests>\\d+\\s+\\([+-]?\\d+\\))\\s+(?P<connections>\\d+)(?:\\s+(?P<child>\\S(?:.*?\\S)?))?\\s*$",
   "columns": {
    "keys": "keys",
    "mem": "mem",
    "clients": "clients",
    "blocked": "blocked",
    "requests": "requests",
    "connections": "connections",
    "child": "child"
   }
  }
 ],
 "examples": [
  "------- data ------ --------------------- load -------------------- - child -\nkeys       mem      clients blocked requests            connections          \n383        1.57M    2       0       4652 (+0)           209         \n433        1.55M    1       0       10838 (+6186)       394         \n433        1.55M    1       0       11054 (+216)        609         \n433        1.55M    1       0       11055 (+1)          609         \n433        1.55M    1       0       11056 (+1)          609         \n433        1.55M    1       0       11057 (+1)          609         \n433        1.55M    1       0       11058 (+1)          609         "
 ]
}
