{
 "format": 2,
 "tool": "clang-ftime-report",
 "detect": "^\\s*-{2,}User Time-{2,}.*-{2,}\\s*Name\\s*-{2,}\\s*$",
 "parser": "import re\n\ndef parse(lines):\n    rule = re.compile(r'^===-+===\\s*$')\n    hdr = re.compile(r'^\\s*-{2,}.*-{2,}\\s*Name\\s*-{2,}\\s*$')\n    tot = re.compile(r'^\\s*Total Execution Time:\\s*(?P<cpu>[\\d.]+ seconds)\\s*\\((?P<wall>[\\d.]+) wall clock\\)\\s*$')\n    row = re.compile(r'^\\s*(?P<vals>(?:[\\d.]+\\s+\\(\\s*[\\d.]+%\\)\\s+)+)(?P<name>\\S.*?)\\s*$')\n    cell = re.compile(r'([\\d.]+)\\s+\\(\\s*([\\d.]+%)\\)')\n    skip = []\n    section = ''\n    cols = []\n    trows = []\n    tlines = []\n    xrows = []\n    xlines = []\n    n = len(lines)\n    for i, l in enumerate(lines):\n        if not l.strip():\n            continue\n        if rule.match(l):\n            skip.append(i)\n            continue\n        if i > 0 and i + 1 < n and rule.match(lines[i - 1]) and rule.match(lines[i + 1]):\n            section = l.strip()\n            skip.append(i)\n            continue\n        m = tot.match(l)\n        if m:\n            xrows.append({'Section': section, 'Total Execution Time': m.group('cpu'), 'Wall Clock': m.group('wall')})\n            xlines.append(i)\n            continue\n        if hdr.match(l):\n            cols = [c for c in re.findall(r'-{2,}\\s*([^-]+?)\\s*-{2,}', l) if c != 'Name']\n            skip.append(i)\n            continue\n        m = row.match(l)\n        if m:\n            vals = cell.findall(m.group('vals'))\n            rec = {'Section': section, 'Name': m.group('name')}\n            for j, vp in enumerate(vals):\n                c = cols[j] if j < len(cols) else 'Col%d' % j\n                rec[c] = vp[0]\n                rec[c + ' %'] = vp[1]\n            trows.append(rec)\n            tlines.append(i)\n    keys = []\n    for r in trows:\n        for k in r:\n            if k not in keys:\n                keys.append(k)\n    norm = []\n    for r in trows:\n        norm.append({k: r.get(k, '') for k in keys})\n    blocks = []\n    if xrows:\n        blocks.append({'name': 'execution_totals', 'kind': 'table', 'lines': xlines, 'records': xrows})\n    if norm:\n        blocks.append({'name': 'timers', 'kind': 'table', 'lines': tlines, 'records': norm})\n    return {'blocks': blocks, 'skip': skip}\n",
