{
 "format": 1,
 "tool": "sybase-sp-helpdb",
 "detect": "^\\s*name\\s+db_size\\s+owner\\s+dbid\\s+created",
 "skip": [
  "^\\d+>\\s",
  "^\\s*\\(\\d+ rows? affected\\)",
  "^\\s*\\(return status = -?\\d+\\)",
  "^\\s*-[- ]*$",
  "^\\s*$"
 ],
 "blocks": [
  {
   "name": "database",
   "kind": "table",
   "header": "^\\s*name\\s+db_size\\s+owner\\s+dbid\\s+created",
   "line": "^\\s*(?P<name>\\S+)\\s+(?P<db_size>[\\d.]+\\s+[KMGT]B)\\s+(?P<owner>\\S+)\\s+(?P<dbid>\\d+)\\s+(?P<created>[A-Z][a-z]{2}\\s+\\d{1,2},\\s+\\d{4})\\s+(?P<durability>\\S+)\\s+(?P<lobcomplvl>\\d+)\\s+(?P<inrowlen>\\S+)(?:\\s+(?P<status>\\S(?:.*?\\S)?))?\\s*$",
   "columns": {
    "name": "name",
    "db_size": "db_size",
    "owner": "owner",
    "dbid": "dbid",
    "created": "created",
    "durability": "durability",
    "lobcomplvl": "lobcomplvl",
    "inrowlen": "inrowlen",
    "status": "status"
   }
  },
  {
   "name": "device_fragments",
   "kind": "table",
   "header": "^\\s*device_fragments\\s+size\\s+usage",
   "line": "^\\s*(?P<device_fragments>\\S+)\\s+(?P<size>[\\d.]+\\s+[KMGT]B)\\s+(?P<usage>\\S(?:.*?\\S)?)\\s{2,}(?P<created>[A-Z][a-z]{2}\\s+\\d{1,2}\\s+\\d{4}\\s+\\d{1,2}:\\d{2}[AP]M)\\s+(?P<free_kbytes>\\d+)\\s*$",
   "columns": {
    "device_fragments": "device_fragments",
    "size": "size",
    "usage": "usage",
    "created": "created",
    "free_kbytes": "free kbytes"
   }
  },
  {
   "name": "log_free",
   "kind": "kv",
   "line": "^\\s*(?P<key>log only free kbytes)\\s*=\\s*(?P<value>\\S+)\\s*$"
  },
  {
   "name": "segments",
   "kind": "table",
   "header": "^\\s*device\\s+segment\\s*$",
   "line": "^\\s*(?P<device>\\S+)\\s+(?P<segment>\\S+)\\s*$",
   "columns": {
    "device": "device",
    "segment": "segment"
   }
  }
 ],
 "examples": [
  "1> sp_helpdb pubs2\n2> go\n name    db_size       owner    dbid   created              durability  lobcomplvl inrowlen status                                                   \n ------- ------------- -------- ------ -------------------- ----------- ---------- -------- -------------------------------------------------------- \n pubs2        120.0 MB sa            4 Oct 02, 2026         full                 0     NULL trunc log on chkpt, mixed log and data                    \n\n(1 row affected)\n device_fragments               size          usage                created                   free kbytes                    \n ------------------------------ ------------- -------------------- ------------------------- ------------------------------ \n pubsdev                              80.0 MB data and log         Oct  2 2026  9:14AM                                75264 \n pubsdev2                             40.0 MB data and log         Oct 14 2026  4:02PM                                40800 \n                                                                                                                                       \n --------------------------------------------------------------------------------------------------------------------------------------\n log only free kbytes = 0                                                                                                               \n device                         segment                        \n ------------------------------ ------------------------------ \n pubsdev                        default                        \n pubsdev                        logsegment                     \n pubsdev                        system                         \n pubsdev2                       default                        \n(return status = 0)"
 ]
}
