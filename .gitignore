# provost runtime store (created on first capture; default ./.provost or ~/.provost)
.provost/
PROVOST_WORKSPACE/

# Local backup snapshots
*.bak

# Python cache (if any tooling runs here)
__pycache__/
*.pyc

# Python packaging / test artifacts
/dist/
# Anchored to the root: extract/strategies/build/ holds real strategies, and a
# bare `build/` silently ignored new files there.
/build/
*.egg-info/
.coverage
.pytest_cache/

# Node deps for the review-workbook generator. tests/corpus/make_review_doc.js
# documents `docx` as "not vendored here" — you `npm install docx` when you need
# to build a workbook, and npm scaffolds package.json/package-lock.json as a
# side effect. All three are local build artifacts, not project files.
node_modules/
package.json
package-lock.json
site/

# Agent worktrees
.claude/worktrees/

# Generated on demand, never committed: whole-tree bundles (see CLAUDE.md)
# and the corpus review snapshot (tests/corpus/review-snapshot.sh).
bundle.txt
tests/corpus/review-output/

# Layout-model training sets and checkpoints: regenerated by ml/corpus_labels.py,
# ml/synth.py and ml/train_*.py (see ml/README.md), never committed.
ml/data/
ml/models/
