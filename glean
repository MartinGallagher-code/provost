#!/usr/bin/env bash
#
# glean — turn command output into data.
#
# PHASE-1 PROTOTYPE (proposal 0001). Implements the product's one path:
#
#     cmd | glean            capture stdin → auto-detect format → present as a
#                            tidy, one-row-per-record dataset, filed by type.
#
# This prototype wires the *real* extract engine (all 198 strategies) via its
# `--emit-meta` contract, then melts + stores. The store here is deliberately
# MINIMAL — flat TSV files under a workspace dir, no git branches and no schema
# reconciliation. Those (and `stats`) are Phase 3 per the proposal; this file's
# job is to prove the surface end-to-end.
#
# Verbs implemented in Phase 1:
#     glean            (default) inject stdin/FILE into a typed dataset
#     glean ls         list datasets (name, rows)
#     glean show NAME  present a dataset as a tidy table
#     glean triage     show the low-confidence / unmatched bucket
#     glean doctor     check the extract engine is reachable
#     glean help
#
set -euo pipefail

GLEAN_VERSION="0.3.0-proto"

# ---------------------------------------------------------------------------
# Config (env-overridable; GLEAN_* is the post-rename namespace)
# ---------------------------------------------------------------------------
GLEAN_WORKSPACE="${GLEAN_WORKSPACE:-$PWD/.glean}"
GLEAN_MIN_CONFIDENCE="${GLEAN_MIN_CONFIDENCE:-50}"
GLEAN_MAX_INPUT="${GLEAN_MAX_INPUT:-10485760}"   # 10 MiB
GLEAN_TEMP_DIR="${TMPDIR:-/tmp}"

# ---------------------------------------------------------------------------
# Tiny UI helpers
# ---------------------------------------------------------------------------
_is_tty () { [[ -t 2 ]]; }
if _is_tty; then C_OK=$'\033[32m'; C_DIM=$'\033[2m'; C_ERR=$'\033[31m'; C_RST=$'\033[0m'
else C_OK=""; C_DIM=""; C_ERR=""; C_RST=""; fi
info () { [[ "${GLEAN_QUIET:-0}" -eq 1 ]] || printf '%s\n' "$*" >&2; }
ok ()   { [[ "${GLEAN_QUIET:-0}" -eq 1 ]] || printf '%s ok%s %s\n' "$C_OK" "$C_RST" "$*" >&2; }
die ()  { printf '%serror%s %s\n' "$C_ERR" "$C_RST" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Locate the extract engine.
#   Phase 2: the engine is vendored at glean/extract/ (see tools/sync-extract.sh)
#   with its shared libs at glean/lib/ (the engine's ../lib). This is the
#   canonical copy. The sibling-EnvoyExtract walk-up remains only as a
#   transition fallback until the Phase-5 hard cut removes EnvoyExtract/.
# ---------------------------------------------------------------------------
_find_engine () {
    local here script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local candidates=(
        "${GLEAN_HOME:-}/extract/envoy-extract"
        "$script_dir/extract/envoy-extract"       # vendored (canonical)
    )
    # Walk up looking for a sibling EnvoyExtract/ (transition fallback).
    here="$script_dir"
    while [[ "$here" != "/" ]]; do
        candidates+=("$here/EnvoyExtract/envoy-extract")
        here="$(dirname "$here")"
    done
    candidates+=("$(command -v envoy-extract 2>/dev/null || true)")
    local c
    for c in "${candidates[@]}"; do
        [[ -n "$c" && -f "$c" ]] && { printf '%s\n' "$c"; return 0; }
    done
    return 1
}

# ---------------------------------------------------------------------------
# Tidy melt — reshape one wide `entry<N>.<field>` extract row into one row per
# record (ported from EnvoyCapture lib/_core.sh `_core_melt_tidy`). Input and
# output are both TSV on stdin/stdout. Header+1row that isn't a single indexed
# table passes through unchanged.
# ---------------------------------------------------------------------------
_melt_tidy () {
    awk -F'\t' -v OFS='\t' '
        { L[NR]=$0 }
        NR==1 { nf=NF; for(i=1;i<=NF;i++) H[i]=$i }
        NR==2 { for(i=1;i<=nf;i++) V[i]=$i }
        END {
          if (NR!=2) { for(r=1;r<=NR;r++) print L[r]; exit }
          np=0; nfld=0; nidx=0; nsc=0
          for(i=1;i<=nf;i++){
            h=H[i]; d=index(h,"."); isgroup=0
            if (d>1){
              left=substr(h,1,d-1); field=substr(h,d+1)
              if (match(left,/[0-9]+$/)){
                num=substr(left,RSTART)+0; pref=substr(left,1,RSTART-1)
                if (pref!=""){
                  isgroup=1
                  if(!(pref in seenp)){seenp[pref]=1; np++}
                  key=num SUBSEP field; cell[key]=V[i]
                  if(!(num in seenix)){seenix[num]=1; idxs[++nidx]=num}
                  if(!(field in seenf)){seenf[field]=1; flds[++nfld]=field}
                }
              }
            }
            if(!isgroup) scalidx[++nsc]=i
          }
          if (np!=1 || nfld==0){ print L[1]; print L[2]; exit }
          for(a=1;a<=nidx;a++) for(b=a+1;b<=nidx;b++) if(idxs[b]<idxs[a]){t=idxs[a];idxs[a]=idxs[b];idxs[b]=t}
          hdr="n"
          for(k=1;k<=nfld;k++) hdr=hdr OFS flds[k]
          for(s=1;s<=nsc;s++) hdr=hdr OFS H[scalidx[s]]
          print hdr
          for(a=1;a<=nidx;a++){ ix=idxs[a]; row=ix
            for(k=1;k<=nfld;k++){key=ix SUBSEP flds[k]; row=row OFS ((key in cell)?cell[key]:"")}
            for(s=1;s<=nsc;s++) row=row OFS V[scalidx[s]]
            print row }
        }'
}

_ds_dir ()  { printf '%s/datasets\n' "$GLEAN_WORKSPACE"; }
_cap_dir () { printf '%s/captures\n' "$GLEAN_WORKSPACE"; }

# git wrapper — pinned identity + no signing, so commits work in any environment.
_git () { git -C "$GLEAN_WORKSPACE" -c user.name=glean -c user.email=glean@localhost -c commit.gpgsign=false "$@"; }

# The workspace is a git repo: every capture is one commit (tagged capture-NNNN),
# so a run can be brought back up later with `glean restore`.
_ensure_workspace () {
    mkdir -p "$(_ds_dir)" "$(_cap_dir)"
    if [[ ! -d "$GLEAN_WORKSPACE/.git" ]]; then
        _git init -q
        printf 'glean workspace\n' > "$GLEAN_WORKSPACE/.gleanrc"
        _git add -A >/dev/null 2>&1
        _git commit -q -m "glean: init workspace" >/dev/null 2>&1 || true
        _git branch -M main >/dev/null 2>&1 || true
    fi
}

# Zero-padded next capture id from the count of existing capture dirs.
_next_capture_id () {
    local dir n; dir="$(_cap_dir)"
    n=$(find "$dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
    printf 'c%04d\n' "$((n + 1))"
}

# Append tidy TSV (header+rows) to a dataset file. Store rule:
#   header matches existing → append data rows; new → write header+rows;
#   header differs → split into a numbered variant (.v2, .v3, …).
# Echoes "<final-dataset-name>\t<row-count>" (single line) on stdout.
_store_append () {
    local name="$1" tsv="$2" dir; dir="$(_ds_dir)"
    local base="$dir/$name.tsv" target="$name" file
    file="$base"
    local new_header; new_header="$(printf '%s\n' "$tsv" | head -1)"
    if [[ -f "$base" ]]; then
        local old_header; old_header="$(head -1 "$base")"
        if [[ "$old_header" != "$new_header" ]]; then
            local v=2
            while [[ -f "$dir/$name.v$v.tsv" ]] && \
                  [[ "$(head -1 "$dir/$name.v$v.tsv")" != "$new_header" ]]; do
                v=$((v+1))
            done
            target="$name.v$v"; file="$dir/$target.tsv"
        fi
    fi
    if [[ -f "$file" ]]; then
        printf '%s\n' "$tsv" | tail -n +2 >> "$file"
    else
        printf '%s\n' "$tsv" > "$file"
    fi
    local rows; rows=$(( $(wc -l < "$file") - 1 )); [[ $rows -lt 0 ]] && rows=0
    printf '%s\t%s\n' "$target" "$rows"
}

# Core ingest pipeline shared by `inject` (pipe/file) and `run` (a command).
#   $1 input file  $2 threshold  $3 source (inject|run)  $4 cmd ("" for inject)
#   $5 rc ("" for inject)
# Extracts → classifies → melts → stores → records a capture → commits.
_ingest () {
    local in="$1" threshold="$2" source="$3" cmd="${4:-}" rc="${5:-}"
    local engine; engine="$(_find_engine)" \
        || die "extract engine not found. Set GLEAN_HOME or keep EnvoyExtract/ reachable."

    local tmp; tmp="$(mktemp -d "$GLEAN_TEMP_DIR/glean.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" RETURN
    local metaf="$tmp/meta.txt" wide meta strategy conf
    wide="$(env -u GIT_DIR bash "$engine" --max-input-size "$GLEAN_MAX_INPUT" \
            --emit-meta -f tsv --max-strategies 1 "$in" 2>"$metaf")" || true
    meta="$(grep '^__EXTRACT_META__' "$metaf" 2>/dev/null | tail -1 || true)"
    strategy="$(printf '%s' "$meta" | awk -F'\t' '{print $2}')"
    conf="$(printf '%s' "$meta" | awk -F'\t' '{print $3}')"
    [[ "$conf" =~ ^[0-9]+$ ]] || conf=0

    local final rows fields reason=""
    if [[ -z "$strategy" || -z "$wide" ]]; then reason="no-match"
    elif [[ "$conf" -lt "$threshold" ]]; then reason="low-confidence ($conf<$threshold)"; fi

    if [[ -n "$reason" ]]; then
        local r; r="$(_store_append "unsorted" "$(printf 'raw\n%s' \
            "$(base64 -w0 < "$in" 2>/dev/null || base64 < "$in" | tr -d '\n')")")"
        final="unsorted"; rows="${r##*$'\t'}"; fields=1; strategy="${strategy:-none}"
    else
        local tidy result
        tidy="$(printf '%s\n' "$wide" | _melt_tidy)"
        fields="$(printf '%s\n' "$tidy" | head -1 | awk -F'\t' '{print NF}')"
        result="$(_store_append "$strategy" "$tidy")"
        final="${result%%$'\t'*}"; rows="${result##*$'\t'}"
    fi

    # Record the capture and commit it (one commit == one capture).
    local id capd ts; id="$(_next_capture_id)"; capd="$(_cap_dir)/$id"; mkdir -p "$capd"
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cp "$in" "$capd/output.txt"
    {
        printf 'id\t%s\n' "$id"
        printf 'ts\t%s\n' "$ts"
        printf 'source\t%s\n' "$source"
        printf 'command\t%s\n' "$cmd"
        printf 'rc\t%s\n' "$rc"
        printf 'strategy\t%s\n' "$strategy"
        printf 'confidence\t%s\n' "$conf"
        printf 'dataset\t%s\n' "$final"
        printf 'rows_total\t%s\n' "$rows"
    } > "$capd/meta.tsv"

    _git add -A >/dev/null 2>&1
    local msg="capture $id: $source $strategy → $final"
    [[ -n "$cmd" ]] && msg="$msg ($cmd)"
    _git commit -q -m "$msg" >/dev/null 2>&1 || true
    _git tag -f "capture-$id" >/dev/null 2>&1 || true

    if [[ -n "$reason" ]]; then
        info "$id: $reason — queued in 'unsorted' for triage (committed)."
    else
        ok "$id: → dataset '$final' (strategy $strategy, conf $conf) — $fields field(s), $rows row(s) total."
    fi
}

# ---------------------------------------------------------------------------
# Default verb: inject (pipe or file)
# ---------------------------------------------------------------------------
cmd_inject () {
    local file="" threshold="$GLEAN_MIN_CONFIDENCE"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--silent) GLEAN_QUIET=1; shift ;;
            --min-confidence) threshold="${2:?--min-confidence needs a number}"; shift 2 ;;
            -h|--help) cmd_help; return 0 ;;
            -*) die "unknown option: $1" ;;
            *) file="$1"; shift ;;
        esac
    done

    _ensure_workspace
    local tmp; tmp="$(mktemp -d "$GLEAN_TEMP_DIR/glean.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT INT TERM
    local in="$tmp/in.txt"
    if [[ -n "$file" ]]; then
        [[ -f "$file" ]] || die "no such file: $file"
        tr -d '\r' < "$file" > "$in"
    else
        head -c "$((GLEAN_MAX_INPUT + 1))" | tr -d '\r' > "$in"
    fi
    [[ -s "$in" ]] || die "no input to glean (empty)."
    [[ "$(wc -c < "$in")" -le "$GLEAN_MAX_INPUT" ]] \
        || die "input too large (max $GLEAN_MAX_INPUT bytes; raise GLEAN_MAX_INPUT)."

    _ingest "$in" "$threshold" "inject" "" ""
}

# ---------------------------------------------------------------------------
# run — execute a command, capture its output as a commit, and ingest it.
# ---------------------------------------------------------------------------
cmd_run () {
    local threshold="$GLEAN_MIN_CONFIDENCE"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -q|--silent) GLEAN_QUIET=1; shift ;;
            --min-confidence) threshold="${2:?--min-confidence needs a number}"; shift 2 ;;
            -h|--help) cmd_help; return 0 ;;
            --) shift; break ;;
            -*) die "unknown option: $1" ;;
            *) break ;;
        esac
    done
    [[ $# -gt 0 ]] || die "usage: glean run [--] <command> [args...]"

    _ensure_workspace
    local tmp; tmp="$(mktemp -d "$GLEAN_TEMP_DIR/glean.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT INT TERM
    local in="$tmp/in.txt" rc=0
    # Capture combined stdout+stderr (the thing you'd otherwise eyeball).
    "$@" > "$in" 2>&1 || rc=$?
    tr -d '\r' < "$in" > "$in.clean" && mv "$in.clean" "$in"
    local cmd="$*"
    [[ -s "$in" ]] || { info "command produced no output (rc=$rc) — nothing captured."; return "$rc"; }
    _ingest "$in" "$threshold" "run" "$cmd" "$rc"
    return "$rc"
}

# ---------------------------------------------------------------------------
# log / restore — the git core: list captures, bring one back up.
# ---------------------------------------------------------------------------
cmd_log () {
    _ensure_workspace
    shopt -s nullglob
    local d id ts src strat ds rc any=0
    printf '%-6s %-20s %-7s %-14s %-12s %s\n' "ID" "WHEN" "SOURCE" "STRATEGY" "DATASET" "COMMAND" >&2
    for d in $(printf '%s\n' "$(_cap_dir)"/*/ | sort); do
        [[ -f "$d/meta.tsv" ]] || continue
        any=1
        id=$(awk -F'\t' '$1=="id"{print $2}' "$d/meta.tsv")
        ts=$(awk -F'\t' '$1=="ts"{print $2}' "$d/meta.tsv")
        src=$(awk -F'\t' '$1=="source"{print $2}' "$d/meta.tsv")
        strat=$(awk -F'\t' '$1=="strategy"{print $2}' "$d/meta.tsv")
        ds=$(awk -F'\t' '$1=="dataset"{print $2}' "$d/meta.tsv")
        local cmd; cmd=$(awk -F'\t' '$1=="command"{print $2}' "$d/meta.tsv")
        printf '%-6s %-20s %-7s %-14s %-12s %s\n' "$id" "$ts" "$src" "$strat" "$ds" "$cmd"
    done
    [[ $any -eq 1 ]] || info "no captures yet — run 'glean run <cmd>' or pipe into 'glean'."
}

cmd_restore () {
    _ensure_workspace
    local target="${1:?usage: glean restore <capture-id|latest>}"
    if [[ "$target" == "latest" ]]; then
        _git checkout -q main 2>/dev/null \
            && ok "restored workspace to latest (main)." \
            || die "could not return to latest."
        return 0
    fi
    [[ "$target" == capture-* ]] || target="capture-$target"
    _git rev-parse -q --verify "refs/tags/$target" >/dev/null 2>&1 \
        || die "no such capture: ${target#capture-} (see 'glean log')."
    # Bring that capture's committed tree back up (detached).
    _git checkout -q "$target" 2>/dev/null \
        || die "checkout failed for $target."
    ok "brought up ${target#capture-} (detached). Return with: glean restore latest"
    local capd; capd="$(_cap_dir)/${target#capture-}"
    [[ -f "$capd/meta.tsv" ]] && { echo; sed 's/\t/: /' "$capd/meta.tsv"; }
}

# ---------------------------------------------------------------------------
# ls / show / triage / doctor
# ---------------------------------------------------------------------------
cmd_ls () {
    local dir; dir="$(_ds_dir)"
    [[ -d "$dir" ]] || { info "no datasets yet — pipe something into 'glean'."; return 0; }
    shopt -s nullglob
    local f name rows any=0
    printf '%-24s %8s\n' "DATASET" "ROWS" >&2
    for f in "$dir"/*.tsv; do
        any=1; name="$(basename "$f" .tsv)"
        rows=$(( $(wc -l < "$f") - 1 )); [[ $rows -lt 0 ]] && rows=0
        printf '%-24s %8d\n' "$name" "$rows"
    done
    [[ $any -eq 1 ]] || info "no datasets yet — pipe something into 'glean'."
}

cmd_show () {
    local name="${1:?usage: glean show NAME}"
    local f; f="$(_ds_dir)/$name.tsv"
    [[ -f "$f" ]] || die "no such dataset: $name (try 'glean ls')."
    if command -v column >/dev/null 2>&1; then column -t -s $'\t' "$f"
    else cat "$f"; fi
}

cmd_triage () {
    local f; f="$(_ds_dir)/unsorted.tsv"
    [[ -f "$f" ]] || { info "triage queue empty — nothing unmatched."; return 0; }
    info "unsorted rows (low-confidence / no-match), base64-encoded raw input:"
    cat "$f"
}

cmd_doctor () {
    local engine
    if engine="$(_find_engine)"; then
        printf '%s ok%s extract engine: %s\n' "$C_OK" "$C_RST" "$engine"
    else
        printf '%serror%s extract engine not found\n' "$C_ERR" "$C_RST"; return 1
    fi
    printf '   workspace: %s' "$GLEAN_WORKSPACE"
    [[ -d "$GLEAN_WORKSPACE/.git" ]] && printf ' (git-backed)'; printf '\n'
    printf '   min-confidence: %s\n' "$GLEAN_MIN_CONFIDENCE"
}

cmd_help () {
    cat >&2 <<EOF
glean $GLEAN_VERSION — turn command output into data

USAGE
    glean run [--] <cmd> [args...]                capture a command's output as a
                                                 commit, auto-detect + file it
    cmd | glean [--silent] [--min-confidence N]   inject stdin into a typed dataset
    glean [FILE]                                  inject a file instead of stdin
    glean log                                     list captures (the git history)
    glean restore <id|latest>                     bring a capture's commit back up
    glean ls                                      list datasets
    glean show NAME                               present a dataset as a tidy table
    glean triage                                  show low-confidence / unmatched bucket
    glean doctor                                  check engine + workspace
    glean help

GIT CORE
    The workspace is a git repo; every 'run'/inject is one commit tagged
    capture-<id>. 'glean log' lists them; 'glean restore <id>' checks that
    commit's tree back out; 'glean restore latest' returns to the tip.

ENV
    GLEAN_WORKSPACE        workspace/git dir (default: ./.glean)
    GLEAN_MIN_CONFIDENCE   commit threshold 0-100 (default: 50)
    GLEAN_MAX_INPUT        max input bytes (default: 10485760)

Not yet in this prototype (proposal 0001, Phase 3 cont.): 'stats' (analyze core)
and schema reconciliation. See docs/proposals/0001-glean-rename-and-simplification.md.
EOF
}

# ---------------------------------------------------------------------------
# Dispatch — bare invocation (or a leading option / FILE) means inject.
# ---------------------------------------------------------------------------
main () {
    local verb="${1:-}"
    case "$verb" in
        run)           shift; cmd_run "$@" ;;
        log)           shift; cmd_log "$@" ;;
        restore)       shift; cmd_restore "$@" ;;
        ls)            shift; cmd_ls "$@" ;;
        show)          shift; cmd_show "$@" ;;
        triage)        shift; cmd_triage "$@" ;;
        doctor)        shift; cmd_doctor "$@" ;;
        help|-h|--help) cmd_help ;;
        -V|--version)  printf 'glean %s\n' "$GLEAN_VERSION" ;;
        inject)        shift; cmd_inject "$@" ;;   # explicit alias
        *)             cmd_inject "$@" ;;          # default verb
    esac
}
main "$@"
