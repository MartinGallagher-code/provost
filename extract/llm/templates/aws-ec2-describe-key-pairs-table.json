 "parser": "import re\n\ndef parse(lines):\n    recs = []\n    rec_lines = []\n    tags = []\n    tag_lines = []\n    skip = []\n    section = None\n    cur = None\n    for i, l in enumerate(lines):\n        s = l.strip()\n        if not s:\n            continue\n        m = re.match(r'^(\\|*)(.*?)(\\|*)$', s)\n        depth = len(m.group(1))\n        inner = m.group(2).strip()\n        if not re.search(r'[A-Za-z0-9]', inner):\n            skip.append(i)\n            continue\n        cells = [c.strip() for c in inner.split('|')]\n        if len(cells) == 1:\n            if depth <= 1:\n                skip.append(i)\n            elif cells[0] == 'Tags':\n                section = 'Tags'\n                tag_lines.append(i)\n            else:\n                section = 'rec'\n                cur = {}\n                recs.append(cur)\n                rec_lines.append(i)\n            continue\n        key = cells[0]\n        val = '|'.join(cells[1:]).strip()\n        if section == 'Tags':\n            tag_lines.append(i)\n            if key == 'Key' and val == 'Value':\n                continue\n            tags.append((len(recs) - 1, key, val))\n        else:\n            if cur is None:\n                cur = {}\n                recs.append(cur)\n            cur[key] = val\n            rec_lines.append(i)\n    order = []\n    for r in recs:\n        for k in r:\n            if k not in order:\n                order.append(k)\n    rows = [{k: r.get(k, '') for k in order} for r in recs]\n    trows = []\n    for idx, k, v in tags:\n        name = recs[idx].get('KeyName', '') if idx >= 0 else ''\n        trows.append({'KeyName': name, 'Key': k, 'Value': v})\n    blocks = []\n    if rows:\n        blocks.append({'name': 'key_pairs', 'kind': 'table', 'lines': rec_lines, 'records': rows})\n    if tag_lines:\n        blocks.append({'name': 'tags', 'kind': 'table', 'lines': tag_lines, 'records': trows})\n    return {'blocks': blocks, 'skip': skip}\n",
